  256|      6|static SECP256K1_INLINE void secp256k1_memclear_explicit(void *ptr, size_t len) {
  257|       |    /* The current implementation zeroes, but callers must not rely on this */
  258|      6|    secp256k1_memzero_explicit(ptr, len);
  259|       |#ifdef VERIFY
