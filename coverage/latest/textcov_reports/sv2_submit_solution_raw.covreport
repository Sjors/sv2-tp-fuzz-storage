secp256k1.c:secp256k1_memzero_explicit:
  238|      6|static SECP256K1_INLINE void secp256k1_memzero_explicit(void *ptr, size_t len) {
  239|       |#if defined(_MSC_VER)
  240|       |    /* SecureZeroMemory is guaranteed not to be optimized out by MSVC. */
  241|       |    SecureZeroMemory(ptr, len);
  242|       |#elif defined(__GNUC__)
  243|       |    /* We use a memory barrier that scares the compiler away from optimizing out the memset.
  244|       |     *
  245|       |     * Quoting Adam Langley <agl@google.com> in commit ad1907fe73334d6c696c8539646c21b11178f20f
  246|       |     * in BoringSSL (ISC License):
  247|       |     *    As best as we can tell, this is sufficient to break any optimisations that
  248|       |     *    might try to eliminate "superfluous" memsets.
  249|       |     * This method is used in memzero_explicit() the Linux kernel, too. Its advantage is that it
  250|       |     * is pretty efficient, because the compiler can still implement the memset() efficiently,
  251|       |     * just not remove it entirely. See "Dead Store Elimination (Still) Considered Harmful" by
  252|       |     * Yang et al. (USENIX Security 2017) for more background.
  253|       |     */
  254|      6|    memset(ptr, 0, len);
  255|      6|    __asm__ __volatile__("" : : "r"(ptr) : "memory");
  256|       |#else
  257|       |    void *(*volatile const volatile_memset)(void *, int, size_t) = memset;
  258|       |    volatile_memset(ptr, 0, len);
  259|       |#endif
  260|      6|}

