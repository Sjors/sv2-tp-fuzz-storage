  325|   493k|static int64_t secp256k1_modinv64_posdivsteps_62_var(int64_t eta, uint64_t f0, uint64_t g0, secp256k1_modinv64_trans2x2 *t, int *jacp) {
  326|       |    /* Transformation matrix; see comments in secp256k1_modinv64_divsteps_62. */
  327|   493k|    uint64_t u = 1, v = 0, q = 0, r = 1;
  328|   493k|    uint64_t f = f0, g = g0, m;
  329|   493k|    uint32_t w;
  330|   493k|    int i = 62, limit, zeros;
  331|   493k|    int jac = *jacp;
  332|       |
  333|  8.68M|    for (;;) {
  334|       |        /* Use a sentinel bit to count zeros only up to i. */
  335|  8.68M|        zeros = secp256k1_ctz64_var(g | (UINT64_MAX << i));
  336|       |        /* Perform zeros divsteps at once; they all just divide g by two. */
  337|  8.68M|        g >>= zeros;
  338|  8.68M|        u <<= zeros;
  339|  8.68M|        v <<= zeros;
  340|  8.68M|        eta -= zeros;
  341|  8.68M|        i -= zeros;
  342|       |        /* Update the bottom bit of jac: when dividing g by an odd power of 2,
  343|       |         * if (f mod 8) is 3 or 5, the Jacobi symbol changes sign. */
  344|  8.68M|        jac ^= (zeros & ((f >> 1) ^ (f >> 2)));
  345|       |        /* We're done once we've done 62 posdivsteps. */
