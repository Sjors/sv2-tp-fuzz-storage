  637|  10.3k|static void secp256k1_modinv64_var(secp256k1_modinv64_signed62 *x, const secp256k1_modinv64_modinfo *modinfo) {
  638|       |    /* Start with d=0, e=1, f=modulus, g=x, eta=-1. */
  639|  10.3k|    secp256k1_modinv64_signed62 d = {{0, 0, 0, 0, 0}};
  640|  10.3k|    secp256k1_modinv64_signed62 e = {{1, 0, 0, 0, 0}};
  641|  10.3k|    secp256k1_modinv64_signed62 f = modinfo->modulus;
  642|  10.3k|    secp256k1_modinv64_signed62 g = *x;
  643|       |#ifdef VERIFY
  644|       |    int i = 0;
  645|       |#endif
  646|  10.3k|    int j, len = 5;
  647|  10.3k|    int64_t eta = -1; /* eta = -delta; delta is initially 1 */
  648|  10.3k|    int64_t cond, fn, gn;
