secp256k1.c:secp256k1_ellswift_prng:
  310|  26.7k|static void secp256k1_ellswift_prng(unsigned char* out32, const secp256k1_sha256 *hasher, uint32_t cnt) {
  311|  26.7k|    secp256k1_sha256 hash = *hasher;
  312|  26.7k|    unsigned char buf4[4];
  313|       |#ifdef VERIFY
  314|       |    size_t blocks = hash.bytes >> 6;
  315|       |#endif
  316|  26.7k|    buf4[0] = cnt;
  317|  26.7k|    buf4[1] = cnt >> 8;
  318|  26.7k|    buf4[2] = cnt >> 16;
  319|  26.7k|    buf4[3] = cnt >> 24;
  320|  26.7k|    secp256k1_sha256_write(&hash, buf4, 4);
  321|  26.7k|    secp256k1_sha256_finalize(&hash, out32);
  322|       |
  323|       |    /* Writing and finalizing together should trigger exactly one SHA256 compression. */
  324|  26.7k|    VERIFY_CHECK(((hash.bytes) >> 6) == (blocks + 1));
  325|  26.7k|}
