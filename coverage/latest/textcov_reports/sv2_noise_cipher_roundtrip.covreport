  261|  1.58M|        VERIFY_CHECK((g & 1) == 1);
  262|  1.58M|        VERIFY_CHECK((u * f0 + v * g0) == f << (62 - i));
  263|  1.58M|        VERIFY_CHECK((q * f0 + r * g0) == g << (62 - i));
  264|       |        /* Bounds on eta that follow from the bounds on iteration count (max 12*62 divsteps). */
  265|  1.58M|        VERIFY_CHECK(eta >= -745 && eta <= 745);
