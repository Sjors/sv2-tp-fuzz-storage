  |  |  ------------------
  |  |  |  |   16|   157k|#define SECP256K1_N_0 ((uint64_t)0xBFD25E8CD0364141ULL)
  |  |  ------------------
  ------------------
   82|   157k|    r->d[0] = secp256k1_u128_to_u64(&t); secp256k1_u128_rshift(&t, 64);
   83|   157k|    secp256k1_u128_accum_u64(&t, r->d[1]);
   84|   157k|    secp256k1_u128_accum_u64(&t, overflow * SECP256K1_N_C_1);
  ------------------
  |  |   23|   157k|#define SECP256K1_N_C_1 (~SECP256K1_N_1)
  |  |  ------------------
  |  |  |  |   17|   157k|#define SECP256K1_N_1 ((uint64_t)0xBAAEDCE6AF48A03BULL)
  |  |  ------------------
  ------------------
   85|   157k|    r->d[1] = secp256k1_u128_to_u64(&t); secp256k1_u128_rshift(&t, 64);
   86|   157k|    secp256k1_u128_accum_u64(&t, r->d[2]);
   87|   157k|    secp256k1_u128_accum_u64(&t, overflow * SECP256K1_N_C_2);
  ------------------
  |  |   24|   157k|#define SECP256K1_N_C_2 (1)
  ------------------
   88|   157k|    r->d[2] = secp256k1_u128_to_u64(&t); secp256k1_u128_rshift(&t, 64);
   89|   157k|    secp256k1_u128_accum_u64(&t, r->d[3]);
   90|   157k|    r->d[3] = secp256k1_u128_to_u64(&t);
   91|       |
   92|   157k|    SECP256K1_SCALAR_VERIFY(r);
  ------------------
  |  |  103|   157k|#define SECP256K1_SCALAR_VERIFY(r) secp256k1_scalar_verify(r)
