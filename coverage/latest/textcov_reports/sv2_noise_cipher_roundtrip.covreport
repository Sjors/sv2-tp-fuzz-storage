  |  Branch (906:63): [True: 16.9k, False: 0]
  |  Branch (906:78): [True: 0, False: 16.9k]
  ------------------
  907|  16.9k|    r->d[1] = shift < 448 ? (l[1 + shiftlimbs] >> shiftlow | (shift < 384 && shiftlow ? (l[2 + shiftlimbs] << shifthigh) : 0)) : 0;
  ------------------
  |  Branch (907:15): [True: 16.9k, False: 0]
  |  Branch (907:63): [True: 0, False: 16.9k]
  |  Branch (907:78): [True: 0, False: 0]
  ------------------
  908|  16.9k|    r->d[2] = shift < 384 ? (l[2 + shiftlimbs] >> shiftlow | (shift < 320 && shiftlow ? (l[3 + shiftlimbs] << shifthigh) : 0)) : 0;
  ------------------
  |  Branch (908:15): [True: 0, False: 16.9k]
  |  Branch (908:63): [True: 0, False: 0]
  |  Branch (908:78): [True: 0, False: 0]
  ------------------
  909|  16.9k|    r->d[3] = shift < 320 ? (l[3 + shiftlimbs] >> shiftlow) : 0;
  ------------------
  |  Branch (909:15): [True: 0, False: 16.9k]
