secp256k1.c:secp256k1_i128_accum_mul:
   53|  21.7M|static SECP256K1_INLINE void secp256k1_i128_accum_mul(secp256k1_int128 *r, int64_t a, int64_t b) {
   54|  21.7M|   int128_t ab = (int128_t)a * b;
   55|  21.7M|   VERIFY_CHECK(0 <= ab ? *r <= INT128_MAX - ab : INT128_MIN - ab <= *r);
