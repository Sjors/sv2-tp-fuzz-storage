secp256k1.c:secp256k1_fe_impl_half:
  335|  2.40M|static SECP256K1_INLINE void secp256k1_fe_impl_half(secp256k1_fe *r) {
  336|  2.40M|    uint64_t t0 = r->n[0], t1 = r->n[1], t2 = r->n[2], t3 = r->n[3], t4 = r->n[4];
  337|  2.40M|    uint64_t one = (uint64_t)1;
  338|  2.40M|    uint64_t mask = -(t0 & one) >> 12;
  339|       |
  340|       |    /* Bounds analysis (over the rationals).
  341|       |     *
  342|       |     * Let m = r->magnitude
  343|       |     *     C = 0xFFFFFFFFFFFFFULL * 2
  344|       |     *     D = 0x0FFFFFFFFFFFFULL * 2
  345|       |     *
  346|       |     * Initial bounds: t0..t3 <= C * m
  347|       |     *                     t4 <= D * m
  348|       |     */
  349|       |
  350|  2.40M|    t0 += 0xFFFFEFFFFFC2FULL & mask;
  351|  2.40M|    t1 += mask;
  352|  2.40M|    t2 += mask;
  353|  2.40M|    t3 += mask;
  354|  2.40M|    t4 += mask >> 4;
  355|       |
  356|  2.40M|    VERIFY_CHECK((t0 & one) == 0);
  357|       |
  358|       |    /* t0..t3: added <= C/2
  359|       |     *     t4: added <= D/2
  360|       |     *
  361|       |     * Current bounds: t0..t3 <= C * (m + 1/2)
  362|       |     *                     t4 <= D * (m + 1/2)
  363|       |     */
  364|       |
  365|  2.40M|    r->n[0] = (t0 >> 1) + ((t1 & one) << 51);
  366|  2.40M|    r->n[1] = (t1 >> 1) + ((t2 & one) << 51);
  367|  2.40M|    r->n[2] = (t2 >> 1) + ((t3 & one) << 51);
  368|  2.40M|    r->n[3] = (t3 >> 1) + ((t4 & one) << 51);
  369|  2.40M|    r->n[4] = (t4 >> 1);
  370|       |
  371|       |    /* t0..t3: shifted right and added <= C/4 + 1/2
  372|       |     *     t4: shifted right
  373|       |     *
  374|       |     * Current bounds: t0..t3 <= C * (m/2 + 1/2)
  375|       |     *                     t4 <= D * (m/2 + 1/4)
  376|       |     *
  377|       |     * Therefore the output magnitude (M) has to be set such that:
  378|       |     *     t0..t3: C * M >= C * (m/2 + 1/2)
  379|       |     *         t4: D * M >= D * (m/2 + 1/4)
  380|       |     *
  381|       |     * It suffices for all limbs that, for any input magnitude m:
  382|       |     *     M >= m/2 + 1/2
  383|       |     *
  384|       |     * and since we want the smallest such integer value for M:
  385|       |     *     M == floor(m/2) + 1
  386|       |     */
  387|  2.40M|}
secp256k1.c:secp256k1_fe_impl_inv:
  453|  32.5k|static void secp256k1_fe_impl_inv(secp256k1_fe *r, const secp256k1_fe *x) {
  454|  32.5k|    secp256k1_fe tmp = *x;
  455|  32.5k|    secp256k1_modinv64_signed62 s;
  456|       |
  457|  32.5k|    secp256k1_fe_normalize(&tmp);
  ------------------
  |  |   78|  32.5k|#  define secp256k1_fe_normalize secp256k1_fe_impl_normalize
  ------------------
  458|  32.5k|    secp256k1_fe_to_signed62(&s, &tmp);
  459|  32.5k|    secp256k1_modinv64(&s, &secp256k1_const_modinfo_fe);
  460|  32.5k|    secp256k1_fe_from_signed62(r, &s);
  461|  32.5k|}
secp256k1.c:secp256k1_fe_to_signed62:
  437|  76.4k|static void secp256k1_fe_to_signed62(secp256k1_modinv64_signed62 *r, const secp256k1_fe *a) {
  438|  76.4k|    const uint64_t M62 = UINT64_MAX >> 2;
  439|  76.4k|    const uint64_t a0 = a->n[0], a1 = a->n[1], a2 = a->n[2], a3 = a->n[3], a4 = a->n[4];
  440|       |
  441|  76.4k|    r->v[0] = (a0       | a1 << 52) & M62;
  442|  76.4k|    r->v[1] = (a1 >> 10 | a2 << 42) & M62;
  443|  76.4k|    r->v[2] = (a2 >> 20 | a3 << 32) & M62;
  444|  76.4k|    r->v[3] = (a3 >> 30 | a4 << 22) & M62;
  445|  76.4k|    r->v[4] =  a4 >> 40;
  446|  76.4k|}
secp256k1.c:secp256k1_fe_from_signed62:
  417|  41.3k|static void secp256k1_fe_from_signed62(secp256k1_fe *r, const secp256k1_modinv64_signed62 *a) {
  418|  41.3k|    const uint64_t M52 = UINT64_MAX >> 12;
  419|  41.3k|    const uint64_t a0 = a->v[0], a1 = a->v[1], a2 = a->v[2], a3 = a->v[3], a4 = a->v[4];
  420|       |
  421|       |    /* The output from secp256k1_modinv64{_var} should be normalized to range [0,modulus), and
  422|       |     * have limbs in [0,2^62). The modulus is < 2^256, so the top limb must be below 2^(256-62*4).
  423|       |     */
  424|  41.3k|    VERIFY_CHECK(a0 >> 62 == 0);
  425|  41.3k|    VERIFY_CHECK(a1 >> 62 == 0);
  426|  41.3k|    VERIFY_CHECK(a2 >> 62 == 0);
  427|  41.3k|    VERIFY_CHECK(a3 >> 62 == 0);
  428|  41.3k|    VERIFY_CHECK(a4 >> 8 == 0);
  429|       |
  430|  41.3k|    r->n[0] =  a0                   & M52;
  431|  41.3k|    r->n[1] = (a0 >> 52 | a1 << 10) & M52;
  432|  41.3k|    r->n[2] = (a1 >> 42 | a2 << 20) & M52;
  433|  41.3k|    r->n[3] = (a2 >> 32 | a3 << 30) & M52;
  434|  41.3k|    r->n[4] = (a3 >> 22 | a4 << 40);
  435|  41.3k|}
secp256k1.c:secp256k1_fe_impl_set_b32_limit:
  265|  4.95k|static int secp256k1_fe_impl_set_b32_limit(secp256k1_fe *r, const unsigned char *a) {
  266|  4.95k|    secp256k1_fe_impl_set_b32_mod(r, a);
  267|  4.95k|    return !((r->n[4] == 0x0FFFFFFFFFFFFULL) & ((r->n[3] & r->n[2] & r->n[1]) == 0xFFFFFFFFFFFFFULL) & (r->n[0] >= 0xFFFFEFFFFFC2FULL));
  268|  4.95k|}
secp256k1.c:secp256k1_fe_impl_get_b32:
  271|  36.6k|static void secp256k1_fe_impl_get_b32(unsigned char *r, const secp256k1_fe *a) {
  272|  36.6k|    secp256k1_write_be64(&r[0], (a->n[4] << 16) | (a->n[3] >> 36));
  273|  36.6k|    secp256k1_write_be64(&r[8], (a->n[3] << 28) | (a->n[2] >> 24));
  274|  36.6k|    secp256k1_write_be64(&r[16], (a->n[2] << 40) | (a->n[1] >> 12));
  275|  36.6k|    secp256k1_write_be64(&r[24], (a->n[1] << 52) | a->n[0]);
  276|  36.6k|}
secp256k1.c:secp256k1_fe_impl_normalize_var:
   99|   113k|static void secp256k1_fe_impl_normalize_var(secp256k1_fe *r) {
  100|   113k|    uint64_t t0 = r->n[0], t1 = r->n[1], t2 = r->n[2], t3 = r->n[3], t4 = r->n[4];
  101|       |
  102|       |    /* Reduce t4 at the start so there will be at most a single carry from the first pass */
  103|   113k|    uint64_t m;
  104|   113k|    uint64_t x = t4 >> 48; t4 &= 0x0FFFFFFFFFFFFULL;
  105|       |
  106|       |    /* The first pass ensures the magnitude is 1, ... */
  107|   113k|    t0 += x * 0x1000003D1ULL;
  108|   113k|    t1 += (t0 >> 52); t0 &= 0xFFFFFFFFFFFFFULL;
  109|   113k|    t2 += (t1 >> 52); t1 &= 0xFFFFFFFFFFFFFULL; m = t1;
  110|   113k|    t3 += (t2 >> 52); t2 &= 0xFFFFFFFFFFFFFULL; m &= t2;
  111|   113k|    t4 += (t3 >> 52); t3 &= 0xFFFFFFFFFFFFFULL; m &= t3;
  112|       |
  113|       |    /* ... except for a possible carry at bit 48 of t4 (i.e. bit 256 of the field element) */
  114|   113k|    VERIFY_CHECK(t4 >> 49 == 0);
  115|       |
  116|       |    /* At most a single final reduction is needed; check if the value is >= the field characteristic */
  117|   113k|    x = (t4 >> 48) | ((t4 == 0x0FFFFFFFFFFFFULL) & (m == 0xFFFFFFFFFFFFFULL)
  118|   113k|        & (t0 >= 0xFFFFEFFFFFC2FULL));
  119|       |
  120|   113k|    if (x) {
  ------------------
  |  Branch (120:9): [True: 0, False: 113k]
  ------------------
  121|      0|        t0 += 0x1000003D1ULL;
  122|      0|        t1 += (t0 >> 52); t0 &= 0xFFFFFFFFFFFFFULL;
  123|      0|        t2 += (t1 >> 52); t1 &= 0xFFFFFFFFFFFFFULL;
  124|      0|        t3 += (t2 >> 52); t2 &= 0xFFFFFFFFFFFFFULL;
  125|      0|        t4 += (t3 >> 52); t3 &= 0xFFFFFFFFFFFFFULL;
  126|       |
  127|       |        /* If t4 didn't carry to bit 48 already, then it should have after any final reduction */
  128|      0|        VERIFY_CHECK(t4 >> 48 == x);
  129|       |
  130|       |        /* Mask off the possible multiple of 2^256 from the final reduction */
  131|      0|        t4 &= 0x0FFFFFFFFFFFFULL;
  132|      0|    }
  133|       |
  134|   113k|    r->n[0] = t0; r->n[1] = t1; r->n[2] = t2; r->n[3] = t3; r->n[4] = t4;
  135|   113k|}
secp256k1.c:secp256k1_fe_impl_is_odd:
  211|  41.8k|SECP256K1_INLINE static int secp256k1_fe_impl_is_odd(const secp256k1_fe *a) {
  212|  41.8k|    return a->n[0] & 1;
  213|  41.8k|}
secp256k1.c:secp256k1_fe_impl_from_storage:
  409|  2.56M|static SECP256K1_INLINE void secp256k1_fe_impl_from_storage(secp256k1_fe *r, const secp256k1_fe_storage *a) {
  410|  2.56M|    r->n[0] = a->n[0] & 0xFFFFFFFFFFFFFULL;
  411|  2.56M|    r->n[1] = a->n[0] >> 52 | ((a->n[1] << 12) & 0xFFFFFFFFFFFFFULL);
  412|  2.56M|    r->n[2] = a->n[1] >> 40 | ((a->n[2] << 24) & 0xFFFFFFFFFFFFFULL);
  413|  2.56M|    r->n[3] = a->n[2] >> 28 | ((a->n[3] << 36) & 0xFFFFFFFFFFFFFULL);
  414|  2.56M|    r->n[4] = a->n[3] >> 16;
  415|  2.56M|}
secp256k1.c:secp256k1_fe_impl_normalizes_to_zero_var:
  160|   291k|static int secp256k1_fe_impl_normalizes_to_zero_var(const secp256k1_fe *r) {
  161|   291k|    uint64_t t0, t1, t2, t3, t4;
  162|   291k|    uint64_t z0, z1;
  163|   291k|    uint64_t x;
  164|       |
  165|   291k|    t0 = r->n[0];
  166|   291k|    t4 = r->n[4];
  167|       |
  168|       |    /* Reduce t4 at the start so there will be at most a single carry from the first pass */
  169|   291k|    x = t4 >> 48;
  170|       |
  171|       |    /* The first pass ensures the magnitude is 1, ... */
  172|   291k|    t0 += x * 0x1000003D1ULL;
  173|       |
  174|       |    /* z0 tracks a possible raw value of 0, z1 tracks a possible raw value of P */
  175|   291k|    z0 = t0 & 0xFFFFFFFFFFFFFULL;
  176|   291k|    z1 = z0 ^ 0x1000003D0ULL;
  177|       |
  178|       |    /* Fast return path should catch the majority of cases */
  179|   291k|    if ((z0 != 0ULL) & (z1 != 0xFFFFFFFFFFFFFULL)) {
  ------------------
  |  Branch (179:9): [True: 291k, False: 0]
  ------------------
  180|   291k|        return 0;
  181|   291k|    }
  182|       |
  183|      0|    t1 = r->n[1];
  184|      0|    t2 = r->n[2];
  185|      0|    t3 = r->n[3];
  186|       |
  187|      0|    t4 &= 0x0FFFFFFFFFFFFULL;
  188|       |
  189|      0|    t1 += (t0 >> 52);
  190|      0|    t2 += (t1 >> 52); t1 &= 0xFFFFFFFFFFFFFULL; z0 |= t1; z1 &= t1;
  191|      0|    t3 += (t2 >> 52); t2 &= 0xFFFFFFFFFFFFFULL; z0 |= t2; z1 &= t2;
  192|      0|    t4 += (t3 >> 52); t3 &= 0xFFFFFFFFFFFFFULL; z0 |= t3; z1 &= t3;
  193|      0|                                                z0 |= t4; z1 &= t4 ^ 0xF000000000000ULL;
  194|       |
  195|       |    /* ... except for a possible carry at bit 48 of t4 (i.e. bit 256 of the field element) */
  196|      0|    VERIFY_CHECK(t4 >> 49 == 0);
  197|       |
  198|      0|    return (z0 == 0) | (z1 == 0xFFFFFFFFFFFFFULL);
  199|   291k|}
