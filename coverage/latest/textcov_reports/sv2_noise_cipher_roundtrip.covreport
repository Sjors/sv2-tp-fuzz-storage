  179|  14.6M|    VERIFY_BITS_128(&d, 115);
  180|  14.6M|    VERIFY_BITS_128(&c, 48);
  181|       |    /* [(c<<12) 0 0 0 0 0 d 0 0 0] = [p8 0 0 0 0 p3 0 0 0] */
  182|  14.6M|    t3 = secp256k1_u128_to_u64(&d) & M; secp256k1_u128_rshift(&d, 52);
  183|  14.6M|    VERIFY_BITS(t3, 52);
