  123|  49.7k|    r2 += r1 >> 62; r1 &= M62;
  124|  49.7k|    r3 += r2 >> 62; r2 &= M62;
  125|  49.7k|    r4 += r3 >> 62; r3 &= M62;
  126|       |
  127|       |    /* In a second step add the modulus again if the result is still negative, bringing
  128|       |     * r to range [0,modulus). */
  129|  49.7k|    cond_add = r4 >> 63;
  130|  49.7k|    r0 += modinfo->modulus.v[0] & cond_add;
  131|  49.7k|    r1 += modinfo->modulus.v[1] & cond_add;
  132|  49.7k|    r2 += modinfo->modulus.v[2] & cond_add;
  133|  49.7k|    r3 += modinfo->modulus.v[3] & cond_add;
  134|  49.7k|    r4 += modinfo->modulus.v[4] & cond_add;
  135|       |    /* And propagate again. */
  136|  49.7k|    r1 += r0 >> 62; r0 &= M62;
  137|  49.7k|    r2 += r1 >> 62; r1 &= M62;
  138|  49.7k|    r3 += r2 >> 62; r2 &= M62;
  139|  49.7k|    r4 += r3 >> 62; r3 &= M62;
  140|       |
  141|  49.7k|    r->v[0] = r0;
  142|  49.7k|    r->v[1] = r1;
  143|  49.7k|    r->v[2] = r2;
  144|  49.7k|    r->v[3] = r3;
  145|  49.7k|    r->v[4] = r4;
  146|       |
  147|  49.7k|    VERIFY_CHECK(r0 >> 62 == 0);
  148|  49.7k|    VERIFY_CHECK(r1 >> 62 == 0);
  149|  49.7k|    VERIFY_CHECK(r2 >> 62 == 0);
  150|  49.7k|    VERIFY_CHECK(r3 >> 62 == 0);
  151|  49.7k|    VERIFY_CHECK(r4 >> 62 == 0);
  152|  49.7k|    VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(r, 5, &modinfo->modulus, 0) >= 0); /* r >= 0 */
  153|  49.7k|    VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(r, 5, &modinfo->modulus, 1) < 0); /* r < modulus */
  154|  49.7k|}
secp256k1.c:secp256k1_modinv64:
  588|  39.3k|static void secp256k1_modinv64(secp256k1_modinv64_signed62 *x, const secp256k1_modinv64_modinfo *modinfo) {
  589|       |    /* Start with d=0, e=1, f=modulus, g=x, zeta=-1. */
  590|  39.3k|    secp256k1_modinv64_signed62 d = {{0, 0, 0, 0, 0}};
  591|  39.3k|    secp256k1_modinv64_signed62 e = {{1, 0, 0, 0, 0}};
  592|  39.3k|    secp256k1_modinv64_signed62 f = modinfo->modulus;
  593|  39.3k|    secp256k1_modinv64_signed62 g = *x;
  594|  39.3k|    int i;
  595|  39.3k|    int64_t zeta = -1; /* zeta = -(delta+1/2); delta starts at 1/2. */
  596|       |
  597|       |    /* Do 10 iterations of 59 divsteps each = 590 divsteps. This suffices for 256-bit inputs. */
  598|   433k|    for (i = 0; i < 10; ++i) {
  ------------------
  |  Branch (598:17): [True: 393k, False: 39.3k]
  ------------------
  599|       |        /* Compute transition matrix and new zeta after 59 divsteps. */
  600|   393k|        secp256k1_modinv64_trans2x2 t;
  601|   393k|        zeta = secp256k1_modinv64_divsteps_59(zeta, f.v[0], g.v[0], &t);
  602|       |        /* Update d,e using that transition matrix. */
  603|   393k|        secp256k1_modinv64_update_de_62(&d, &e, &t, modinfo);
  604|       |        /* Update f,g using that transition matrix. */
  605|   393k|        VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(&f, 5, &modinfo->modulus, -1) > 0); /* f > -modulus */
  606|   393k|        VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(&f, 5, &modinfo->modulus, 1) <= 0); /* f <= modulus */
  607|   393k|        VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(&g, 5, &modinfo->modulus, -1) > 0); /* g > -modulus */
  608|   393k|        VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(&g, 5, &modinfo->modulus, 1) < 0);  /* g <  modulus */
  609|       |
  610|   393k|        secp256k1_modinv64_update_fg_62(&f, &g, &t);
  611|       |
  612|   393k|        VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(&f, 5, &modinfo->modulus, -1) > 0); /* f > -modulus */
  613|   393k|        VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(&f, 5, &modinfo->modulus, 1) <= 0); /* f <= modulus */
  614|   393k|        VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(&g, 5, &modinfo->modulus, -1) > 0); /* g > -modulus */
  615|   393k|        VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(&g, 5, &modinfo->modulus, 1) < 0);  /* g <  modulus */
  616|   393k|    }
  617|       |
  618|       |    /* At this point sufficient iterations have been performed that g must have reached 0
  619|       |     * and (if g was not originally 0) f must now equal +/- GCD of the initial f, g
  620|       |     * values i.e. +/- 1, and d now contains +/- the modular inverse. */
  621|       |
  622|       |    /* g == 0 */
  623|  39.3k|    VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(&g, 5, &SECP256K1_SIGNED62_ONE, 0) == 0);
  624|       |    /* |f| == 1, or (x == 0 and d == 0 and f == modulus) */
  625|  39.3k|    VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(&f, 5, &SECP256K1_SIGNED62_ONE, -1) == 0 ||
  626|  39.3k|                 secp256k1_modinv64_mul_cmp_62(&f, 5, &SECP256K1_SIGNED62_ONE, 1) == 0 ||
  627|  39.3k|                 (secp256k1_modinv64_mul_cmp_62(x, 5, &SECP256K1_SIGNED62_ONE, 0) == 0 &&
  628|  39.3k|                  secp256k1_modinv64_mul_cmp_62(&d, 5, &SECP256K1_SIGNED62_ONE, 0) == 0 &&
  629|  39.3k|                  secp256k1_modinv64_mul_cmp_62(&f, 5, &modinfo->modulus, 1) == 0));
  630|       |
  631|       |    /* Optionally negate d, normalize to [0,modulus), and return it. */
  632|  39.3k|    secp256k1_modinv64_normalize_62(&d, f.v[4], modinfo);
  633|  39.3k|    *x = d;
  634|  39.3k|}
secp256k1.c:secp256k1_modinv64_divsteps_59:
  167|   393k|static int64_t secp256k1_modinv64_divsteps_59(int64_t zeta, uint64_t f0, uint64_t g0, secp256k1_modinv64_trans2x2 *t) {
  168|       |    /* u,v,q,r are the elements of the transformation matrix being built up,
  169|       |     * starting with the identity matrix times 8 (because the caller expects
  170|       |     * a result scaled by 2^62). Semantically they are signed integers
  171|       |     * in range [-2^62,2^62], but here represented as unsigned mod 2^64. This
  172|       |     * permits left shifting (which is UB for negative numbers). The range
  173|       |     * being inside [-2^63,2^63) means that casting to signed works correctly.
  174|       |     */
  175|   393k|    uint64_t u = 8, v = 0, q = 0, r = 8;
  176|   393k|    volatile uint64_t c1, c2;
  177|   393k|    uint64_t mask1, mask2, f = f0, g = g0, x, y, z;
  178|   393k|    int i;
  179|       |
  180|  23.6M|    for (i = 3; i < 62; ++i) {
  ------------------
  |  Branch (180:17): [True: 23.2M, False: 393k]
  ------------------
  181|  23.2M|        VERIFY_CHECK((f & 1) == 1); /* f must always be odd */
  182|  23.2M|        VERIFY_CHECK((u * f0 + v * g0) == f << i);
  183|  23.2M|        VERIFY_CHECK((q * f0 + r * g0) == g << i);
  184|       |        /* Compute conditional masks for (zeta < 0) and for (g & 1). */
  185|  23.2M|        c1 = zeta >> 63;
  186|  23.2M|        mask1 = c1;
  187|  23.2M|        c2 = g & 1;
  188|  23.2M|        mask2 = -c2;
  189|       |        /* Compute x,y,z, conditionally negated versions of f,u,v. */
  190|  23.2M|        x = (f ^ mask1) - mask1;
  191|  23.2M|        y = (u ^ mask1) - mask1;
  192|  23.2M|        z = (v ^ mask1) - mask1;
  193|       |        /* Conditionally add x,y,z to g,q,r. */
  194|  23.2M|        g += x & mask2;
  195|  23.2M|        q += y & mask2;
  196|  23.2M|        r += z & mask2;
  197|       |        /* In what follows, c1 is a condition mask for (zeta < 0) and (g & 1). */
  198|  23.2M|        mask1 &= mask2;
  199|       |        /* Conditionally change zeta into -zeta-2 or zeta-1. */
  200|  23.2M|        zeta = (zeta ^ mask1) - 1;
  201|       |        /* Conditionally add g,q,r to f,u,v. */
  202|  23.2M|        f += g & mask1;
  203|  23.2M|        u += q & mask1;
  204|  23.2M|        v += r & mask1;
  205|       |        /* Shifts */
  206|  23.2M|        g >>= 1;
  207|  23.2M|        u <<= 1;
  208|  23.2M|        v <<= 1;
  209|       |        /* Bounds on zeta that follow from the bounds on iteration count (max 10*59 divsteps). */
  210|  23.2M|        VERIFY_CHECK(zeta >= -591 && zeta <= 591);
  211|  23.2M|    }
  212|       |    /* Return data in t and return value. */
  213|   393k|    t->u = (int64_t)u;
  214|   393k|    t->v = (int64_t)v;
  215|   393k|    t->q = (int64_t)q;
  216|   393k|    t->r = (int64_t)r;
  217|       |
  218|       |    /* The determinant of t must be a power of two. This guarantees that multiplication with t
  219|       |     * does not change the gcd of f and g, apart from adding a power-of-2 factor to it (which
  220|       |     * will be divided out again). As each divstep's individual matrix has determinant 2, the
  221|       |     * aggregate of 59 of them will have determinant 2^59. Multiplying with the initial
  222|       |     * 8*identity (which has determinant 2^6) means the overall outputs has determinant
  223|       |     * 2^65. */
  224|   393k|    VERIFY_CHECK(secp256k1_modinv64_det_check_pow2(t, 65, 0));
  225|       |
  226|   393k|    return zeta;
  227|   393k|}
secp256k1.c:secp256k1_modinv64_update_fg_62:
  500|   393k|static void secp256k1_modinv64_update_fg_62(secp256k1_modinv64_signed62 *f, secp256k1_modinv64_signed62 *g, const secp256k1_modinv64_trans2x2 *t) {
  501|   393k|    const uint64_t M62 = UINT64_MAX >> 2;
  502|   393k|    const int64_t f0 = f->v[0], f1 = f->v[1], f2 = f->v[2], f3 = f->v[3], f4 = f->v[4];
  503|   393k|    const int64_t g0 = g->v[0], g1 = g->v[1], g2 = g->v[2], g3 = g->v[3], g4 = g->v[4];
  504|   393k|    const int64_t u = t->u, v = t->v, q = t->q, r = t->r;
  505|   393k|    secp256k1_int128 cf, cg;
  506|       |    /* Start computing t*[f,g]. */
  507|   393k|    secp256k1_i128_mul(&cf, u, f0);
  508|   393k|    secp256k1_i128_accum_mul(&cf, v, g0);
  509|   393k|    secp256k1_i128_mul(&cg, q, f0);
  510|   393k|    secp256k1_i128_accum_mul(&cg, r, g0);
  511|       |    /* Verify that the bottom 62 bits of the result are zero, and then throw them away. */
  512|   393k|    VERIFY_CHECK((secp256k1_i128_to_u64(&cf) & M62) == 0); secp256k1_i128_rshift(&cf, 62);
  513|   393k|    VERIFY_CHECK((secp256k1_i128_to_u64(&cg) & M62) == 0); secp256k1_i128_rshift(&cg, 62);
  514|       |    /* Compute limb 1 of t*[f,g], and store it as output limb 0 (= down shift). */
  515|   393k|    secp256k1_i128_accum_mul(&cf, u, f1);
  516|   393k|    secp256k1_i128_accum_mul(&cf, v, g1);
  517|   393k|    secp256k1_i128_accum_mul(&cg, q, f1);
  518|   393k|    secp256k1_i128_accum_mul(&cg, r, g1);
  519|   393k|    f->v[0] = secp256k1_i128_to_u64(&cf) & M62; secp256k1_i128_rshift(&cf, 62);
  520|   393k|    g->v[0] = secp256k1_i128_to_u64(&cg) & M62; secp256k1_i128_rshift(&cg, 62);
  521|       |    /* Compute limb 2 of t*[f,g], and store it as output limb 1. */
  522|   393k|    secp256k1_i128_accum_mul(&cf, u, f2);
  523|   393k|    secp256k1_i128_accum_mul(&cf, v, g2);
  524|   393k|    secp256k1_i128_accum_mul(&cg, q, f2);
  525|   393k|    secp256k1_i128_accum_mul(&cg, r, g2);
  526|   393k|    f->v[1] = secp256k1_i128_to_u64(&cf) & M62; secp256k1_i128_rshift(&cf, 62);
  527|   393k|    g->v[1] = secp256k1_i128_to_u64(&cg) & M62; secp256k1_i128_rshift(&cg, 62);
  528|       |    /* Compute limb 3 of t*[f,g], and store it as output limb 2. */
  529|   393k|    secp256k1_i128_accum_mul(&cf, u, f3);
  530|   393k|    secp256k1_i128_accum_mul(&cf, v, g3);
  531|   393k|    secp256k1_i128_accum_mul(&cg, q, f3);
  532|   393k|    secp256k1_i128_accum_mul(&cg, r, g3);
  533|   393k|    f->v[2] = secp256k1_i128_to_u64(&cf) & M62; secp256k1_i128_rshift(&cf, 62);
  534|   393k|    g->v[2] = secp256k1_i128_to_u64(&cg) & M62; secp256k1_i128_rshift(&cg, 62);
  535|       |    /* Compute limb 4 of t*[f,g], and store it as output limb 3. */
  536|   393k|    secp256k1_i128_accum_mul(&cf, u, f4);
  537|   393k|    secp256k1_i128_accum_mul(&cf, v, g4);
  538|   393k|    secp256k1_i128_accum_mul(&cg, q, f4);
  539|   393k|    secp256k1_i128_accum_mul(&cg, r, g4);
  540|   393k|    f->v[3] = secp256k1_i128_to_u64(&cf) & M62; secp256k1_i128_rshift(&cf, 62);
  541|   393k|    g->v[3] = secp256k1_i128_to_u64(&cg) & M62; secp256k1_i128_rshift(&cg, 62);
  542|       |    /* What remains is limb 5 of t*[f,g]; store it as output limb 4. */
  543|   393k|    f->v[4] = secp256k1_i128_to_i64(&cf);
  544|   393k|    g->v[4] = secp256k1_i128_to_i64(&cg);
  545|   393k|}
secp256k1.c:secp256k1_jacobi64_maybe_var:
  721|  41.7k|static int secp256k1_jacobi64_maybe_var(const secp256k1_modinv64_signed62 *x, const secp256k1_modinv64_modinfo *modinfo) {
  722|       |    /* Start with f=modulus, g=x, eta=-1. */
  723|  41.7k|    secp256k1_modinv64_signed62 f = modinfo->modulus;
  724|  41.7k|    secp256k1_modinv64_signed62 g = *x;
  725|  41.7k|    int j, len = 5;
  726|  41.7k|    int64_t eta = -1; /* eta = -delta; delta is initially 1 */
  727|  41.7k|    int64_t cond, fn, gn;
  728|  41.7k|    int jac = 0;
  729|  41.7k|    int count;
  730|       |
  731|       |    /* The input limbs must all be non-negative. */
  732|  41.7k|    VERIFY_CHECK(g.v[0] >= 0 && g.v[1] >= 0 && g.v[2] >= 0 && g.v[3] >= 0 && g.v[4] >= 0);
  733|       |
  734|       |    /* If x > 0, then if the loop below converges, it converges to f=g=gcd(x,modulus). Since we
  735|       |     * require that gcd(x,modulus)=1 and modulus>=3, x cannot be 0. Thus, we must reach f=1 (or
  736|       |     * time out). */
  737|  41.7k|    VERIFY_CHECK((g.v[0] | g.v[1] | g.v[2] | g.v[3] | g.v[4]) != 0);
  738|       |
  739|   528k|    for (count = 0; count < JACOBI64_ITERATIONS; ++count) {
  ------------------
  |  |  717|   528k|#define JACOBI64_ITERATIONS 25
  ------------------
  |  Branch (739:21): [True: 528k, False: 0]
  ------------------
  740|       |        /* Compute transition matrix and new eta after 62 posdivsteps. */
  741|   528k|        secp256k1_modinv64_trans2x2 t;
  742|   528k|        eta = secp256k1_modinv64_posdivsteps_62_var(eta, f.v[0] | ((uint64_t)f.v[1] << 62), g.v[0] | ((uint64_t)g.v[1] << 62), &t, &jac);
  743|       |        /* Update f,g using that transition matrix. */
  744|   528k|        VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(&f, len, &modinfo->modulus, 0) > 0); /* f > 0 */
  745|   528k|        VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(&f, len, &modinfo->modulus, 1) <= 0); /* f <= modulus */
  746|   528k|        VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(&g, len, &modinfo->modulus, 0) > 0); /* g > 0 */
  747|   528k|        VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(&g, len, &modinfo->modulus, 1) < 0);  /* g < modulus */
  748|       |
  749|   528k|        secp256k1_modinv64_update_fg_62_var(len, &f, &g, &t);
  750|       |        /* If the bottom limb of f is 1, there is a chance that f=1. */
  751|   528k|        if (f.v[0] == 1) {
  ------------------
  |  Branch (751:13): [True: 41.7k, False: 486k]
  ------------------
  752|  41.7k|            cond = 0;
  753|       |            /* Check if the other limbs are also 0. */
  754|  41.7k|            for (j = 1; j < len; ++j) {
  ------------------
  |  Branch (754:25): [True: 0, False: 41.7k]
  ------------------
  755|      0|                cond |= f.v[j];
  756|      0|            }
  757|       |            /* If so, we're done. When f=1, the Jacobi symbol (g | f)=1. */
  758|  41.7k|            if (cond == 0) return 1 - 2*(jac & 1);
  ------------------
  |  Branch (758:17): [True: 41.7k, False: 0]
  ------------------
  759|  41.7k|        }
  760|       |
  761|       |        /* Determine if len>1 and limb (len-1) of both f and g is 0. */
  762|   486k|        fn = f.v[len - 1];
  763|   486k|        gn = g.v[len - 1];
  764|   486k|        cond = ((int64_t)len - 2) >> 63;
  765|   486k|        cond |= fn;
  766|   486k|        cond |= gn;
  767|       |        /* If so, reduce length. */
  768|   486k|        if (cond == 0) --len;
  ------------------
  |  Branch (768:13): [True: 166k, False: 320k]
  ------------------
  769|       |
  770|   486k|        VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(&f, len, &modinfo->modulus, 0) > 0); /* f > 0 */
  771|   486k|        VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(&f, len, &modinfo->modulus, 1) <= 0); /* f <= modulus */
  772|   486k|        VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(&g, len, &modinfo->modulus, 0) > 0); /* g > 0 */
  773|   486k|        VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(&g, len, &modinfo->modulus, 1) < 0);  /* g < modulus */
  774|   486k|    }
  775|       |
  776|       |    /* The loop failed to converge to f=g after 1550 iterations. Return 0, indicating unknown result. */
  777|      0|    return 0;
  778|  41.7k|}
secp256k1.c:secp256k1_modinv64_posdivsteps_62_var:
  325|   528k|static int64_t secp256k1_modinv64_posdivsteps_62_var(int64_t eta, uint64_t f0, uint64_t g0, secp256k1_modinv64_trans2x2 *t, int *jacp) {
  326|       |    /* Transformation matrix; see comments in secp256k1_modinv64_divsteps_62. */
  327|   528k|    uint64_t u = 1, v = 0, q = 0, r = 1;
  328|   528k|    uint64_t f = f0, g = g0, m;
  329|   528k|    uint32_t w;
  330|   528k|    int i = 62, limit, zeros;
  331|   528k|    int jac = *jacp;
  332|       |
  333|  9.30M|    for (;;) {
  334|       |        /* Use a sentinel bit to count zeros only up to i. */
  335|  9.30M|        zeros = secp256k1_ctz64_var(g | (UINT64_MAX << i));
  336|       |        /* Perform zeros divsteps at once; they all just divide g by two. */
  337|  9.30M|        g >>= zeros;
  338|  9.30M|        u <<= zeros;
  339|  9.30M|        v <<= zeros;
  340|  9.30M|        eta -= zeros;
  341|  9.30M|        i -= zeros;
  342|       |        /* Update the bottom bit of jac: when dividing g by an odd power of 2,
  343|       |         * if (f mod 8) is 3 or 5, the Jacobi symbol changes sign. */
  344|  9.30M|        jac ^= (zeros & ((f >> 1) ^ (f >> 2)));
  345|       |        /* We're done once we've done 62 posdivsteps. */
  346|  9.30M|        if (i == 0) break;
  ------------------
  |  Branch (346:13): [True: 528k, False: 8.77M]
  ------------------
  347|  8.77M|        VERIFY_CHECK((f & 1) == 1);
  348|  8.77M|        VERIFY_CHECK((g & 1) == 1);
  349|  8.77M|        VERIFY_CHECK((u * f0 + v * g0) == f << (62 - i));
  350|  8.77M|        VERIFY_CHECK((q * f0 + r * g0) == g << (62 - i));
  351|       |        /* If eta is negative, negate it and replace f,g with g,f. */
  352|  8.77M|        if (eta < 0) {
  ------------------
  |  Branch (352:13): [True: 8.49M, False: 287k]
  ------------------
  353|  8.49M|            uint64_t tmp;
  354|  8.49M|            eta = -eta;
