   97|  16.1M|    secp256k1_u128_accum_mul(&c, u0, R >> 4);
   98|  16.1M|    VERIFY_BITS_128(&c, 113);
   99|       |    /* [d 0 t4 t3 0 0 c] = [p8 0 0 p5 p4 p3 0 0 p0] */
  100|  16.1M|    r[0] = secp256k1_u128_to_u64(&c) & M; secp256k1_u128_rshift(&c, 52);
  101|  16.1M|    VERIFY_BITS(r[0], 52);
  102|  16.1M|    VERIFY_BITS_128(&c, 61);
  103|       |    /* [d 0 t4 t3 0 c r0] = [p8 0 0 p5 p4 p3 0 0 p0] */
  104|       |
  105|  16.1M|    secp256k1_u128_accum_mul(&c, a0, b[1]);
  106|  16.1M|    secp256k1_u128_accum_mul(&c, a1, b[0]);
