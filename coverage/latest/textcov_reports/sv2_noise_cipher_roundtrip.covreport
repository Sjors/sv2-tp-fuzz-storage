  239|  88.2k|static int64_t secp256k1_modinv64_divsteps_62_var(int64_t eta, uint64_t f0, uint64_t g0, secp256k1_modinv64_trans2x2 *t) {
  240|       |    /* Transformation matrix; see comments in secp256k1_modinv64_divsteps_62. */
  241|  88.2k|    uint64_t u = 1, v = 0, q = 0, r = 1;
  242|  88.2k|    uint64_t f = f0, g = g0, m;
  243|  88.2k|    uint32_t w;
  244|  88.2k|    int i = 62, limit, zeros;
  245|       |
  246|  1.44M|    for (;;) {
  247|       |        /* Use a sentinel bit to count zeros only up to i. */
  248|  1.44M|        zeros = secp256k1_ctz64_var(g | (UINT64_MAX << i));
  249|       |        /* Perform zeros divsteps at once; they all just divide g by two. */
  250|  1.44M|        g >>= zeros;
  251|  1.44M|        u <<= zeros;
  252|  1.44M|        v <<= zeros;
  253|  1.44M|        eta -= zeros;
  254|  1.44M|        i -= zeros;
  255|       |        /* We're done once we've done 62 divsteps. */
  256|  1.44M|        if (i == 0) break;
  ------------------
  |  Branch (256:13): [True: 88.2k, False: 1.35M]
  ------------------
  257|  1.35M|        VERIFY_CHECK((f & 1) == 1);
  258|  1.35M|        VERIFY_CHECK((g & 1) == 1);
  259|  1.35M|        VERIFY_CHECK((u * f0 + v * g0) == f << (62 - i));
  260|  1.35M|        VERIFY_CHECK((q * f0 + r * g0) == g << (62 - i));
  261|       |        /* Bounds on eta that follow from the bounds on iteration count (max 12*62 divsteps). */
  262|  1.35M|        VERIFY_CHECK(eta >= -745 && eta <= 745);
  263|       |        /* If eta is negative, negate it and replace f,g with g,-f. */
  264|  1.35M|        if (eta < 0) {
  ------------------
  |  Branch (264:13): [True: 1.30M, False: 47.3k]
  ------------------
  265|  1.30M|            uint64_t tmp;
  266|  1.30M|            eta = -eta;
  267|  1.30M|            tmp = f; f = g; g = -tmp;
  268|  1.30M|            tmp = u; u = q; q = -tmp;
  269|  1.30M|            tmp = v; v = r; r = -tmp;
  270|       |            /* Use a formula to cancel out up to 6 bits of g. Also, no more than i can be cancelled
  271|       |             * out (as we'd be done before that point), and no more than eta+1 can be done as its
  272|       |             * sign will flip again once that happens. */
  273|  1.30M|            limit = ((int)eta + 1) > i ? i : ((int)eta + 1);
  ------------------
  |  Branch (273:21): [True: 26.2k, False: 1.28M]
  ------------------
  274|  1.30M|            VERIFY_CHECK(limit > 0 && limit <= 62);
  275|       |            /* m is a mask for the bottom min(limit, 6) bits. */
  276|  1.30M|            m = (UINT64_MAX >> (64 - limit)) & 63U;
  277|       |            /* Find what multiple of f must be added to g to cancel its bottom min(limit, 6)
  278|       |             * bits. */
  279|  1.30M|            w = (f * g * (f * f - 2)) & m;
  280|  1.30M|        } else {
  281|       |            /* In this branch, use a simpler formula that only lets us cancel up to 4 bits of g, as
  282|       |             * eta tends to be smaller here. */
  283|  47.3k|            limit = ((int)eta + 1) > i ? i : ((int)eta + 1);
  ------------------
  |  Branch (283:21): [True: 332, False: 46.9k]
  ------------------
  284|  47.3k|            VERIFY_CHECK(limit > 0 && limit <= 62);
  285|       |            /* m is a mask for the bottom min(limit, 4) bits. */
  286|  47.3k|            m = (UINT64_MAX >> (64 - limit)) & 15U;
  287|       |            /* Find what multiple of f must be added to g to cancel its bottom min(limit, 4)
  288|       |             * bits. */
  289|  47.3k|            w = f + (((f + 1) & 4) << 1);
  290|  47.3k|            w = (-w * g) & m;
  291|  47.3k|        }
  292|  1.35M|        g += f * w;
  293|  1.35M|        q += u * w;
  294|  1.35M|        r += v * w;
  295|  1.35M|        VERIFY_CHECK((g & m) == 0);
  296|  1.35M|    }
  297|       |    /* Return data in t and return value. */
  298|  88.2k|    t->u = (int64_t)u;
  299|  88.2k|    t->v = (int64_t)v;
  300|  88.2k|    t->q = (int64_t)q;
  301|  88.2k|    t->r = (int64_t)r;
