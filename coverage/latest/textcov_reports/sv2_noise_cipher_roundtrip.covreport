secp256k1.c:secp256k1_ellswift_prng:
  310|  8.15k|static void secp256k1_ellswift_prng(unsigned char* out32, const secp256k1_sha256 *hasher, uint32_t cnt) {
  311|  8.15k|    secp256k1_sha256 hash = *hasher;
  312|  8.15k|    unsigned char buf4[4];
  313|       |#ifdef VERIFY
  314|       |    size_t blocks = hash.bytes >> 6;
  315|       |#endif
  316|  8.15k|    buf4[0] = cnt;
  317|  8.15k|    buf4[1] = cnt >> 8;
  318|  8.15k|    buf4[2] = cnt >> 16;
  319|  8.15k|    buf4[3] = cnt >> 24;
  320|  8.15k|    secp256k1_sha256_write(&hash, buf4, 4);
  321|  8.15k|    secp256k1_sha256_finalize(&hash, out32);
  322|       |
  323|       |    /* Writing and finalizing together should trigger exactly one SHA256 compression. */
  324|  8.15k|    VERIFY_CHECK(((hash.bytes) >> 6) == (blocks + 1));
  325|  8.15k|}
