   96|       |    /* [d 0 t4+(u0<<48) t3 0 0 c] = [p8 0 0 p5 p4 p3 0 0 p0] */
   97|  21.1M|    secp256k1_u128_accum_mul(&c, u0, R >> 4);
   98|  21.1M|    VERIFY_BITS_128(&c, 113);
   99|       |    /* [d 0 t4 t3 0 0 c] = [p8 0 0 p5 p4 p3 0 0 p0] */
  100|  21.1M|    r[0] = secp256k1_u128_to_u64(&c) & M; secp256k1_u128_rshift(&c, 52);
  101|  21.1M|    VERIFY_BITS(r[0], 52);
  102|  21.1M|    VERIFY_BITS_128(&c, 61);
  103|       |    /* [d 0 t4 t3 0 c r0] = [p8 0 0 p5 p4 p3 0 0 p0] */
  104|       |
  105|  21.1M|    secp256k1_u128_accum_mul(&c, a0, b[1]);
  106|  21.1M|    secp256k1_u128_accum_mul(&c, a1, b[0]);
  107|  21.1M|    VERIFY_BITS_128(&c, 114);
  108|       |    /* [d 0 t4 t3 0 c r0] = [p8 0 0 p5 p4 p3 0 p1 p0] */
  109|  21.1M|    secp256k1_u128_accum_mul(&d, a2, b[4]);
  110|  21.1M|    secp256k1_u128_accum_mul(&d, a3, b[3]);
  111|  21.1M|    secp256k1_u128_accum_mul(&d, a4, b[2]);
  112|  21.1M|    VERIFY_BITS_128(&d, 114);
  113|       |    /* [d 0 t4 t3 0 c r0] = [p8 0 p6 p5 p4 p3 0 p1 p0] */
  114|  21.1M|    secp256k1_u128_accum_mul(&c, secp256k1_u128_to_u64(&d) & M, R); secp256k1_u128_rshift(&d, 52);
  115|  21.1M|    VERIFY_BITS_128(&c, 115);
  116|  21.1M|    VERIFY_BITS_128(&d, 62);
  117|       |    /* [d 0 0 t4 t3 0 c r0] = [p8 0 p6 p5 p4 p3 0 p1 p0] */
  118|  21.1M|    r[1] = secp256k1_u128_to_u64(&c) & M; secp256k1_u128_rshift(&c, 52);
  119|  21.1M|    VERIFY_BITS(r[1], 52);
  120|  21.1M|    VERIFY_BITS_128(&c, 63);
  121|       |    /* [d 0 0 t4 t3 c r1 r0] = [p8 0 p6 p5 p4 p3 0 p1 p0] */
  122|       |
  123|  21.1M|    secp256k1_u128_accum_mul(&c, a0, b[2]);
  124|  21.1M|    secp256k1_u128_accum_mul(&c, a1, b[1]);
  125|  21.1M|    secp256k1_u128_accum_mul(&c, a2, b[0]);
