   18|  21.1M|SECP256K1_FORCE_INLINE static void secp256k1_fe_mul_inner(uint64_t *r, const uint64_t *a, const uint64_t * SECP256K1_RESTRICT b) {
   19|  21.1M|    secp256k1_uint128 c, d;
   20|  21.1M|    uint64_t t3, t4, tx, u0;
   21|  21.1M|    uint64_t a0 = a[0], a1 = a[1], a2 = a[2], a3 = a[3], a4 = a[4];
   22|  21.1M|    const uint64_t M = 0xFFFFFFFFFFFFFULL, R = 0x1000003D10ULL;
   23|       |
   24|  21.1M|    VERIFY_BITS(a[0], 56);
   25|  21.1M|    VERIFY_BITS(a[1], 56);
   26|  21.1M|    VERIFY_BITS(a[2], 56);
   27|  21.1M|    VERIFY_BITS(a[3], 56);
   28|  21.1M|    VERIFY_BITS(a[4], 52);
   29|  21.1M|    VERIFY_BITS(b[0], 56);
   30|  21.1M|    VERIFY_BITS(b[1], 56);
   31|  21.1M|    VERIFY_BITS(b[2], 56);
   32|  21.1M|    VERIFY_BITS(b[3], 56);
   33|  21.1M|    VERIFY_BITS(b[4], 52);
   34|  21.1M|    VERIFY_CHECK(r != b);
   35|  21.1M|    VERIFY_CHECK(a != b);
   36|       |
   37|       |    /*  [... a b c] is a shorthand for ... + a<<104 + b<<52 + c<<0 mod n.
   38|       |     *  for 0 <= x <= 4, px is a shorthand for sum(a[i]*b[x-i], i=0..x).
   39|       |     *  for 4 <= x <= 8, px is a shorthand for sum(a[i]*b[x-i], i=(x-4)..4)
   40|       |     *  Note that [x 0 0 0 0 0] = [x*R].
