  293|  1.42M|        q += u * w;
  294|  1.42M|        r += v * w;
  295|  1.42M|        VERIFY_CHECK((g & m) == 0);
  296|  1.42M|    }
  297|       |    /* Return data in t and return value. */
  298|  92.9k|    t->u = (int64_t)u;
  299|  92.9k|    t->v = (int64_t)v;
  300|  92.9k|    t->q = (int64_t)q;
