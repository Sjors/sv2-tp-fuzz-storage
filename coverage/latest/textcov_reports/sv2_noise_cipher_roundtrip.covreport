secp256k1.c:secp256k1_sha256_finalize:
  243|  37.3k|static void secp256k1_sha256_finalize(const secp256k1_hash_ctx *hash_ctx, secp256k1_sha256 *hash, unsigned char *out32) {
  244|  37.3k|    static const unsigned char pad[64] = {0x80};
  245|  37.3k|    unsigned char sizedesc[8];
  246|  37.3k|    int i;
  247|       |    /* The maximum message size of SHA256 is 2^64-1 bits. */
  248|  37.3k|    VERIFY_CHECK(hash->bytes < ((uint64_t)1 << 61));
  249|  37.3k|    secp256k1_write_be32(&sizedesc[0], hash->bytes >> 29);
  250|  37.3k|    secp256k1_write_be32(&sizedesc[4], hash->bytes << 3);
  251|  37.3k|    secp256k1_sha256_write(hash_ctx, hash, pad, 1 + ((119 - (hash->bytes % 64)) % 64));
  252|  37.3k|    secp256k1_sha256_write(hash_ctx, hash, sizedesc, 8);
  253|   336k|    for (i = 0; i < 8; i++) {
  ------------------
  |  Branch (253:17): [True: 298k, False: 37.3k]
  ------------------
  254|   298k|        secp256k1_write_be32(&out32[4*i], hash->s[i]);
  255|   298k|        hash->s[i] = 0;
  256|   298k|    }
  257|  37.3k|}
secp256k1.c:secp256k1_sha256_clear:
  272|  11.7k|static void secp256k1_sha256_clear(secp256k1_sha256 *hash) {
