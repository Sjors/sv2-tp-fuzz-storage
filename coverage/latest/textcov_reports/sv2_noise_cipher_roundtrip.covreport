   88|  13.7k|static void secp256k1_modinv64_normalize_62(secp256k1_modinv64_signed62 *r, int64_t sign, const secp256k1_modinv64_modinfo *modinfo) {
   89|  13.7k|    const int64_t M62 = (int64_t)(UINT64_MAX >> 2);
   90|  13.7k|    int64_t r0 = r->v[0], r1 = r->v[1], r2 = r->v[2], r3 = r->v[3], r4 = r->v[4];
   91|  13.7k|    volatile int64_t cond_add, cond_negate;
   92|       |
   93|       |#ifdef VERIFY
   94|       |    /* Verify that all limbs are in range (-2^62,2^62). */
   95|       |    int i;
   96|       |    for (i = 0; i < 5; ++i) {
   97|       |        VERIFY_CHECK(r->v[i] >= -M62);
   98|       |        VERIFY_CHECK(r->v[i] <= M62);
   99|       |    }
  100|       |    VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(r, 5, &modinfo->modulus, -2) > 0); /* r > -2*modulus */
  101|       |    VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(r, 5, &modinfo->modulus, 1) < 0); /* r < modulus */
  102|       |#endif
  103|       |
  104|       |    /* In a first step, add the modulus if the input is negative, and then negate if requested.
  105|       |     * This brings r from range (-2*modulus,modulus) to range (-modulus,modulus). As all input
  106|       |     * limbs are in range (-2^62,2^62), this cannot overflow an int64_t. Note that the right
  107|       |     * shifts below are signed sign-extending shifts (see assumptions.h for tests that that is
  108|       |     * indeed the behavior of the right shift operator). */
  109|  13.7k|    cond_add = r4 >> 63;
  110|  13.7k|    r0 += modinfo->modulus.v[0] & cond_add;
  111|  13.7k|    r1 += modinfo->modulus.v[1] & cond_add;
  112|  13.7k|    r2 += modinfo->modulus.v[2] & cond_add;
  113|  13.7k|    r3 += modinfo->modulus.v[3] & cond_add;
  114|  13.7k|    r4 += modinfo->modulus.v[4] & cond_add;
  115|  13.7k|    cond_negate = sign >> 63;
  116|  13.7k|    r0 = (r0 ^ cond_negate) - cond_negate;
  117|  13.7k|    r1 = (r1 ^ cond_negate) - cond_negate;
  118|  13.7k|    r2 = (r2 ^ cond_negate) - cond_negate;
  119|  13.7k|    r3 = (r3 ^ cond_negate) - cond_negate;
  120|  13.7k|    r4 = (r4 ^ cond_negate) - cond_negate;
  121|       |    /* Propagate the top bits, to bring limbs back to range (-2^62,2^62). */
  122|  13.7k|    r1 += r0 >> 62; r0 &= M62;
  123|  13.7k|    r2 += r1 >> 62; r1 &= M62;
  124|  13.7k|    r3 += r2 >> 62; r2 &= M62;
  125|  13.7k|    r4 += r3 >> 62; r3 &= M62;
  126|       |
  127|       |    /* In a second step add the modulus again if the result is still negative, bringing
  128|       |     * r to range [0,modulus). */
  129|  13.7k|    cond_add = r4 >> 63;
  130|  13.7k|    r0 += modinfo->modulus.v[0] & cond_add;
  131|  13.7k|    r1 += modinfo->modulus.v[1] & cond_add;
  132|  13.7k|    r2 += modinfo->modulus.v[2] & cond_add;
  133|  13.7k|    r3 += modinfo->modulus.v[3] & cond_add;
  134|  13.7k|    r4 += modinfo->modulus.v[4] & cond_add;
  135|       |    /* And propagate again. */
  136|  13.7k|    r1 += r0 >> 62; r0 &= M62;
  137|  13.7k|    r2 += r1 >> 62; r1 &= M62;
  138|  13.7k|    r3 += r2 >> 62; r2 &= M62;
  139|  13.7k|    r4 += r3 >> 62; r3 &= M62;
  140|       |
  141|  13.7k|    r->v[0] = r0;
  142|  13.7k|    r->v[1] = r1;
  143|  13.7k|    r->v[2] = r2;
  144|  13.7k|    r->v[3] = r3;
  145|  13.7k|    r->v[4] = r4;
  146|       |
  147|  13.7k|    VERIFY_CHECK(r0 >> 62 == 0);
  148|  13.7k|    VERIFY_CHECK(r1 >> 62 == 0);
  149|  13.7k|    VERIFY_CHECK(r2 >> 62 == 0);
  150|  13.7k|    VERIFY_CHECK(r3 >> 62 == 0);
  151|  13.7k|    VERIFY_CHECK(r4 >> 62 == 0);
  152|  13.7k|    VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(r, 5, &modinfo->modulus, 0) >= 0); /* r >= 0 */
  153|  13.7k|    VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(r, 5, &modinfo->modulus, 1) < 0); /* r < modulus */
  154|  13.7k|}
secp256k1.c:secp256k1_modinv64:
  588|  10.7k|static void secp256k1_modinv64(secp256k1_modinv64_signed62 *x, const secp256k1_modinv64_modinfo *modinfo) {
  589|       |    /* Start with d=0, e=1, f=modulus, g=x, zeta=-1. */
  590|  10.7k|    secp256k1_modinv64_signed62 d = {{0, 0, 0, 0, 0}};
  591|  10.7k|    secp256k1_modinv64_signed62 e = {{1, 0, 0, 0, 0}};
  592|  10.7k|    secp256k1_modinv64_signed62 f = modinfo->modulus;
  593|  10.7k|    secp256k1_modinv64_signed62 g = *x;
  594|  10.7k|    int i;
  595|  10.7k|    int64_t zeta = -1; /* zeta = -(delta+1/2); delta starts at 1/2. */
  596|       |
  597|       |    /* Do 10 iterations of 59 divsteps each = 590 divsteps. This suffices for 256-bit inputs. */
  598|   118k|    for (i = 0; i < 10; ++i) {
  ------------------
  |  Branch (598:17): [True: 107k, False: 10.7k]
  ------------------
  599|       |        /* Compute transition matrix and new zeta after 59 divsteps. */
  600|   107k|        secp256k1_modinv64_trans2x2 t;
  601|   107k|        zeta = secp256k1_modinv64_divsteps_59(zeta, f.v[0], g.v[0], &t);
  602|       |        /* Update d,e using that transition matrix. */
  603|   107k|        secp256k1_modinv64_update_de_62(&d, &e, &t, modinfo);
  604|       |        /* Update f,g using that transition matrix. */
  605|   107k|        VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(&f, 5, &modinfo->modulus, -1) > 0); /* f > -modulus */
  606|   107k|        VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(&f, 5, &modinfo->modulus, 1) <= 0); /* f <= modulus */
  607|   107k|        VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(&g, 5, &modinfo->modulus, -1) > 0); /* g > -modulus */
  608|   107k|        VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(&g, 5, &modinfo->modulus, 1) < 0);  /* g <  modulus */
  609|       |
  610|   107k|        secp256k1_modinv64_update_fg_62(&f, &g, &t);
  611|       |
  612|   107k|        VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(&f, 5, &modinfo->modulus, -1) > 0); /* f > -modulus */
  613|   107k|        VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(&f, 5, &modinfo->modulus, 1) <= 0); /* f <= modulus */
  614|   107k|        VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(&g, 5, &modinfo->modulus, -1) > 0); /* g > -modulus */
  615|   107k|        VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(&g, 5, &modinfo->modulus, 1) < 0);  /* g <  modulus */
  616|   107k|    }
  617|       |
  618|       |    /* At this point sufficient iterations have been performed that g must have reached 0
  619|       |     * and (if g was not originally 0) f must now equal +/- GCD of the initial f, g
  620|       |     * values i.e. +/- 1, and d now contains +/- the modular inverse. */
  621|       |
  622|       |    /* g == 0 */
  623|  10.7k|    VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(&g, 5, &SECP256K1_SIGNED62_ONE, 0) == 0);
  624|       |    /* |f| == 1, or (x == 0 and d == 0 and f == modulus) */
  625|  10.7k|    VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(&f, 5, &SECP256K1_SIGNED62_ONE, -1) == 0 ||
  626|  10.7k|                 secp256k1_modinv64_mul_cmp_62(&f, 5, &SECP256K1_SIGNED62_ONE, 1) == 0 ||
  627|  10.7k|                 (secp256k1_modinv64_mul_cmp_62(x, 5, &SECP256K1_SIGNED62_ONE, 0) == 0 &&
  628|  10.7k|                  secp256k1_modinv64_mul_cmp_62(&d, 5, &SECP256K1_SIGNED62_ONE, 0) == 0 &&
  629|  10.7k|                  secp256k1_modinv64_mul_cmp_62(&f, 5, &modinfo->modulus, 1) == 0));
  630|       |
  631|       |    /* Optionally negate d, normalize to [0,modulus), and return it. */
  632|  10.7k|    secp256k1_modinv64_normalize_62(&d, f.v[4], modinfo);
  633|  10.7k|    *x = d;
  634|  10.7k|}
secp256k1.c:secp256k1_modinv64_divsteps_59:
  167|   107k|static int64_t secp256k1_modinv64_divsteps_59(int64_t zeta, uint64_t f0, uint64_t g0, secp256k1_modinv64_trans2x2 *t) {
  168|       |    /* u,v,q,r are the elements of the transformation matrix being built up,
  169|       |     * starting with the identity matrix times 8 (because the caller expects
  170|       |     * a result scaled by 2^62). Semantically they are signed integers
  171|       |     * in range [-2^62,2^62], but here represented as unsigned mod 2^64. This
  172|       |     * permits left shifting (which is UB for negative numbers). The range
  173|       |     * being inside [-2^63,2^63) means that casting to signed works correctly.
  174|       |     */
  175|   107k|    uint64_t u = 8, v = 0, q = 0, r = 8;
  176|   107k|    volatile uint64_t c1, c2;
  177|   107k|    uint64_t mask1, mask2, f = f0, g = g0, x, y, z;
  178|   107k|    int i;
  179|       |
  180|  6.45M|    for (i = 3; i < 62; ++i) {
  ------------------
  |  Branch (180:17): [True: 6.34M, False: 107k]
  ------------------
  181|  6.34M|        VERIFY_CHECK((f & 1) == 1); /* f must always be odd */
  182|  6.34M|        VERIFY_CHECK((u * f0 + v * g0) == f << i);
  183|  6.34M|        VERIFY_CHECK((q * f0 + r * g0) == g << i);
  184|       |        /* Compute conditional masks for (zeta < 0) and for (g & 1). */
  185|  6.34M|        c1 = zeta >> 63;
  186|  6.34M|        mask1 = c1;
  187|  6.34M|        c2 = g & 1;
  188|  6.34M|        mask2 = -c2;
  189|       |        /* Compute x,y,z, conditionally negated versions of f,u,v. */
  190|  6.34M|        x = (f ^ mask1) - mask1;
  191|  6.34M|        y = (u ^ mask1) - mask1;
  192|  6.34M|        z = (v ^ mask1) - mask1;
  193|       |        /* Conditionally add x,y,z to g,q,r. */
  194|  6.34M|        g += x & mask2;
  195|  6.34M|        q += y & mask2;
  196|  6.34M|        r += z & mask2;
  197|       |        /* In what follows, c1 is a condition mask for (zeta < 0) and (g & 1). */
  198|  6.34M|        mask1 &= mask2;
  199|       |        /* Conditionally change zeta into -zeta-2 or zeta-1. */
  200|  6.34M|        zeta = (zeta ^ mask1) - 1;
  201|       |        /* Conditionally add g,q,r to f,u,v. */
  202|  6.34M|        f += g & mask1;
  203|  6.34M|        u += q & mask1;
  204|  6.34M|        v += r & mask1;
  205|       |        /* Shifts */
  206|  6.34M|        g >>= 1;
  207|  6.34M|        u <<= 1;
  208|  6.34M|        v <<= 1;
  209|       |        /* Bounds on zeta that follow from the bounds on iteration count (max 10*59 divsteps). */
  210|  6.34M|        VERIFY_CHECK(zeta >= -591 && zeta <= 591);
  211|  6.34M|    }
  212|       |    /* Return data in t and return value. */
  213|   107k|    t->u = (int64_t)u;
  214|   107k|    t->v = (int64_t)v;
  215|   107k|    t->q = (int64_t)q;
  216|   107k|    t->r = (int64_t)r;
  217|       |
  218|       |    /* The determinant of t must be a power of two. This guarantees that multiplication with t
  219|       |     * does not change the gcd of f and g, apart from adding a power-of-2 factor to it (which
  220|       |     * will be divided out again). As each divstep's individual matrix has determinant 2, the
  221|       |     * aggregate of 59 of them will have determinant 2^59. Multiplying with the initial
  222|       |     * 8*identity (which has determinant 2^6) means the overall outputs has determinant
  223|       |     * 2^65. */
  224|   107k|    VERIFY_CHECK(secp256k1_modinv64_det_check_pow2(t, 65, 0));
  225|       |
  226|   107k|    return zeta;
  227|   107k|}
secp256k1.c:secp256k1_modinv64_update_fg_62:
  500|   107k|static void secp256k1_modinv64_update_fg_62(secp256k1_modinv64_signed62 *f, secp256k1_modinv64_signed62 *g, const secp256k1_modinv64_trans2x2 *t) {
  501|   107k|    const uint64_t M62 = UINT64_MAX >> 2;
  502|   107k|    const int64_t f0 = f->v[0], f1 = f->v[1], f2 = f->v[2], f3 = f->v[3], f4 = f->v[4];
  503|   107k|    const int64_t g0 = g->v[0], g1 = g->v[1], g2 = g->v[2], g3 = g->v[3], g4 = g->v[4];
  504|   107k|    const int64_t u = t->u, v = t->v, q = t->q, r = t->r;
  505|   107k|    secp256k1_int128 cf, cg;
  506|       |    /* Start computing t*[f,g]. */
  507|   107k|    secp256k1_i128_mul(&cf, u, f0);
  508|   107k|    secp256k1_i128_accum_mul(&cf, v, g0);
  509|   107k|    secp256k1_i128_mul(&cg, q, f0);
  510|   107k|    secp256k1_i128_accum_mul(&cg, r, g0);
  511|       |    /* Verify that the bottom 62 bits of the result are zero, and then throw them away. */
  512|   107k|    VERIFY_CHECK((secp256k1_i128_to_u64(&cf) & M62) == 0); secp256k1_i128_rshift(&cf, 62);
  513|   107k|    VERIFY_CHECK((secp256k1_i128_to_u64(&cg) & M62) == 0); secp256k1_i128_rshift(&cg, 62);
  514|       |    /* Compute limb 1 of t*[f,g], and store it as output limb 0 (= down shift). */
  515|   107k|    secp256k1_i128_accum_mul(&cf, u, f1);
  516|   107k|    secp256k1_i128_accum_mul(&cf, v, g1);
  517|   107k|    secp256k1_i128_accum_mul(&cg, q, f1);
  518|   107k|    secp256k1_i128_accum_mul(&cg, r, g1);
  519|   107k|    f->v[0] = secp256k1_i128_to_u64(&cf) & M62; secp256k1_i128_rshift(&cf, 62);
  520|   107k|    g->v[0] = secp256k1_i128_to_u64(&cg) & M62; secp256k1_i128_rshift(&cg, 62);
  521|       |    /* Compute limb 2 of t*[f,g], and store it as output limb 1. */
  522|   107k|    secp256k1_i128_accum_mul(&cf, u, f2);
  523|   107k|    secp256k1_i128_accum_mul(&cf, v, g2);
  524|   107k|    secp256k1_i128_accum_mul(&cg, q, f2);
  525|   107k|    secp256k1_i128_accum_mul(&cg, r, g2);
  526|   107k|    f->v[1] = secp256k1_i128_to_u64(&cf) & M62; secp256k1_i128_rshift(&cf, 62);
  527|   107k|    g->v[1] = secp256k1_i128_to_u64(&cg) & M62; secp256k1_i128_rshift(&cg, 62);
  528|       |    /* Compute limb 3 of t*[f,g], and store it as output limb 2. */
  529|   107k|    secp256k1_i128_accum_mul(&cf, u, f3);
  530|   107k|    secp256k1_i128_accum_mul(&cf, v, g3);
  531|   107k|    secp256k1_i128_accum_mul(&cg, q, f3);
  532|   107k|    secp256k1_i128_accum_mul(&cg, r, g3);
  533|   107k|    f->v[2] = secp256k1_i128_to_u64(&cf) & M62; secp256k1_i128_rshift(&cf, 62);
  534|   107k|    g->v[2] = secp256k1_i128_to_u64(&cg) & M62; secp256k1_i128_rshift(&cg, 62);
  535|       |    /* Compute limb 4 of t*[f,g], and store it as output limb 3. */
  536|   107k|    secp256k1_i128_accum_mul(&cf, u, f4);
  537|   107k|    secp256k1_i128_accum_mul(&cf, v, g4);
  538|   107k|    secp256k1_i128_accum_mul(&cg, q, f4);
  539|   107k|    secp256k1_i128_accum_mul(&cg, r, g4);
  540|   107k|    f->v[3] = secp256k1_i128_to_u64(&cf) & M62; secp256k1_i128_rshift(&cf, 62);
  541|   107k|    g->v[3] = secp256k1_i128_to_u64(&cg) & M62; secp256k1_i128_rshift(&cg, 62);
  542|       |    /* What remains is limb 5 of t*[f,g]; store it as output limb 4. */
  543|   107k|    f->v[4] = secp256k1_i128_to_i64(&cf);
  544|   107k|    g->v[4] = secp256k1_i128_to_i64(&cg);
  545|   107k|}
secp256k1.c:secp256k1_jacobi64_maybe_var:
  721|  12.6k|static int secp256k1_jacobi64_maybe_var(const secp256k1_modinv64_signed62 *x, const secp256k1_modinv64_modinfo *modinfo) {
  722|       |    /* Start with f=modulus, g=x, eta=-1. */
  723|  12.6k|    secp256k1_modinv64_signed62 f = modinfo->modulus;
  724|  12.6k|    secp256k1_modinv64_signed62 g = *x;
  725|  12.6k|    int j, len = 5;
  726|  12.6k|    int64_t eta = -1; /* eta = -delta; delta is initially 1 */
  727|  12.6k|    int64_t cond, fn, gn;
  728|  12.6k|    int jac = 0;
  729|  12.6k|    int count;
  730|       |
  731|       |    /* The input limbs must all be non-negative. */
  732|  12.6k|    VERIFY_CHECK(g.v[0] >= 0 && g.v[1] >= 0 && g.v[2] >= 0 && g.v[3] >= 0 && g.v[4] >= 0);
  733|       |
  734|       |    /* If x > 0, then if the loop below converges, it converges to f=g=gcd(x,modulus). Since we
  735|       |     * require that gcd(x,modulus)=1 and modulus>=3, x cannot be 0. Thus, we must reach f=1 (or
  736|       |     * time out). */
  737|  12.6k|    VERIFY_CHECK((g.v[0] | g.v[1] | g.v[2] | g.v[3] | g.v[4]) != 0);
  738|       |
  739|   160k|    for (count = 0; count < JACOBI64_ITERATIONS; ++count) {
  ------------------
  |  |  717|   160k|#define JACOBI64_ITERATIONS 25
  ------------------
  |  Branch (739:21): [True: 160k, False: 0]
  ------------------
  740|       |        /* Compute transition matrix and new eta after 62 posdivsteps. */
  741|   160k|        secp256k1_modinv64_trans2x2 t;
  742|   160k|        eta = secp256k1_modinv64_posdivsteps_62_var(eta, f.v[0] | ((uint64_t)f.v[1] << 62), g.v[0] | ((uint64_t)g.v[1] << 62), &t, &jac);
  743|       |        /* Update f,g using that transition matrix. */
  744|   160k|        VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(&f, len, &modinfo->modulus, 0) > 0); /* f > 0 */
  745|   160k|        VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(&f, len, &modinfo->modulus, 1) <= 0); /* f <= modulus */
  746|   160k|        VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(&g, len, &modinfo->modulus, 0) > 0); /* g > 0 */
  747|   160k|        VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(&g, len, &modinfo->modulus, 1) < 0);  /* g < modulus */
  748|       |
  749|   160k|        secp256k1_modinv64_update_fg_62_var(len, &f, &g, &t);
  750|       |        /* If the bottom limb of f is 1, there is a chance that f=1. */
  751|   160k|        if (f.v[0] == 1) {
  ------------------
  |  Branch (751:13): [True: 12.6k, False: 147k]
  ------------------
  752|  12.6k|            cond = 0;
  753|       |            /* Check if the other limbs are also 0. */
  754|  12.6k|            for (j = 1; j < len; ++j) {
  ------------------
  |  Branch (754:25): [True: 0, False: 12.6k]
  ------------------
  755|      0|                cond |= f.v[j];
  756|      0|            }
  757|       |            /* If so, we're done. When f=1, the Jacobi symbol (g | f)=1. */
  758|  12.6k|            if (cond == 0) return 1 - 2*(jac & 1);
  ------------------
  |  Branch (758:17): [True: 12.6k, False: 0]
  ------------------
  759|  12.6k|        }
  760|       |
  761|       |        /* Determine if len>1 and limb (len-1) of both f and g is 0. */
  762|   147k|        fn = f.v[len - 1];
  763|   147k|        gn = g.v[len - 1];
  764|   147k|        cond = ((int64_t)len - 2) >> 63;
  765|   147k|        cond |= fn;
  766|   147k|        cond |= gn;
  767|       |        /* If so, reduce length. */
  768|   147k|        if (cond == 0) --len;
  ------------------
  |  Branch (768:13): [True: 50.5k, False: 96.9k]
  ------------------
  769|       |
  770|   147k|        VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(&f, len, &modinfo->modulus, 0) > 0); /* f > 0 */
  771|   147k|        VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(&f, len, &modinfo->modulus, 1) <= 0); /* f <= modulus */
  772|   147k|        VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(&g, len, &modinfo->modulus, 0) > 0); /* g > 0 */
  773|   147k|        VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(&g, len, &modinfo->modulus, 1) < 0);  /* g < modulus */
  774|   147k|    }
  775|       |
  776|       |    /* The loop failed to converge to f=g after 1550 iterations. Return 0, indicating unknown result. */
  777|      0|    return 0;
  778|  12.6k|}
secp256k1.c:secp256k1_modinv64_posdivsteps_62_var:
  325|   160k|static int64_t secp256k1_modinv64_posdivsteps_62_var(int64_t eta, uint64_t f0, uint64_t g0, secp256k1_modinv64_trans2x2 *t, int *jacp) {
  326|       |    /* Transformation matrix; see comments in secp256k1_modinv64_divsteps_62. */
  327|   160k|    uint64_t u = 1, v = 0, q = 0, r = 1;
  328|   160k|    uint64_t f = f0, g = g0, m;
  329|   160k|    uint32_t w;
  330|   160k|    int i = 62, limit, zeros;
  331|   160k|    int jac = *jacp;
  332|       |
  333|  2.81M|    for (;;) {
  334|       |        /* Use a sentinel bit to count zeros only up to i. */
  335|  2.81M|        zeros = secp256k1_ctz64_var(g | (UINT64_MAX << i));
  336|       |        /* Perform zeros divsteps at once; they all just divide g by two. */
  337|  2.81M|        g >>= zeros;
  338|  2.81M|        u <<= zeros;
  339|  2.81M|        v <<= zeros;
  340|  2.81M|        eta -= zeros;
  341|  2.81M|        i -= zeros;
  342|       |        /* Update the bottom bit of jac: when dividing g by an odd power of 2,
  343|       |         * if (f mod 8) is 3 or 5, the Jacobi symbol changes sign. */
  344|  2.81M|        jac ^= (zeros & ((f >> 1) ^ (f >> 2)));
  345|       |        /* We're done once we've done 62 posdivsteps. */
  346|  2.81M|        if (i == 0) break;
  ------------------
  |  Branch (346:13): [True: 160k, False: 2.65M]
  ------------------
  347|  2.65M|        VERIFY_CHECK((f & 1) == 1);
  348|  2.65M|        VERIFY_CHECK((g & 1) == 1);
  349|  2.65M|        VERIFY_CHECK((u * f0 + v * g0) == f << (62 - i));
  350|  2.65M|        VERIFY_CHECK((q * f0 + r * g0) == g << (62 - i));
  351|       |        /* If eta is negative, negate it and replace f,g with g,f. */
  352|  2.65M|        if (eta < 0) {
  ------------------
  |  Branch (352:13): [True: 2.57M, False: 87.2k]
  ------------------
  353|  2.57M|            uint64_t tmp;
  354|  2.57M|            eta = -eta;
  355|  2.57M|            tmp = f; f = g; g = tmp;
  356|  2.57M|            tmp = u; u = q; q = tmp;
  357|  2.57M|            tmp = v; v = r; r = tmp;
  358|       |            /* Update bottom bit of jac: when swapping f and g, the Jacobi symbol changes sign
  359|       |             * if both f and g are 3 mod 4. */
  360|  2.57M|            jac ^= ((f & g) >> 1);
  361|       |            /* Use a formula to cancel out up to 6 bits of g. Also, no more than i can be cancelled
  362|       |             * out (as we'd be done before that point), and no more than eta+1 can be done as its
  363|       |             * sign will flip again once that happens. */
  364|  2.57M|            limit = ((int)eta + 1) > i ? i : ((int)eta + 1);
  ------------------
  |  Branch (364:21): [True: 49.5k, False: 2.52M]
  ------------------
  365|  2.57M|            VERIFY_CHECK(limit > 0 && limit <= 62);
  366|       |            /* m is a mask for the bottom min(limit, 6) bits. */
  367|  2.57M|            m = (UINT64_MAX >> (64 - limit)) & 63U;
