  243|  33.6k|static void secp256k1_sha256_finalize(const secp256k1_hash_ctx *hash_ctx, secp256k1_sha256 *hash, unsigned char *out32) {
  244|  33.6k|    static const unsigned char pad[64] = {0x80};
  245|  33.6k|    unsigned char sizedesc[8];
  246|  33.6k|    int i;
  247|       |    /* The maximum message size of SHA256 is 2^64-1 bits. */
  248|  33.6k|    VERIFY_CHECK(hash->bytes < ((uint64_t)1 << 61));
  249|  33.6k|    secp256k1_write_be32(&sizedesc[0], hash->bytes >> 29);
  250|  33.6k|    secp256k1_write_be32(&sizedesc[4], hash->bytes << 3);
  251|  33.6k|    secp256k1_sha256_write(hash_ctx, hash, pad, 1 + ((119 - (hash->bytes % 64)) % 64));
  252|  33.6k|    secp256k1_sha256_write(hash_ctx, hash, sizedesc, 8);
  253|   302k|    for (i = 0; i < 8; i++) {
  ------------------
  |  Branch (253:17): [True: 269k, False: 33.6k]
  ------------------
  254|   269k|        secp256k1_write_be32(&out32[4*i], hash->s[i]);
  255|   269k|        hash->s[i] = 0;
  256|   269k|    }
  257|  33.6k|}
