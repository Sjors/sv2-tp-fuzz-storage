  223|  4.95M|    r[0] = secp256k1_u128_to_u64(&c) & M; secp256k1_u128_rshift(&c, 52);
  224|  4.95M|    VERIFY_BITS(r[0], 52);
  225|  4.95M|    VERIFY_BITS_128(&c, 61);
  226|       |    /* [d 0 t4 t3 0 c r0] = [p8 0 0 p5 p4 p3 0 0 p0] */
  227|       |
  228|  4.95M|    a0 *= 2;
  229|  4.95M|    secp256k1_u128_accum_mul(&c, a0, a1);
  230|  4.95M|    VERIFY_BITS_128(&c, 114);
  231|       |    /* [d 0 t4 t3 0 c r0] = [p8 0 0 p5 p4 p3 0 p1 p0] */
  232|  4.95M|    secp256k1_u128_accum_mul(&d, a2, a4);
  233|  4.95M|    secp256k1_u128_accum_mul(&d, a3, a3);
  234|  4.95M|    VERIFY_BITS_128(&d, 114);
  235|       |    /* [d 0 t4 t3 0 c r0] = [p8 0 p6 p5 p4 p3 0 p1 p0] */
  236|  4.95M|    secp256k1_u128_accum_mul(&c, secp256k1_u128_to_u64(&d) & M, R); secp256k1_u128_rshift(&d, 52);
  237|  4.95M|    VERIFY_BITS_128(&c, 115);
  238|  4.95M|    VERIFY_BITS_128(&d, 62);
  239|       |    /* [d 0 0 t4 t3 0 c r0] = [p8 0 p6 p5 p4 p3 0 p1 p0] */
  240|  4.95M|    r[1] = secp256k1_u128_to_u64(&c) & M; secp256k1_u128_rshift(&c, 52);
  241|  4.95M|    VERIFY_BITS(r[1], 52);
  242|  4.95M|    VERIFY_BITS_128(&c, 63);
  243|       |    /* [d 0 0 t4 t3 c r1 r0] = [p8 0 p6 p5 p4 p3 0 p1 p0] */
  244|       |
  245|  4.95M|    secp256k1_u128_accum_mul(&c, a0, a2);
  246|  4.95M|    secp256k1_u128_accum_mul(&c, a1, a1);
  247|  4.95M|    VERIFY_BITS_128(&c, 114);
  248|       |    /* [d 0 0 t4 t3 c r1 r0] = [p8 0 p6 p5 p4 p3 p2 p1 p0] */
  249|  4.95M|    secp256k1_u128_accum_mul(&d, a3, a4);
  250|  4.95M|    VERIFY_BITS_128(&d, 114);
  251|       |    /* [d 0 0 t4 t3 c r1 r0] = [p8 p7 p6 p5 p4 p3 p2 p1 p0] */
  252|  4.95M|    secp256k1_u128_accum_mul(&c, R, secp256k1_u128_to_u64(&d)); secp256k1_u128_rshift(&d, 64);
  253|  4.95M|    VERIFY_BITS_128(&c, 115);
  254|  4.95M|    VERIFY_BITS_128(&d, 50);
  255|       |    /* [(d<<12) 0 0 0 t4 t3 c r1 r0] = [p8 p7 p6 p5 p4 p3 p2 p1 p0] */
  256|  4.95M|    r[2] = secp256k1_u128_to_u64(&c) & M; secp256k1_u128_rshift(&c, 52);
  257|  4.95M|    VERIFY_BITS(r[2], 52);
  258|  4.95M|    VERIFY_BITS_128(&c, 63);
  259|       |    /* [(d<<12) 0 0 0 t4 t3+c r2 r1 r0] = [p8 p7 p6 p5 p4 p3 p2 p1 p0] */
  260|       |
  261|  4.95M|    secp256k1_u128_accum_mul(&c, R << 12, secp256k1_u128_to_u64(&d));
