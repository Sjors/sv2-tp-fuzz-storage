secp256k1.c:secp256k1_sha256_write:
  210|   150k|static void secp256k1_sha256_write(const secp256k1_hash_ctx *hash_ctx, secp256k1_sha256 *hash, const unsigned char *data, size_t len) {
  211|   150k|    size_t chunk_len;
  212|   150k|    size_t bufsize = hash->bytes & 0x3F;
  213|   150k|    hash->bytes += len;
  214|   150k|    VERIFY_CHECK(hash->bytes >= len);
  215|   150k|    VERIFY_CHECK(hash_ctx != NULL);
  216|   150k|    VERIFY_CHECK(hash_ctx->fn_sha256_compression != NULL);
  217|       |
  218|       |    /* If we exceed the 64-byte block size with this input, process it and wipe the buffer */
  219|   150k|    chunk_len = 64 - bufsize;
  220|   150k|    if (bufsize && len >= chunk_len) {
  ------------------
  |  Branch (220:9): [True: 110k, False: 39.4k]
  |  Branch (220:20): [True: 48.7k, False: 62.2k]
  ------------------
  221|  48.7k|        memcpy(hash->buf + bufsize, data, chunk_len);
  222|  48.7k|        data += chunk_len;
  223|  48.7k|        len -= chunk_len;
  224|  48.7k|        hash_ctx->fn_sha256_compression(hash->s, hash->buf, 1);
  225|  48.7k|        bufsize = 0;
  226|  48.7k|    }
  227|       |
  228|       |    /* If we still have data to process, invoke compression directly on the input */
  229|   150k|    if (len >= 64) {
  ------------------
  |  Branch (229:9): [True: 10.2k, False: 140k]
  ------------------
  230|  10.2k|        const size_t n_blocks = len / 64;
  231|  10.2k|        const size_t advance = n_blocks * 64;
  232|  10.2k|        hash_ctx->fn_sha256_compression(hash->s, data, n_blocks);
  233|  10.2k|        data += advance;
  234|  10.2k|        len -= advance;
  235|  10.2k|    }
  236|       |
  237|       |    /* Fill the buffer with what remains */
  238|   150k|    if (len) {
  ------------------
  |  Branch (238:9): [True: 91.4k, False: 58.9k]
  ------------------
  239|  91.4k|        memcpy(hash->buf + bufsize, data, len);
  240|  91.4k|    }
