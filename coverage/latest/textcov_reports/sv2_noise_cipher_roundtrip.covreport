  467|   404k|    secp256k1_i128_accum_mul(&cd, u, d3);
  468|   404k|    secp256k1_i128_accum_mul(&cd, v, e3);
  469|   404k|    secp256k1_i128_accum_mul(&ce, q, d3);
  470|   404k|    secp256k1_i128_accum_mul(&ce, r, e3);
  471|   404k|    if (modinfo->modulus.v[3]) { /* Optimize for the case where limb of modulus is zero. */
  ------------------
  |  Branch (471:9): [True: 0, False: 404k]
  ------------------
  472|      0|        secp256k1_i128_accum_mul(&cd, modinfo->modulus.v[3], md);
  473|      0|        secp256k1_i128_accum_mul(&ce, modinfo->modulus.v[3], me);
  474|      0|    }
  475|   404k|    d->v[2] = secp256k1_i128_to_u64(&cd) & M62; secp256k1_i128_rshift(&cd, 62);
  476|   404k|    e->v[2] = secp256k1_i128_to_u64(&ce) & M62; secp256k1_i128_rshift(&ce, 62);
  477|       |    /* Compute limb 4 of t*[d,e]+modulus*[md,me], and store it as output limb 3. */
  478|   404k|    secp256k1_i128_accum_mul(&cd, u, d4);
  479|   404k|    secp256k1_i128_accum_mul(&cd, v, e4);
  480|   404k|    secp256k1_i128_accum_mul(&ce, q, d4);
  481|   404k|    secp256k1_i128_accum_mul(&ce, r, e4);
  482|   404k|    secp256k1_i128_accum_mul(&cd, modinfo->modulus.v[4], md);
  483|   404k|    secp256k1_i128_accum_mul(&ce, modinfo->modulus.v[4], me);
  484|   404k|    d->v[3] = secp256k1_i128_to_u64(&cd) & M62; secp256k1_i128_rshift(&cd, 62);
  485|   404k|    e->v[3] = secp256k1_i128_to_u64(&ce) & M62; secp256k1_i128_rshift(&ce, 62);
  486|       |    /* What remains is limb 5 of t*[d,e]+modulus*[md,me]; store it as output limb 4. */
  487|   404k|    d->v[4] = secp256k1_i128_to_i64(&cd);
  488|   404k|    e->v[4] = secp256k1_i128_to_i64(&ce);
  489|       |
  490|   404k|    VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(d, 5, &modinfo->modulus, -2) > 0); /* d > -2*modulus */
  491|   404k|    VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(d, 5, &modinfo->modulus, 1) < 0);  /* d <    modulus */
  492|   404k|    VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(e, 5, &modinfo->modulus, -2) > 0); /* e > -2*modulus */
  493|   404k|    VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(e, 5, &modinfo->modulus, 1) < 0);  /* e <    modulus */
  494|   404k|}
secp256k1.c:secp256k1_modinv64_update_fg_62_var:
  553|   523k|static void secp256k1_modinv64_update_fg_62_var(int len, secp256k1_modinv64_signed62 *f, secp256k1_modinv64_signed62 *g, const secp256k1_modinv64_trans2x2 *t) {
  554|   523k|    const uint64_t M62 = UINT64_MAX >> 2;
  555|   523k|    const int64_t u = t->u, v = t->v, q = t->q, r = t->r;
  556|   523k|    int64_t fi, gi;
  557|   523k|    secp256k1_int128 cf, cg;
  558|   523k|    int i;
  559|   523k|    VERIFY_CHECK(len > 0);
  560|       |    /* Start computing t*[f,g]. */
  561|   523k|    fi = f->v[0];
  562|   523k|    gi = g->v[0];
  563|   523k|    secp256k1_i128_mul(&cf, u, fi);
  564|   523k|    secp256k1_i128_accum_mul(&cf, v, gi);
  565|   523k|    secp256k1_i128_mul(&cg, q, fi);
  566|   523k|    secp256k1_i128_accum_mul(&cg, r, gi);
  567|       |    /* Verify that the bottom 62 bits of the result are zero, and then throw them away. */
  568|   523k|    VERIFY_CHECK((secp256k1_i128_to_u64(&cf) & M62) == 0); secp256k1_i128_rshift(&cf, 62);
  569|   523k|    VERIFY_CHECK((secp256k1_i128_to_u64(&cg) & M62) == 0); secp256k1_i128_rshift(&cg, 62);
  570|       |    /* Now iteratively compute limb i=1..len of t*[f,g], and store them in output limb i-1 (shifting
  571|       |     * down by 62 bits). */
  572|  1.42M|    for (i = 1; i < len; ++i) {
  ------------------
  |  Branch (572:17): [True: 901k, False: 523k]
  ------------------
  573|   901k|        fi = f->v[i];
  574|   901k|        gi = g->v[i];
  575|   901k|        secp256k1_i128_accum_mul(&cf, u, fi);
  576|   901k|        secp256k1_i128_accum_mul(&cf, v, gi);
  577|   901k|        secp256k1_i128_accum_mul(&cg, q, fi);
  578|   901k|        secp256k1_i128_accum_mul(&cg, r, gi);
  579|   901k|        f->v[i - 1] = secp256k1_i128_to_u64(&cf) & M62; secp256k1_i128_rshift(&cf, 62);
  580|   901k|        g->v[i - 1] = secp256k1_i128_to_u64(&cg) & M62; secp256k1_i128_rshift(&cg, 62);
  581|   901k|    }
  582|       |    /* What remains is limb (len) of t*[f,g]; store it as output limb (len-1). */
  583|   523k|    f->v[len - 1] = secp256k1_i128_to_i64(&cf);
  584|   523k|    g->v[len - 1] = secp256k1_i128_to_i64(&cg);
  585|   523k|}
secp256k1.c:secp256k1_modinv64_normalize_62:
   88|  41.3k|static void secp256k1_modinv64_normalize_62(secp256k1_modinv64_signed62 *r, int64_t sign, const secp256k1_modinv64_modinfo *modinfo) {
   89|  41.3k|    const int64_t M62 = (int64_t)(UINT64_MAX >> 2);
   90|  41.3k|    int64_t r0 = r->v[0], r1 = r->v[1], r2 = r->v[2], r3 = r->v[3], r4 = r->v[4];
   91|  41.3k|    volatile int64_t cond_add, cond_negate;
   92|       |
   93|       |#ifdef VERIFY
   94|       |    /* Verify that all limbs are in range (-2^62,2^62). */
   95|       |    int i;
   96|       |    for (i = 0; i < 5; ++i) {
   97|       |        VERIFY_CHECK(r->v[i] >= -M62);
   98|       |        VERIFY_CHECK(r->v[i] <= M62);
   99|       |    }
  100|       |    VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(r, 5, &modinfo->modulus, -2) > 0); /* r > -2*modulus */
  101|       |    VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(r, 5, &modinfo->modulus, 1) < 0); /* r < modulus */
  102|       |#endif
  103|       |
  104|       |    /* In a first step, add the modulus if the input is negative, and then negate if requested.
  105|       |     * This brings r from range (-2*modulus,modulus) to range (-modulus,modulus). As all input
  106|       |     * limbs are in range (-2^62,2^62), this cannot overflow an int64_t. Note that the right
  107|       |     * shifts below are signed sign-extending shifts (see assumptions.h for tests that that is
  108|       |     * indeed the behavior of the right shift operator). */
  109|  41.3k|    cond_add = r4 >> 63;
  110|  41.3k|    r0 += modinfo->modulus.v[0] & cond_add;
  111|  41.3k|    r1 += modinfo->modulus.v[1] & cond_add;
  112|  41.3k|    r2 += modinfo->modulus.v[2] & cond_add;
  113|  41.3k|    r3 += modinfo->modulus.v[3] & cond_add;
  114|  41.3k|    r4 += modinfo->modulus.v[4] & cond_add;
  115|  41.3k|    cond_negate = sign >> 63;
  116|  41.3k|    r0 = (r0 ^ cond_negate) - cond_negate;
  117|  41.3k|    r1 = (r1 ^ cond_negate) - cond_negate;
  118|  41.3k|    r2 = (r2 ^ cond_negate) - cond_negate;
  119|  41.3k|    r3 = (r3 ^ cond_negate) - cond_negate;
  120|  41.3k|    r4 = (r4 ^ cond_negate) - cond_negate;
  121|       |    /* Propagate the top bits, to bring limbs back to range (-2^62,2^62). */
  122|  41.3k|    r1 += r0 >> 62; r0 &= M62;
  123|  41.3k|    r2 += r1 >> 62; r1 &= M62;
  124|  41.3k|    r3 += r2 >> 62; r2 &= M62;
  125|  41.3k|    r4 += r3 >> 62; r3 &= M62;
  126|       |
  127|       |    /* In a second step add the modulus again if the result is still negative, bringing
  128|       |     * r to range [0,modulus). */
  129|  41.3k|    cond_add = r4 >> 63;
  130|  41.3k|    r0 += modinfo->modulus.v[0] & cond_add;
  131|  41.3k|    r1 += modinfo->modulus.v[1] & cond_add;
  132|  41.3k|    r2 += modinfo->modulus.v[2] & cond_add;
  133|  41.3k|    r3 += modinfo->modulus.v[3] & cond_add;
  134|  41.3k|    r4 += modinfo->modulus.v[4] & cond_add;
  135|       |    /* And propagate again. */
  136|  41.3k|    r1 += r0 >> 62; r0 &= M62;
  137|  41.3k|    r2 += r1 >> 62; r1 &= M62;
  138|  41.3k|    r3 += r2 >> 62; r2 &= M62;
  139|  41.3k|    r4 += r3 >> 62; r3 &= M62;
  140|       |
  141|  41.3k|    r->v[0] = r0;
  142|  41.3k|    r->v[1] = r1;
  143|  41.3k|    r->v[2] = r2;
  144|  41.3k|    r->v[3] = r3;
  145|  41.3k|    r->v[4] = r4;
  146|       |
  147|  41.3k|    VERIFY_CHECK(r0 >> 62 == 0);
  148|  41.3k|    VERIFY_CHECK(r1 >> 62 == 0);
  149|  41.3k|    VERIFY_CHECK(r2 >> 62 == 0);
  150|  41.3k|    VERIFY_CHECK(r3 >> 62 == 0);
  151|  41.3k|    VERIFY_CHECK(r4 >> 62 == 0);
  152|  41.3k|    VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(r, 5, &modinfo->modulus, 0) >= 0); /* r >= 0 */
  153|  41.3k|    VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(r, 5, &modinfo->modulus, 1) < 0); /* r < modulus */
  154|  41.3k|}
secp256k1.c:secp256k1_modinv64:
  588|  32.5k|static void secp256k1_modinv64(secp256k1_modinv64_signed62 *x, const secp256k1_modinv64_modinfo *modinfo) {
  589|       |    /* Start with d=0, e=1, f=modulus, g=x, zeta=-1. */
  590|  32.5k|    secp256k1_modinv64_signed62 d = {{0, 0, 0, 0, 0}};
  591|  32.5k|    secp256k1_modinv64_signed62 e = {{1, 0, 0, 0, 0}};
  592|  32.5k|    secp256k1_modinv64_signed62 f = modinfo->modulus;
  593|  32.5k|    secp256k1_modinv64_signed62 g = *x;
  594|  32.5k|    int i;
  595|  32.5k|    int64_t zeta = -1; /* zeta = -(delta+1/2); delta starts at 1/2. */
  596|       |
  597|       |    /* Do 10 iterations of 59 divsteps each = 590 divsteps. This suffices for 256-bit inputs. */
  598|   358k|    for (i = 0; i < 10; ++i) {
  ------------------
  |  Branch (598:17): [True: 325k, False: 32.5k]
  ------------------
  599|       |        /* Compute transition matrix and new zeta after 59 divsteps. */
  600|   325k|        secp256k1_modinv64_trans2x2 t;
  601|   325k|        zeta = secp256k1_modinv64_divsteps_59(zeta, f.v[0], g.v[0], &t);
  602|       |        /* Update d,e using that transition matrix. */
  603|   325k|        secp256k1_modinv64_update_de_62(&d, &e, &t, modinfo);
  604|       |        /* Update f,g using that transition matrix. */
  605|   325k|        VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(&f, 5, &modinfo->modulus, -1) > 0); /* f > -modulus */
  606|   325k|        VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(&f, 5, &modinfo->modulus, 1) <= 0); /* f <= modulus */
  607|   325k|        VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(&g, 5, &modinfo->modulus, -1) > 0); /* g > -modulus */
  608|   325k|        VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(&g, 5, &modinfo->modulus, 1) < 0);  /* g <  modulus */
  609|       |
  610|   325k|        secp256k1_modinv64_update_fg_62(&f, &g, &t);
  611|       |
  612|   325k|        VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(&f, 5, &modinfo->modulus, -1) > 0); /* f > -modulus */
  613|   325k|        VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(&f, 5, &modinfo->modulus, 1) <= 0); /* f <= modulus */
  614|   325k|        VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(&g, 5, &modinfo->modulus, -1) > 0); /* g > -modulus */
  615|   325k|        VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(&g, 5, &modinfo->modulus, 1) < 0);  /* g <  modulus */
  616|   325k|    }
  617|       |
  618|       |    /* At this point sufficient iterations have been performed that g must have reached 0
  619|       |     * and (if g was not originally 0) f must now equal +/- GCD of the initial f, g
  620|       |     * values i.e. +/- 1, and d now contains +/- the modular inverse. */
  621|       |
  622|       |    /* g == 0 */
  623|  32.5k|    VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(&g, 5, &SECP256K1_SIGNED62_ONE, 0) == 0);
  624|       |    /* |f| == 1, or (x == 0 and d == 0 and f == modulus) */
  625|  32.5k|    VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(&f, 5, &SECP256K1_SIGNED62_ONE, -1) == 0 ||
  626|  32.5k|                 secp256k1_modinv64_mul_cmp_62(&f, 5, &SECP256K1_SIGNED62_ONE, 1) == 0 ||
  627|  32.5k|                 (secp256k1_modinv64_mul_cmp_62(x, 5, &SECP256K1_SIGNED62_ONE, 0) == 0 &&
  628|  32.5k|                  secp256k1_modinv64_mul_cmp_62(&d, 5, &SECP256K1_SIGNED62_ONE, 0) == 0 &&
  629|  32.5k|                  secp256k1_modinv64_mul_cmp_62(&f, 5, &modinfo->modulus, 1) == 0));
  630|       |
  631|       |    /* Optionally negate d, normalize to [0,modulus), and return it. */
  632|  32.5k|    secp256k1_modinv64_normalize_62(&d, f.v[4], modinfo);
  633|  32.5k|    *x = d;
  634|  32.5k|}
secp256k1.c:secp256k1_modinv64_divsteps_59:
  167|   325k|static int64_t secp256k1_modinv64_divsteps_59(int64_t zeta, uint64_t f0, uint64_t g0, secp256k1_modinv64_trans2x2 *t) {
  168|       |    /* u,v,q,r are the elements of the transformation matrix being built up,
  169|       |     * starting with the identity matrix times 8 (because the caller expects
  170|       |     * a result scaled by 2^62). Semantically they are signed integers
  171|       |     * in range [-2^62,2^62], but here represented as unsigned mod 2^64. This
  172|       |     * permits left shifting (which is UB for negative numbers). The range
  173|       |     * being inside [-2^63,2^63) means that casting to signed works correctly.
  174|       |     */
  175|   325k|    uint64_t u = 8, v = 0, q = 0, r = 8;
  176|   325k|    volatile uint64_t c1, c2;
  177|   325k|    uint64_t mask1, mask2, f = f0, g = g0, x, y, z;
  178|   325k|    int i;
  179|       |
  180|  19.5M|    for (i = 3; i < 62; ++i) {
  ------------------
  |  Branch (180:17): [True: 19.2M, False: 325k]
  ------------------
  181|  19.2M|        VERIFY_CHECK((f & 1) == 1); /* f must always be odd */
  182|  19.2M|        VERIFY_CHECK((u * f0 + v * g0) == f << i);
  183|  19.2M|        VERIFY_CHECK((q * f0 + r * g0) == g << i);
  184|       |        /* Compute conditional masks for (zeta < 0) and for (g & 1). */
  185|  19.2M|        c1 = zeta >> 63;
  186|  19.2M|        mask1 = c1;
  187|  19.2M|        c2 = g & 1;
  188|  19.2M|        mask2 = -c2;
  189|       |        /* Compute x,y,z, conditionally negated versions of f,u,v. */
  190|  19.2M|        x = (f ^ mask1) - mask1;
  191|  19.2M|        y = (u ^ mask1) - mask1;
  192|  19.2M|        z = (v ^ mask1) - mask1;
  193|       |        /* Conditionally add x,y,z to g,q,r. */
  194|  19.2M|        g += x & mask2;
  195|  19.2M|        q += y & mask2;
  196|  19.2M|        r += z & mask2;
  197|       |        /* In what follows, c1 is a condition mask for (zeta < 0) and (g & 1). */
  198|  19.2M|        mask1 &= mask2;
  199|       |        /* Conditionally change zeta into -zeta-2 or zeta-1. */
  200|  19.2M|        zeta = (zeta ^ mask1) - 1;
  201|       |        /* Conditionally add g,q,r to f,u,v. */
  202|  19.2M|        f += g & mask1;
  203|  19.2M|        u += q & mask1;
  204|  19.2M|        v += r & mask1;
  205|       |        /* Shifts */
  206|  19.2M|        g >>= 1;
  207|  19.2M|        u <<= 1;
  208|  19.2M|        v <<= 1;
  209|       |        /* Bounds on zeta that follow from the bounds on iteration count (max 10*59 divsteps). */
  210|  19.2M|        VERIFY_CHECK(zeta >= -591 && zeta <= 591);
  211|  19.2M|    }
  212|       |    /* Return data in t and return value. */
  213|   325k|    t->u = (int64_t)u;
  214|   325k|    t->v = (int64_t)v;
  215|   325k|    t->q = (int64_t)q;
  216|   325k|    t->r = (int64_t)r;
  217|       |
  218|       |    /* The determinant of t must be a power of two. This guarantees that multiplication with t
  219|       |     * does not change the gcd of f and g, apart from adding a power-of-2 factor to it (which
  220|       |     * will be divided out again). As each divstep's individual matrix has determinant 2, the
  221|       |     * aggregate of 59 of them will have determinant 2^59. Multiplying with the initial
  222|       |     * 8*identity (which has determinant 2^6) means the overall outputs has determinant
  223|       |     * 2^65. */
  224|   325k|    VERIFY_CHECK(secp256k1_modinv64_det_check_pow2(t, 65, 0));
  225|       |
  226|   325k|    return zeta;
  227|   325k|}
secp256k1.c:secp256k1_modinv64_update_fg_62:
  500|   325k|static void secp256k1_modinv64_update_fg_62(secp256k1_modinv64_signed62 *f, secp256k1_modinv64_signed62 *g, const secp256k1_modinv64_trans2x2 *t) {
  501|   325k|    const uint64_t M62 = UINT64_MAX >> 2;
  502|   325k|    const int64_t f0 = f->v[0], f1 = f->v[1], f2 = f->v[2], f3 = f->v[3], f4 = f->v[4];
  503|   325k|    const int64_t g0 = g->v[0], g1 = g->v[1], g2 = g->v[2], g3 = g->v[3], g4 = g->v[4];
  504|   325k|    const int64_t u = t->u, v = t->v, q = t->q, r = t->r;
  505|   325k|    secp256k1_int128 cf, cg;
  506|       |    /* Start computing t*[f,g]. */
  507|   325k|    secp256k1_i128_mul(&cf, u, f0);
  508|   325k|    secp256k1_i128_accum_mul(&cf, v, g0);
  509|   325k|    secp256k1_i128_mul(&cg, q, f0);
  510|   325k|    secp256k1_i128_accum_mul(&cg, r, g0);
  511|       |    /* Verify that the bottom 62 bits of the result are zero, and then throw them away. */
  512|   325k|    VERIFY_CHECK((secp256k1_i128_to_u64(&cf) & M62) == 0); secp256k1_i128_rshift(&cf, 62);
  513|   325k|    VERIFY_CHECK((secp256k1_i128_to_u64(&cg) & M62) == 0); secp256k1_i128_rshift(&cg, 62);
  514|       |    /* Compute limb 1 of t*[f,g], and store it as output limb 0 (= down shift). */
  515|   325k|    secp256k1_i128_accum_mul(&cf, u, f1);
  516|   325k|    secp256k1_i128_accum_mul(&cf, v, g1);
  517|   325k|    secp256k1_i128_accum_mul(&cg, q, f1);
  518|   325k|    secp256k1_i128_accum_mul(&cg, r, g1);
  519|   325k|    f->v[0] = secp256k1_i128_to_u64(&cf) & M62; secp256k1_i128_rshift(&cf, 62);
  520|   325k|    g->v[0] = secp256k1_i128_to_u64(&cg) & M62; secp256k1_i128_rshift(&cg, 62);
  521|       |    /* Compute limb 2 of t*[f,g], and store it as output limb 1. */
  522|   325k|    secp256k1_i128_accum_mul(&cf, u, f2);
  523|   325k|    secp256k1_i128_accum_mul(&cf, v, g2);
  524|   325k|    secp256k1_i128_accum_mul(&cg, q, f2);
  525|   325k|    secp256k1_i128_accum_mul(&cg, r, g2);
  526|   325k|    f->v[1] = secp256k1_i128_to_u64(&cf) & M62; secp256k1_i128_rshift(&cf, 62);
  527|   325k|    g->v[1] = secp256k1_i128_to_u64(&cg) & M62; secp256k1_i128_rshift(&cg, 62);
  528|       |    /* Compute limb 3 of t*[f,g], and store it as output limb 2. */
  529|   325k|    secp256k1_i128_accum_mul(&cf, u, f3);
  530|   325k|    secp256k1_i128_accum_mul(&cf, v, g3);
  531|   325k|    secp256k1_i128_accum_mul(&cg, q, f3);
  532|   325k|    secp256k1_i128_accum_mul(&cg, r, g3);
  533|   325k|    f->v[2] = secp256k1_i128_to_u64(&cf) & M62; secp256k1_i128_rshift(&cf, 62);
  534|   325k|    g->v[2] = secp256k1_i128_to_u64(&cg) & M62; secp256k1_i128_rshift(&cg, 62);
  535|       |    /* Compute limb 4 of t*[f,g], and store it as output limb 3. */
  536|   325k|    secp256k1_i128_accum_mul(&cf, u, f4);
  537|   325k|    secp256k1_i128_accum_mul(&cf, v, g4);
  538|   325k|    secp256k1_i128_accum_mul(&cg, q, f4);
  539|   325k|    secp256k1_i128_accum_mul(&cg, r, g4);
  540|   325k|    f->v[3] = secp256k1_i128_to_u64(&cf) & M62; secp256k1_i128_rshift(&cf, 62);
  541|   325k|    g->v[3] = secp256k1_i128_to_u64(&cg) & M62; secp256k1_i128_rshift(&cg, 62);
  542|       |    /* What remains is limb 5 of t*[f,g]; store it as output limb 4. */
  543|   325k|    f->v[4] = secp256k1_i128_to_i64(&cf);
  544|   325k|    g->v[4] = secp256k1_i128_to_i64(&cg);
  545|   325k|}
secp256k1.c:secp256k1_jacobi64_maybe_var:
  721|  35.0k|static int secp256k1_jacobi64_maybe_var(const secp256k1_modinv64_signed62 *x, const secp256k1_modinv64_modinfo *modinfo) {
  722|       |    /* Start with f=modulus, g=x, eta=-1. */
  723|  35.0k|    secp256k1_modinv64_signed62 f = modinfo->modulus;
  724|  35.0k|    secp256k1_modinv64_signed62 g = *x;
  725|  35.0k|    int j, len = 5;
  726|  35.0k|    int64_t eta = -1; /* eta = -delta; delta is initially 1 */
  727|  35.0k|    int64_t cond, fn, gn;
  728|  35.0k|    int jac = 0;
  729|  35.0k|    int count;
  730|       |
  731|       |    /* The input limbs must all be non-negative. */
  732|  35.0k|    VERIFY_CHECK(g.v[0] >= 0 && g.v[1] >= 0 && g.v[2] >= 0 && g.v[3] >= 0 && g.v[4] >= 0);
  733|       |
  734|       |    /* If x > 0, then if the loop below converges, it converges to f=g=gcd(x,modulus). Since we
  735|       |     * require that gcd(x,modulus)=1 and modulus>=3, x cannot be 0. Thus, we must reach f=1 (or
  736|       |     * time out). */
  737|  35.0k|    VERIFY_CHECK((g.v[0] | g.v[1] | g.v[2] | g.v[3] | g.v[4]) != 0);
  738|       |
  739|   444k|    for (count = 0; count < JACOBI64_ITERATIONS; ++count) {
  ------------------
  |  |  717|   444k|#define JACOBI64_ITERATIONS 25
  ------------------
  |  Branch (739:21): [True: 444k, False: 0]
  ------------------
  740|       |        /* Compute transition matrix and new eta after 62 posdivsteps. */
  741|   444k|        secp256k1_modinv64_trans2x2 t;
  742|   444k|        eta = secp256k1_modinv64_posdivsteps_62_var(eta, f.v[0] | ((uint64_t)f.v[1] << 62), g.v[0] | ((uint64_t)g.v[1] << 62), &t, &jac);
  743|       |        /* Update f,g using that transition matrix. */
  744|   444k|        VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(&f, len, &modinfo->modulus, 0) > 0); /* f > 0 */
  745|   444k|        VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(&f, len, &modinfo->modulus, 1) <= 0); /* f <= modulus */
  746|   444k|        VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(&g, len, &modinfo->modulus, 0) > 0); /* g > 0 */
  747|   444k|        VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(&g, len, &modinfo->modulus, 1) < 0);  /* g < modulus */
  748|       |
  749|   444k|        secp256k1_modinv64_update_fg_62_var(len, &f, &g, &t);
  750|       |        /* If the bottom limb of f is 1, there is a chance that f=1. */
  751|   444k|        if (f.v[0] == 1) {
  ------------------
  |  Branch (751:13): [True: 35.0k, False: 409k]
  ------------------
  752|  35.0k|            cond = 0;
  753|       |            /* Check if the other limbs are also 0. */
  754|  35.0k|            for (j = 1; j < len; ++j) {
  ------------------
  |  Branch (754:25): [True: 0, False: 35.0k]
  ------------------
  755|      0|                cond |= f.v[j];
  756|      0|            }
  757|       |            /* If so, we're done. When f=1, the Jacobi symbol (g | f)=1. */
  758|  35.0k|            if (cond == 0) return 1 - 2*(jac & 1);
  ------------------
  |  Branch (758:17): [True: 35.0k, False: 0]
  ------------------
  759|  35.0k|        }
  760|       |
  761|       |        /* Determine if len>1 and limb (len-1) of both f and g is 0. */
  762|   409k|        fn = f.v[len - 1];
  763|   409k|        gn = g.v[len - 1];
  764|   409k|        cond = ((int64_t)len - 2) >> 63;
  765|   409k|        cond |= fn;
  766|   409k|        cond |= gn;
  767|       |        /* If so, reduce length. */
  768|   409k|        if (cond == 0) --len;
  ------------------
  |  Branch (768:13): [True: 140k, False: 268k]
  ------------------
  769|       |
  770|   409k|        VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(&f, len, &modinfo->modulus, 0) > 0); /* f > 0 */
  771|   409k|        VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(&f, len, &modinfo->modulus, 1) <= 0); /* f <= modulus */
  772|   409k|        VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(&g, len, &modinfo->modulus, 0) > 0); /* g > 0 */
  773|   409k|        VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(&g, len, &modinfo->modulus, 1) < 0);  /* g < modulus */
  774|   409k|    }
  775|       |
  776|       |    /* The loop failed to converge to f=g after 1550 iterations. Return 0, indicating unknown result. */
  777|      0|    return 0;
  778|  35.0k|}
secp256k1.c:secp256k1_modinv64_posdivsteps_62_var:
  325|   444k|static int64_t secp256k1_modinv64_posdivsteps_62_var(int64_t eta, uint64_t f0, uint64_t g0, secp256k1_modinv64_trans2x2 *t, int *jacp) {
  326|       |    /* Transformation matrix; see comments in secp256k1_modinv64_divsteps_62. */
  327|   444k|    uint64_t u = 1, v = 0, q = 0, r = 1;
  328|   444k|    uint64_t f = f0, g = g0, m;
  329|   444k|    uint32_t w;
  330|   444k|    int i = 62, limit, zeros;
  331|   444k|    int jac = *jacp;
  332|       |
  333|  7.82M|    for (;;) {
  334|       |        /* Use a sentinel bit to count zeros only up to i. */
  335|  7.82M|        zeros = secp256k1_ctz64_var(g | (UINT64_MAX << i));
  336|       |        /* Perform zeros divsteps at once; they all just divide g by two. */
  337|  7.82M|        g >>= zeros;
  338|  7.82M|        u <<= zeros;
  339|  7.82M|        v <<= zeros;
  340|  7.82M|        eta -= zeros;
  341|  7.82M|        i -= zeros;
  342|       |        /* Update the bottom bit of jac: when dividing g by an odd power of 2,
  343|       |         * if (f mod 8) is 3 or 5, the Jacobi symbol changes sign. */
  344|  7.82M|        jac ^= (zeros & ((f >> 1) ^ (f >> 2)));
  345|       |        /* We're done once we've done 62 posdivsteps. */
  346|  7.82M|        if (i == 0) break;
  ------------------
  |  Branch (346:13): [True: 444k, False: 7.37M]
  ------------------
  347|  7.37M|        VERIFY_CHECK((f & 1) == 1);
  348|  7.37M|        VERIFY_CHECK((g & 1) == 1);
  349|  7.37M|        VERIFY_CHECK((u * f0 + v * g0) == f << (62 - i));
  350|  7.37M|        VERIFY_CHECK((q * f0 + r * g0) == g << (62 - i));
  351|       |        /* If eta is negative, negate it and replace f,g with g,f. */
  352|  7.37M|        if (eta < 0) {
  ------------------
  |  Branch (352:13): [True: 7.13M, False: 243k]
  ------------------
  353|  7.13M|            uint64_t tmp;
  354|  7.13M|            eta = -eta;
  355|  7.13M|            tmp = f; f = g; g = tmp;
  356|  7.13M|            tmp = u; u = q; q = tmp;
  357|  7.13M|            tmp = v; v = r; r = tmp;
  358|       |            /* Update bottom bit of jac: when swapping f and g, the Jacobi symbol changes sign
  359|       |             * if both f and g are 3 mod 4. */
  360|  7.13M|            jac ^= ((f & g) >> 1);
  361|       |            /* Use a formula to cancel out up to 6 bits of g. Also, no more than i can be cancelled
  362|       |             * out (as we'd be done before that point), and no more than eta+1 can be done as its
  363|       |             * sign will flip again once that happens. */
  364|  7.13M|            limit = ((int)eta + 1) > i ? i : ((int)eta + 1);
  ------------------
  |  Branch (364:21): [True: 138k, False: 6.99M]
  ------------------
  365|  7.13M|            VERIFY_CHECK(limit > 0 && limit <= 62);
  366|       |            /* m is a mask for the bottom min(limit, 6) bits. */
  367|  7.13M|            m = (UINT64_MAX >> (64 - limit)) & 63U;
  368|       |            /* Find what multiple of f must be added to g to cancel its bottom min(limit, 6)
  369|       |             * bits. */
  370|  7.13M|            w = (f * g * (f * f - 2)) & m;
  371|  7.13M|        } else {
