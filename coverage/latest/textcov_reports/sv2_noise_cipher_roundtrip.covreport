  239|  92.9k|static int64_t secp256k1_modinv64_divsteps_62_var(int64_t eta, uint64_t f0, uint64_t g0, secp256k1_modinv64_trans2x2 *t) {
  240|       |    /* Transformation matrix; see comments in secp256k1_modinv64_divsteps_62. */
  241|  92.9k|    uint64_t u = 1, v = 0, q = 0, r = 1;
  242|  92.9k|    uint64_t f = f0, g = g0, m;
  243|  92.9k|    uint32_t w;
  244|  92.9k|    int i = 62, limit, zeros;
  245|       |
  246|  1.52M|    for (;;) {
  247|       |        /* Use a sentinel bit to count zeros only up to i. */
  248|  1.52M|        zeros = secp256k1_ctz64_var(g | (UINT64_MAX << i));
  249|       |        /* Perform zeros divsteps at once; they all just divide g by two. */
  250|  1.52M|        g >>= zeros;
  251|  1.52M|        u <<= zeros;
  252|  1.52M|        v <<= zeros;
  253|  1.52M|        eta -= zeros;
  254|  1.52M|        i -= zeros;
  255|       |        /* We're done once we've done 62 divsteps. */
  256|  1.52M|        if (i == 0) break;
  ------------------
  |  Branch (256:13): [True: 92.9k, False: 1.42M]
  ------------------
  257|  1.42M|        VERIFY_CHECK((f & 1) == 1);
  258|  1.42M|        VERIFY_CHECK((g & 1) == 1);
  259|  1.42M|        VERIFY_CHECK((u * f0 + v * g0) == f << (62 - i));
  260|  1.42M|        VERIFY_CHECK((q * f0 + r * g0) == g << (62 - i));
  261|       |        /* Bounds on eta that follow from the bounds on iteration count (max 12*62 divsteps). */
  262|  1.42M|        VERIFY_CHECK(eta >= -745 && eta <= 745);
  263|       |        /* If eta is negative, negate it and replace f,g with g,-f. */
  264|  1.42M|        if (eta < 0) {
  ------------------
  |  Branch (264:13): [True: 1.37M, False: 50.2k]
  ------------------
  265|  1.37M|            uint64_t tmp;
  266|  1.37M|            eta = -eta;
  267|  1.37M|            tmp = f; f = g; g = -tmp;
  268|  1.37M|            tmp = u; u = q; q = -tmp;
  269|  1.37M|            tmp = v; v = r; r = -tmp;
  270|       |            /* Use a formula to cancel out up to 6 bits of g. Also, no more than i can be cancelled
  271|       |             * out (as we'd be done before that point), and no more than eta+1 can be done as its
  272|       |             * sign will flip again once that happens. */
  273|  1.37M|            limit = ((int)eta + 1) > i ? i : ((int)eta + 1);
  ------------------
