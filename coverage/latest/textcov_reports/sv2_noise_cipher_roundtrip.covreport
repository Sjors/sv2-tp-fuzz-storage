secp256k1.c:secp256k1_sha256_write:
  126|   160k|static void secp256k1_sha256_write(secp256k1_sha256 *hash, const unsigned char *data, size_t len) {
  127|   160k|    size_t bufsize = hash->bytes & 0x3F;
  128|   160k|    hash->bytes += len;
  129|   160k|    VERIFY_CHECK(hash->bytes >= len);
  130|   223k|    while (len >= 64 - bufsize) {
  ------------------
  |  Branch (130:12): [True: 62.9k, False: 160k]
  ------------------
  131|       |        /* Fill the buffer, and process it. */
  132|  62.9k|        size_t chunk_len = 64 - bufsize;
  133|  62.9k|        memcpy(hash->buf + bufsize, data, chunk_len);
  134|  62.9k|        data += chunk_len;
  135|  62.9k|        len -= chunk_len;
  136|  62.9k|        secp256k1_sha256_transform(hash->s, hash->buf);
  137|  62.9k|        bufsize = 0;
  138|  62.9k|    }
  139|   160k|    if (len) {
  ------------------
  |  Branch (139:9): [True: 97.7k, False: 62.9k]
  ------------------
  140|       |        /* Fill the buffer with what remains. */
  141|  97.7k|        memcpy(hash->buf + bufsize, data, len);
  142|  97.7k|    }
  143|   160k|}
