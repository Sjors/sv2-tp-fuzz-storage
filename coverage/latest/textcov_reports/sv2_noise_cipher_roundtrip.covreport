   18|  19.2M|SECP256K1_INLINE static void secp256k1_fe_mul_inner(uint64_t *r, const uint64_t *a, const uint64_t * SECP256K1_RESTRICT b) {
   19|  19.2M|    secp256k1_uint128 c, d;
   20|  19.2M|    uint64_t t3, t4, tx, u0;
   21|  19.2M|    uint64_t a0 = a[0], a1 = a[1], a2 = a[2], a3 = a[3], a4 = a[4];
   22|  19.2M|    const uint64_t M = 0xFFFFFFFFFFFFFULL, R = 0x1000003D10ULL;
   23|       |
   24|  19.2M|    VERIFY_BITS(a[0], 56);
   25|  19.2M|    VERIFY_BITS(a[1], 56);
   26|  19.2M|    VERIFY_BITS(a[2], 56);
   27|  19.2M|    VERIFY_BITS(a[3], 56);
   28|  19.2M|    VERIFY_BITS(a[4], 52);
   29|  19.2M|    VERIFY_BITS(b[0], 56);
   30|  19.2M|    VERIFY_BITS(b[1], 56);
   31|  19.2M|    VERIFY_BITS(b[2], 56);
   32|  19.2M|    VERIFY_BITS(b[3], 56);
   33|  19.2M|    VERIFY_BITS(b[4], 52);
