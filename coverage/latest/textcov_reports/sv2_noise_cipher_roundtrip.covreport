  ------------------
  347|  8.19M|        VERIFY_CHECK((f & 1) == 1);
  348|  8.19M|        VERIFY_CHECK((g & 1) == 1);
  349|  8.19M|        VERIFY_CHECK((u * f0 + v * g0) == f << (62 - i));
  350|  8.19M|        VERIFY_CHECK((q * f0 + r * g0) == g << (62 - i));
  351|       |        /* If eta is negative, negate it and replace f,g with g,f. */
  352|  8.19M|        if (eta < 0) {
  ------------------
  |  Branch (352:13): [True: 7.92M, False: 268k]
  ------------------
  353|  7.92M|            uint64_t tmp;
  354|  7.92M|            eta = -eta;
  355|  7.92M|            tmp = f; f = g; g = tmp;
  356|  7.92M|            tmp = u; u = q; q = tmp;
  357|  7.92M|            tmp = v; v = r; r = tmp;
  358|       |            /* Update bottom bit of jac: when swapping f and g, the Jacobi symbol changes sign
  359|       |             * if both f and g are 3 mod 4. */
