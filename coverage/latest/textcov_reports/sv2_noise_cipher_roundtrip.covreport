  653|  79.1k|        secp256k1_modinv64_trans2x2 t;
  654|  79.1k|        eta = secp256k1_modinv64_divsteps_62_var(eta, f.v[0], g.v[0], &t);
  655|       |        /* Update d,e using that transition matrix. */
  656|  79.1k|        secp256k1_modinv64_update_de_62(&d, &e, &t, modinfo);
  657|       |        /* Update f,g using that transition matrix. */
  658|  79.1k|        VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(&f, len, &modinfo->modulus, -1) > 0); /* f > -modulus */
  659|  79.1k|        VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(&f, len, &modinfo->modulus, 1) <= 0); /* f <= modulus */
  660|  79.1k|        VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(&g, len, &modinfo->modulus, -1) > 0); /* g > -modulus */
  661|  79.1k|        VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(&g, len, &modinfo->modulus, 1) < 0);  /* g <  modulus */
  662|       |
  663|  79.1k|        secp256k1_modinv64_update_fg_62_var(len, &f, &g, &t);
  664|       |        /* If the bottom limb of g is zero, there is a chance that g=0. */
  665|  79.1k|        if (g.v[0] == 0) {
  ------------------
  |  Branch (665:13): [True: 8.79k, False: 70.3k]
  ------------------
  666|  8.79k|            cond = 0;
  667|       |            /* Check if the other limbs are also 0. */
  668|  8.79k|            for (j = 1; j < len; ++j) {
  ------------------
  |  Branch (668:25): [True: 0, False: 8.79k]
  ------------------
  669|      0|                cond |= g.v[j];
  670|      0|            }
  671|       |            /* If so, we're done. */
  672|  8.79k|            if (cond == 0) break;
  ------------------
  |  Branch (672:17): [True: 8.79k, False: 0]
  ------------------
  673|  8.79k|        }
  674|       |
  675|       |        /* Determine if len>1 and limb (len-1) of both f and g is 0 or -1. */
  676|  70.3k|        fn = f.v[len - 1];
  677|  70.3k|        gn = g.v[len - 1];
  678|  70.3k|        cond = ((int64_t)len - 2) >> 63;
  679|  70.3k|        cond |= fn ^ (fn >> 63);
  680|  70.3k|        cond |= gn ^ (gn >> 63);
