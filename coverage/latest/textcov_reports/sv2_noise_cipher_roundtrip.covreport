secp256k1.c:secp256k1_fe_impl_half:
  363|  2.86M|static SECP256K1_INLINE void secp256k1_fe_impl_half(secp256k1_fe *r) {
  364|  2.86M|    uint64_t t0 = r->n[0], t1 = r->n[1], t2 = r->n[2], t3 = r->n[3], t4 = r->n[4];
  365|  2.86M|    uint64_t one = (uint64_t)1;
  366|  2.86M|    uint64_t mask = -(t0 & one) >> 12;
  367|       |
  368|       |    /* Bounds analysis (over the rationals).
  369|       |     *
  370|       |     * Let m = r->magnitude
  371|       |     *     C = 0xFFFFFFFFFFFFFULL * 2
  372|       |     *     D = 0x0FFFFFFFFFFFFULL * 2
  373|       |     *
  374|       |     * Initial bounds: t0..t3 <= C * m
  375|       |     *                     t4 <= D * m
  376|       |     */
  377|       |
  378|  2.86M|    t0 += 0xFFFFEFFFFFC2FULL & mask;
  379|  2.86M|    t1 += mask;
  380|  2.86M|    t2 += mask;
  381|  2.86M|    t3 += mask;
  382|  2.86M|    t4 += mask >> 4;
  383|       |
  384|  2.86M|    VERIFY_CHECK((t0 & one) == 0);
  385|       |
  386|       |    /* t0..t3: added <= C/2
  387|       |     *     t4: added <= D/2
  388|       |     *
  389|       |     * Current bounds: t0..t3 <= C * (m + 1/2)
  390|       |     *                     t4 <= D * (m + 1/2)
  391|       |     */
  392|       |
  393|  2.86M|    r->n[0] = (t0 >> 1) + ((t1 & one) << 51);
  394|  2.86M|    r->n[1] = (t1 >> 1) + ((t2 & one) << 51);
  395|  2.86M|    r->n[2] = (t2 >> 1) + ((t3 & one) << 51);
  396|  2.86M|    r->n[3] = (t3 >> 1) + ((t4 & one) << 51);
  397|  2.86M|    r->n[4] = (t4 >> 1);
  398|       |
  399|       |    /* t0..t3: shifted right and added <= C/4 + 1/2
  400|       |     *     t4: shifted right
  401|       |     *
  402|       |     * Current bounds: t0..t3 <= C * (m/2 + 1/2)
  403|       |     *                     t4 <= D * (m/2 + 1/4)
  404|       |     *
  405|       |     * Therefore the output magnitude (M) has to be set such that:
  406|       |     *     t0..t3: C * M >= C * (m/2 + 1/2)
  407|       |     *         t4: D * M >= D * (m/2 + 1/4)
  408|       |     *
  409|       |     * It suffices for all limbs that, for any input magnitude m:
  410|       |     *     M >= m/2 + 1/2
  411|       |     *
  412|       |     * and since we want the smallest such integer value for M:
  413|       |     *     M == floor(m/2) + 1
  414|       |     */
  415|  2.86M|}
secp256k1.c:secp256k1_fe_impl_normalize_weak:
   80|  50.8k|static void secp256k1_fe_impl_normalize_weak(secp256k1_fe *r) {
   81|  50.8k|    uint64_t t0 = r->n[0], t1 = r->n[1], t2 = r->n[2], t3 = r->n[3], t4 = r->n[4];
   82|       |
   83|       |    /* Reduce t4 at the start so there will be at most a single carry from the first pass */
   84|  50.8k|    uint64_t x = t4 >> 48; t4 &= 0x0FFFFFFFFFFFFULL;
   85|       |
   86|       |    /* The first pass ensures the magnitude is 1, ... */
   87|  50.8k|    t0 += x * 0x1000003D1ULL;
   88|  50.8k|    t1 += (t0 >> 52); t0 &= 0xFFFFFFFFFFFFFULL;
   89|  50.8k|    t2 += (t1 >> 52); t1 &= 0xFFFFFFFFFFFFFULL;
   90|  50.8k|    t3 += (t2 >> 52); t2 &= 0xFFFFFFFFFFFFFULL;
   91|  50.8k|    t4 += (t3 >> 52); t3 &= 0xFFFFFFFFFFFFFULL;
