  380|   312k|            m = (UINT64_MAX >> (64 - limit)) & 15U;
  381|       |            /* Find what multiple of f must be added to g to cancel its bottom min(limit, 4)
  382|       |             * bits. */
  383|   312k|            w = f + (((f + 1) & 4) << 1);
