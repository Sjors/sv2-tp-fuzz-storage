  268|  1.53M|            uint64_t tmp;
  269|  1.53M|            eta = -eta;
  270|  1.53M|            tmp = f; f = g; g = -tmp;
  271|  1.53M|            tmp = u; u = q; q = -tmp;
  272|  1.53M|            tmp = v; v = r; r = -tmp;
  273|       |            /* Use a formula to cancel out up to 6 bits of g. Also, no more than i can be cancelled
  274|       |             * out (as we'd be done before that point), and no more than eta+1 can be done as its
  275|       |             * sign will flip again once that happens. */
  276|  1.53M|            limit = ((int)eta + 1) > i ? i : ((int)eta + 1);
  ------------------
  |  Branch (276:21): [True: 30.3k, False: 1.49M]
  ------------------
  277|  1.53M|            VERIFY_CHECK(limit > 0 && limit <= 62);
  278|       |            /* m is a mask for the bottom min(limit, 6) bits. */
  279|  1.53M|            m = (UINT64_MAX >> (64 - limit)) & 63U;
  280|       |            /* Find what multiple of f must be added to g to cancel its bottom min(limit, 6)
  281|       |             * bits. */
