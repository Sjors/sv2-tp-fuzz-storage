  239|  27.2k|static int64_t secp256k1_modinv64_divsteps_62_var(int64_t eta, uint64_t f0, uint64_t g0, secp256k1_modinv64_trans2x2 *t) {
  240|       |    /* Transformation matrix; see comments in secp256k1_modinv64_divsteps_62. */
  241|  27.2k|    uint64_t u = 1, v = 0, q = 0, r = 1;
  242|  27.2k|    uint64_t f = f0, g = g0, m;
  243|  27.2k|    uint32_t w;
  244|  27.2k|    int i = 62, limit, zeros;
  245|       |
  246|   444k|    for (;;) {
  247|       |        /* Use a sentinel bit to count zeros only up to i. */
  248|   444k|        zeros = secp256k1_ctz64_var(g | (UINT64_MAX << i));
  249|       |        /* Perform zeros divsteps at once; they all just divide g by two. */
  250|   444k|        g >>= zeros;
  251|   444k|        u <<= zeros;
  252|   444k|        v <<= zeros;
  253|   444k|        eta -= zeros;
  254|   444k|        i -= zeros;
  255|       |        /* We're done once we've done 62 divsteps. */
  256|   444k|        if (i == 0) break;
  ------------------
  |  Branch (256:13): [True: 27.2k, False: 417k]
  ------------------
  257|   417k|        VERIFY_CHECK((f & 1) == 1);
  258|   417k|        VERIFY_CHECK((g & 1) == 1);
  259|   417k|        VERIFY_CHECK((u * f0 + v * g0) == f << (62 - i));
  260|   417k|        VERIFY_CHECK((q * f0 + r * g0) == g << (62 - i));
  261|       |        /* Bounds on eta that follow from the bounds on iteration count (max 12*62 divsteps). */
  262|   417k|        VERIFY_CHECK(eta >= -745 && eta <= 745);
  263|       |        /* If eta is negative, negate it and replace f,g with g,-f. */
  264|   417k|        if (eta < 0) {
  ------------------
  |  Branch (264:13): [True: 403k, False: 14.4k]
  ------------------
  265|   403k|            uint64_t tmp;
  266|   403k|            eta = -eta;
  267|   403k|            tmp = f; f = g; g = -tmp;
  268|   403k|            tmp = u; u = q; q = -tmp;
  269|   403k|            tmp = v; v = r; r = -tmp;
  270|       |            /* Use a formula to cancel out up to 6 bits of g. Also, no more than i can be cancelled
  271|       |             * out (as we'd be done before that point), and no more than eta+1 can be done as its
  272|       |             * sign will flip again once that happens. */
  273|   403k|            limit = ((int)eta + 1) > i ? i : ((int)eta + 1);
  ------------------
  |  Branch (273:21): [True: 8.07k, False: 395k]
  ------------------
  274|   403k|            VERIFY_CHECK(limit > 0 && limit <= 62);
  275|       |            /* m is a mask for the bottom min(limit, 6) bits. */
  276|   403k|            m = (UINT64_MAX >> (64 - limit)) & 63U;
  277|       |            /* Find what multiple of f must be added to g to cancel its bottom min(limit, 6)
  278|       |             * bits. */
  279|   403k|            w = (f * g * (f * f - 2)) & m;
  280|   403k|        } else {
  281|       |            /* In this branch, use a simpler formula that only lets us cancel up to 4 bits of g, as
  282|       |             * eta tends to be smaller here. */
  283|  14.4k|            limit = ((int)eta + 1) > i ? i : ((int)eta + 1);
  ------------------
  |  Branch (283:21): [True: 110, False: 14.3k]
  ------------------
  284|  14.4k|            VERIFY_CHECK(limit > 0 && limit <= 62);
  285|       |            /* m is a mask for the bottom min(limit, 4) bits. */
  286|  14.4k|            m = (UINT64_MAX >> (64 - limit)) & 15U;
  287|       |            /* Find what multiple of f must be added to g to cancel its bottom min(limit, 4)
  288|       |             * bits. */
  289|  14.4k|            w = f + (((f + 1) & 4) << 1);
  290|  14.4k|            w = (-w * g) & m;
  291|  14.4k|        }
  292|   417k|        g += f * w;
  293|   417k|        q += u * w;
  294|   417k|        r += v * w;
  295|   417k|        VERIFY_CHECK((g & m) == 0);
  296|   417k|    }
  297|       |    /* Return data in t and return value. */
  298|  27.2k|    t->u = (int64_t)u;
  299|  27.2k|    t->v = (int64_t)v;
  300|  27.2k|    t->q = (int64_t)q;
  301|  27.2k|    t->r = (int64_t)r;
  302|       |
  303|       |    /* The determinant of t must be a power of two. This guarantees that multiplication with t
  304|       |     * does not change the gcd of f and g, apart from adding a power-of-2 factor to it (which
  305|       |     * will be divided out again). As each divstep's individual matrix has determinant 2, the
  306|       |     * aggregate of 62 of them will have determinant 2^62. */
  307|  27.2k|    VERIFY_CHECK(secp256k1_modinv64_det_check_pow2(t, 62, 0));
  308|       |
  309|  27.2k|    return eta;
  310|  27.2k|}
