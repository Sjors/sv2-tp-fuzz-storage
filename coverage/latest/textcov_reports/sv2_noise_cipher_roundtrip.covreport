  522|  5.10k|    secp256k1_sha256_write(hash_ctx, &sha, x32, 32);
  523|  5.10k|    secp256k1_sha256_finalize(hash_ctx, &sha, output);
  524|  5.10k|    secp256k1_sha256_clear(&sha);
