  243|  43.5k|static void secp256k1_sha256_finalize(const secp256k1_hash_ctx *hash_ctx, secp256k1_sha256 *hash, unsigned char *out32) {
  244|  43.5k|    static const unsigned char pad[64] = {0x80};
  245|  43.5k|    unsigned char sizedesc[8];
  246|  43.5k|    int i;
  247|       |    /* The maximum message size of SHA256 is 2^64-1 bits. */
  248|  43.5k|    VERIFY_CHECK(hash->bytes < ((uint64_t)1 << 61));
  249|  43.5k|    secp256k1_write_be32(&sizedesc[0], hash->bytes >> 29);
  250|  43.5k|    secp256k1_write_be32(&sizedesc[4], hash->bytes << 3);
  251|  43.5k|    secp256k1_sha256_write(hash_ctx, hash, pad, 1 + ((119 - (hash->bytes % 64)) % 64));
  252|  43.5k|    secp256k1_sha256_write(hash_ctx, hash, sizedesc, 8);
  253|   391k|    for (i = 0; i < 8; i++) {
  ------------------
  |  Branch (253:17): [True: 348k, False: 43.5k]
  ------------------
  254|   348k|        secp256k1_write_be32(&out32[4*i], hash->s[i]);
  255|   348k|        hash->s[i] = 0;
  256|   348k|    }
  257|  43.5k|}
