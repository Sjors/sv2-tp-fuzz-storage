  893|  16.9k|SECP256K1_INLINE static void secp256k1_scalar_mul_shift_var(secp256k1_scalar *r, const secp256k1_scalar *a, const secp256k1_scalar *b, unsigned int shift) {
  894|  16.9k|    uint64_t l[8];
  895|  16.9k|    unsigned int shiftlimbs;
  896|  16.9k|    unsigned int shiftlow;
  897|  16.9k|    unsigned int shifthigh;
