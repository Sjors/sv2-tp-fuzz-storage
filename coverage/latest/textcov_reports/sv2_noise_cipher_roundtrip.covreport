   18|  16.1M|SECP256K1_FORCE_INLINE static void secp256k1_fe_mul_inner(uint64_t *r, const uint64_t *a, const uint64_t * SECP256K1_RESTRICT b) {
   19|  16.1M|    secp256k1_uint128 c, d;
   20|  16.1M|    uint64_t t3, t4, tx, u0;
   21|  16.1M|    uint64_t a0 = a[0], a1 = a[1], a2 = a[2], a3 = a[3], a4 = a[4];
   22|  16.1M|    const uint64_t M = 0xFFFFFFFFFFFFFULL, R = 0x1000003D10ULL;
   23|       |
   24|  16.1M|    VERIFY_BITS(a[0], 56);
