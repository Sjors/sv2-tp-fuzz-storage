  145|  11.9k|static void secp256k1_sha256_finalize(secp256k1_sha256 *hash, unsigned char *out32) {
  146|  11.9k|    static const unsigned char pad[64] = {0x80};
  147|  11.9k|    unsigned char sizedesc[8];
  148|  11.9k|    int i;
  149|       |    /* The maximum message size of SHA256 is 2^64-1 bits. */
  150|  11.9k|    VERIFY_CHECK(hash->bytes < ((uint64_t)1 << 61));
  151|  11.9k|    secp256k1_write_be32(&sizedesc[0], hash->bytes >> 29);
  152|  11.9k|    secp256k1_write_be32(&sizedesc[4], hash->bytes << 3);
  153|  11.9k|    secp256k1_sha256_write(hash, pad, 1 + ((119 - (hash->bytes % 64)) % 64));
  154|  11.9k|    secp256k1_sha256_write(hash, sizedesc, 8);
  155|   107k|    for (i = 0; i < 8; i++) {
  ------------------
  |  Branch (155:17): [True: 95.6k, False: 11.9k]
  ------------------
  156|  95.6k|        secp256k1_write_be32(&out32[4*i], hash->s[i]);
  157|  95.6k|        hash->s[i] = 0;
  158|  95.6k|    }
  159|  11.9k|}
secp256k1.c:secp256k1_sha256_clear:
  174|  1.92k|static void secp256k1_sha256_clear(secp256k1_sha256 *hash) {
  175|  1.92k|    secp256k1_memclear_explicit(hash, sizeof(*hash));
  176|  1.92k|}

