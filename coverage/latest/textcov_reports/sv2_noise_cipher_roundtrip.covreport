secp256k1.c:secp256k1_fe_impl_inv:
  481|  10.7k|static void secp256k1_fe_impl_inv(secp256k1_fe *r, const secp256k1_fe *x) {
  482|  10.7k|    secp256k1_fe tmp = *x;
  483|  10.7k|    secp256k1_modinv64_signed62 s;
  484|       |
  485|  10.7k|    secp256k1_fe_normalize(&tmp);
  ------------------
  |  |   78|  10.7k|#  define secp256k1_fe_normalize secp256k1_fe_impl_normalize
  ------------------
  486|  10.7k|    secp256k1_fe_to_signed62(&s, &tmp);
  487|  10.7k|    secp256k1_modinv64(&s, &secp256k1_const_modinfo_fe);
