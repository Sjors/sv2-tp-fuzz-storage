  266|  4.95M|    VERIFY_BITS(r[3], 52);
  267|  4.95M|    VERIFY_BITS_128(&c, 48);
  268|       |    /* [t4+c r3 r2 r1 r0] = [p8 p7 p6 p5 p4 p3 p2 p1 p0] */
