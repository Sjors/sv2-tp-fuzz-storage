  |  |   23|   176k|#define SECP256K1_N_C_1 (~SECP256K1_N_1)
  |  |  ------------------
  |  |  |  |   17|   176k|#define SECP256K1_N_1 ((uint64_t)0xBAAEDCE6AF48A03BULL)
  |  |  ------------------
  ------------------
   85|   176k|    r->d[1] = secp256k1_u128_to_u64(&t); secp256k1_u128_rshift(&t, 64);
   86|   176k|    secp256k1_u128_accum_u64(&t, r->d[2]);
   87|   176k|    secp256k1_u128_accum_u64(&t, overflow * SECP256K1_N_C_2);
  ------------------
  |  |   24|   176k|#define SECP256K1_N_C_2 (1)
  ------------------
   88|   176k|    r->d[2] = secp256k1_u128_to_u64(&t); secp256k1_u128_rshift(&t, 64);
   89|   176k|    secp256k1_u128_accum_u64(&t, r->d[3]);
   90|   176k|    r->d[3] = secp256k1_u128_to_u64(&t);
