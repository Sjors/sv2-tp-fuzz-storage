secp256k1.c:secp256k1_sha256_initialize_midstate:
   43|  17.8k|static void secp256k1_sha256_initialize_midstate(secp256k1_sha256 *hash, uint64_t bytes, const uint32_t state[8]) {
   44|  17.8k|    VERIFY_CHECK((bytes & 0x3F) == 0);
   45|  17.8k|    VERIFY_CHECK(state != NULL);
   46|  17.8k|    memcpy(hash->s, state, sizeof(hash->s));
   47|  17.8k|    hash->bytes = bytes;
   48|  17.8k|}

