  242|   103k|static int64_t secp256k1_modinv64_divsteps_62_var(int64_t eta, uint64_t f0, uint64_t g0, secp256k1_modinv64_trans2x2 *t) {
  243|       |    /* Transformation matrix; see comments in secp256k1_modinv64_divsteps_62. */
  244|   103k|    uint64_t u = 1, v = 0, q = 0, r = 1;
