  724|  45.1k|static int secp256k1_jacobi64_maybe_var(const secp256k1_modinv64_signed62 *x, const secp256k1_modinv64_modinfo *modinfo) {
  725|       |    /* Start with f=modulus, g=x, eta=-1. */
  726|  45.1k|    secp256k1_modinv64_signed62 f = modinfo->modulus;
  727|  45.1k|    secp256k1_modinv64_signed62 g = *x;
  728|  45.1k|    int j, len = 5;
  729|  45.1k|    int64_t eta = -1; /* eta = -delta; delta is initially 1 */
  730|  45.1k|    int64_t cond, fn, gn;
  731|  45.1k|    int jac = 0;
  732|  45.1k|    int count;
  733|       |
  734|       |    /* The input limbs must all be non-negative. */
  735|  45.1k|    VERIFY_CHECK(g.v[0] >= 0 && g.v[1] >= 0 && g.v[2] >= 0 && g.v[3] >= 0 && g.v[4] >= 0);
  736|       |
  737|       |    /* If x > 0, then if the loop below converges, it converges to f=g=gcd(x,modulus). Since we
  738|       |     * require that gcd(x,modulus)=1 and modulus>=3, x cannot be 0. Thus, we must reach f=1 (or
  739|       |     * time out). */
  740|  45.1k|    VERIFY_CHECK((g.v[0] | g.v[1] | g.v[2] | g.v[3] | g.v[4]) != 0);
  741|       |
  742|   571k|    for (count = 0; count < JACOBI64_ITERATIONS; ++count) {
  ------------------
  |  |  720|   571k|#define JACOBI64_ITERATIONS 25
  ------------------
  |  Branch (742:21): [True: 571k, False: 0]
  ------------------
  743|       |        /* Compute transition matrix and new eta after 62 posdivsteps. */
  744|   571k|        secp256k1_modinv64_trans2x2 t;
