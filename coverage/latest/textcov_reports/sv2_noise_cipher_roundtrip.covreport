secp256k1.c:secp256k1_fe_to_signed62:
  465|  26.4k|static void secp256k1_fe_to_signed62(secp256k1_modinv64_signed62 *r, const secp256k1_fe *a) {
  466|  26.4k|    const uint64_t M62 = UINT64_MAX >> 2;
  467|  26.4k|    const uint64_t a0 = a->n[0], a1 = a->n[1], a2 = a->n[2], a3 = a->n[3], a4 = a->n[4];
  468|       |
  469|  26.4k|    r->v[0] = (a0       | a1 << 52) & M62;
  470|  26.4k|    r->v[1] = (a1 >> 10 | a2 << 42) & M62;
  471|  26.4k|    r->v[2] = (a2 >> 20 | a3 << 32) & M62;
  472|  26.4k|    r->v[3] = (a3 >> 30 | a4 << 22) & M62;
  473|  26.4k|    r->v[4] =  a4 >> 40;
  474|  26.4k|}
secp256k1.c:secp256k1_fe_from_signed62:
  445|  13.7k|static void secp256k1_fe_from_signed62(secp256k1_fe *r, const secp256k1_modinv64_signed62 *a) {
  446|  13.7k|    const uint64_t M52 = UINT64_MAX >> 12;
  447|  13.7k|    const uint64_t a0 = a->v[0], a1 = a->v[1], a2 = a->v[2], a3 = a->v[3], a4 = a->v[4];
  448|       |
  449|       |    /* The output from secp256k1_modinv64{_var} should be normalized to range [0,modulus), and
  450|       |     * have limbs in [0,2^62). The modulus is < 2^256, so the top limb must be below 2^(256-62*4).
  451|       |     */
  452|  13.7k|    VERIFY_CHECK(a0 >> 62 == 0);
  453|  13.7k|    VERIFY_CHECK(a1 >> 62 == 0);
  454|  13.7k|    VERIFY_CHECK(a2 >> 62 == 0);
  455|  13.7k|    VERIFY_CHECK(a3 >> 62 == 0);
  456|  13.7k|    VERIFY_CHECK(a4 >> 8 == 0);
  457|       |
  458|  13.7k|    r->n[0] =  a0                   & M52;
  459|  13.7k|    r->n[1] = (a0 >> 52 | a1 << 10) & M52;
  460|  13.7k|    r->n[2] = (a1 >> 42 | a2 << 20) & M52;
  461|  13.7k|    r->n[3] = (a2 >> 32 | a3 << 30) & M52;
  462|  13.7k|    r->n[4] = (a3 >> 22 | a4 << 40);
  463|  13.7k|}
secp256k1.c:secp256k1_fe_impl_set_b32_limit:
  265|  1.82k|static int secp256k1_fe_impl_set_b32_limit(secp256k1_fe *r, const unsigned char *a) {
  266|  1.82k|    secp256k1_fe_impl_set_b32_mod(r, a);
  267|  1.82k|    return !((r->n[4] == 0x0FFFFFFFFFFFFULL) & ((r->n[3] & r->n[2] & r->n[1]) == 0xFFFFFFFFFFFFFULL) & (r->n[0] >= 0xFFFFEFFFFFC2FULL));
  268|  1.82k|}
secp256k1.c:secp256k1_fe_impl_get_b32:
  271|  12.2k|static void secp256k1_fe_impl_get_b32(unsigned char *r, const secp256k1_fe *a) {
  272|  12.2k|    r[0] = (a->n[4] >> 40) & 0xFF;
  273|  12.2k|    r[1] = (a->n[4] >> 32) & 0xFF;
  274|  12.2k|    r[2] = (a->n[4] >> 24) & 0xFF;
  275|  12.2k|    r[3] = (a->n[4] >> 16) & 0xFF;
  276|  12.2k|    r[4] = (a->n[4] >> 8) & 0xFF;
  277|  12.2k|    r[5] = a->n[4] & 0xFF;
  278|  12.2k|    r[6] = (a->n[3] >> 44) & 0xFF;
  279|  12.2k|    r[7] = (a->n[3] >> 36) & 0xFF;
  280|  12.2k|    r[8] = (a->n[3] >> 28) & 0xFF;
  281|  12.2k|    r[9] = (a->n[3] >> 20) & 0xFF;
  282|  12.2k|    r[10] = (a->n[3] >> 12) & 0xFF;
  283|  12.2k|    r[11] = (a->n[3] >> 4) & 0xFF;
  284|  12.2k|    r[12] = ((a->n[2] >> 48) & 0xF) | ((a->n[3] & 0xF) << 4);
  285|  12.2k|    r[13] = (a->n[2] >> 40) & 0xFF;
  286|  12.2k|    r[14] = (a->n[2] >> 32) & 0xFF;
  287|  12.2k|    r[15] = (a->n[2] >> 24) & 0xFF;
  288|  12.2k|    r[16] = (a->n[2] >> 16) & 0xFF;
  289|  12.2k|    r[17] = (a->n[2] >> 8) & 0xFF;
  290|  12.2k|    r[18] = a->n[2] & 0xFF;
  291|  12.2k|    r[19] = (a->n[1] >> 44) & 0xFF;
  292|  12.2k|    r[20] = (a->n[1] >> 36) & 0xFF;
  293|  12.2k|    r[21] = (a->n[1] >> 28) & 0xFF;
  294|  12.2k|    r[22] = (a->n[1] >> 20) & 0xFF;
  295|  12.2k|    r[23] = (a->n[1] >> 12) & 0xFF;
  296|  12.2k|    r[24] = (a->n[1] >> 4) & 0xFF;
  297|  12.2k|    r[25] = ((a->n[0] >> 48) & 0xF) | ((a->n[1] & 0xF) << 4);
  298|  12.2k|    r[26] = (a->n[0] >> 40) & 0xFF;
  299|  12.2k|    r[27] = (a->n[0] >> 32) & 0xFF;
  300|  12.2k|    r[28] = (a->n[0] >> 24) & 0xFF;
  301|  12.2k|    r[29] = (a->n[0] >> 16) & 0xFF;
  302|  12.2k|    r[30] = (a->n[0] >> 8) & 0xFF;
  303|  12.2k|    r[31] = a->n[0] & 0xFF;
  304|  12.2k|}
secp256k1.c:secp256k1_fe_impl_normalize_var:
   99|  38.9k|static void secp256k1_fe_impl_normalize_var(secp256k1_fe *r) {
  100|  38.9k|    uint64_t t0 = r->n[0], t1 = r->n[1], t2 = r->n[2], t3 = r->n[3], t4 = r->n[4];
  101|       |
  102|       |    /* Reduce t4 at the start so there will be at most a single carry from the first pass */
  103|  38.9k|    uint64_t m;
  104|  38.9k|    uint64_t x = t4 >> 48; t4 &= 0x0FFFFFFFFFFFFULL;
  105|       |
  106|       |    /* The first pass ensures the magnitude is 1, ... */
  107|  38.9k|    t0 += x * 0x1000003D1ULL;
  108|  38.9k|    t1 += (t0 >> 52); t0 &= 0xFFFFFFFFFFFFFULL;
  109|  38.9k|    t2 += (t1 >> 52); t1 &= 0xFFFFFFFFFFFFFULL; m = t1;
  110|  38.9k|    t3 += (t2 >> 52); t2 &= 0xFFFFFFFFFFFFFULL; m &= t2;
  111|  38.9k|    t4 += (t3 >> 52); t3 &= 0xFFFFFFFFFFFFFULL; m &= t3;
  112|       |
  113|       |    /* ... except for a possible carry at bit 48 of t4 (i.e. bit 256 of the field element) */
  114|  38.9k|    VERIFY_CHECK(t4 >> 49 == 0);
  115|       |
  116|       |    /* At most a single final reduction is needed; check if the value is >= the field characteristic */
  117|  38.9k|    x = (t4 >> 48) | ((t4 == 0x0FFFFFFFFFFFFULL) & (m == 0xFFFFFFFFFFFFFULL)
  118|  38.9k|        & (t0 >= 0xFFFFEFFFFFC2FULL));
  119|       |
  120|  38.9k|    if (x) {
  ------------------
  |  Branch (120:9): [True: 0, False: 38.9k]
  ------------------
  121|      0|        t0 += 0x1000003D1ULL;
  122|      0|        t1 += (t0 >> 52); t0 &= 0xFFFFFFFFFFFFFULL;
  123|      0|        t2 += (t1 >> 52); t1 &= 0xFFFFFFFFFFFFFULL;
  124|      0|        t3 += (t2 >> 52); t2 &= 0xFFFFFFFFFFFFFULL;
  125|      0|        t4 += (t3 >> 52); t3 &= 0xFFFFFFFFFFFFFULL;
  126|       |
  127|       |        /* If t4 didn't carry to bit 48 already, then it should have after any final reduction */
  128|      0|        VERIFY_CHECK(t4 >> 48 == x);
  129|       |
  130|       |        /* Mask off the possible multiple of 2^256 from the final reduction */
  131|      0|        t4 &= 0x0FFFFFFFFFFFFULL;
  132|      0|    }
  133|       |
  134|  38.9k|    r->n[0] = t0; r->n[1] = t1; r->n[2] = t2; r->n[3] = t3; r->n[4] = t4;
  135|  38.9k|}
secp256k1.c:secp256k1_fe_impl_is_odd:
  211|  14.0k|SECP256K1_INLINE static int secp256k1_fe_impl_is_odd(const secp256k1_fe *a) {
  212|  14.0k|    return a->n[0] & 1;
  213|  14.0k|}
secp256k1.c:secp256k1_fe_impl_normalizes_to_zero_var:
  160|   103k|static int secp256k1_fe_impl_normalizes_to_zero_var(const secp256k1_fe *r) {
  161|   103k|    uint64_t t0, t1, t2, t3, t4;
  162|   103k|    uint64_t z0, z1;
  163|   103k|    uint64_t x;
  164|       |
  165|   103k|    t0 = r->n[0];
  166|   103k|    t4 = r->n[4];
  167|       |
  168|       |    /* Reduce t4 at the start so there will be at most a single carry from the first pass */
  169|   103k|    x = t4 >> 48;
  170|       |
  171|       |    /* The first pass ensures the magnitude is 1, ... */
  172|   103k|    t0 += x * 0x1000003D1ULL;
  173|       |
  174|       |    /* z0 tracks a possible raw value of 0, z1 tracks a possible raw value of P */
  175|   103k|    z0 = t0 & 0xFFFFFFFFFFFFFULL;
  176|   103k|    z1 = z0 ^ 0x1000003D0ULL;
  177|       |
  178|       |    /* Fast return path should catch the majority of cases */
  179|   103k|    if ((z0 != 0ULL) & (z1 != 0xFFFFFFFFFFFFFULL)) {
  ------------------
  |  Branch (179:9): [True: 103k, False: 0]
  ------------------
  180|   103k|        return 0;
  181|   103k|    }
  182|       |
  183|      0|    t1 = r->n[1];
  184|      0|    t2 = r->n[2];
  185|      0|    t3 = r->n[3];
  186|       |
  187|      0|    t4 &= 0x0FFFFFFFFFFFFULL;
  188|       |
  189|      0|    t1 += (t0 >> 52);
  190|      0|    t2 += (t1 >> 52); t1 &= 0xFFFFFFFFFFFFFULL; z0 |= t1; z1 &= t1;
  191|      0|    t3 += (t2 >> 52); t2 &= 0xFFFFFFFFFFFFFULL; z0 |= t2; z1 &= t2;
  192|      0|    t4 += (t3 >> 52); t3 &= 0xFFFFFFFFFFFFFULL; z0 |= t3; z1 &= t3;
  193|      0|                                                z0 |= t4; z1 &= t4 ^ 0xF000000000000ULL;
  194|       |
  195|       |    /* ... except for a possible carry at bit 48 of t4 (i.e. bit 256 of the field element) */
  196|      0|    VERIFY_CHECK(t4 >> 49 == 0);
  197|       |
  198|      0|    return (z0 == 0) | (z1 == 0xFFFFFFFFFFFFFULL);
  199|   103k|}
secp256k1.c:secp256k1_fe_impl_inv_var:
  491|  3.02k|static void secp256k1_fe_impl_inv_var(secp256k1_fe *r, const secp256k1_fe *x) {
  492|  3.02k|    secp256k1_fe tmp = *x;
