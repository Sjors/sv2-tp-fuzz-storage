  350|  9.48M|        VERIFY_CHECK((f & 1) == 1);
  351|  9.48M|        VERIFY_CHECK((g & 1) == 1);
  352|  9.48M|        VERIFY_CHECK((u * f0 + v * g0) == f << (62 - i));
  353|  9.48M|        VERIFY_CHECK((q * f0 + r * g0) == g << (62 - i));
  354|       |        /* If eta is negative, negate it and replace f,g with g,f. */
  355|  9.48M|        if (eta < 0) {
