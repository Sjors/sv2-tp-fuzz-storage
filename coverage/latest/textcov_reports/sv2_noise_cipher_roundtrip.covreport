   88|  46.3k|static void secp256k1_modinv64_normalize_62(secp256k1_modinv64_signed62 *r, int64_t sign, const secp256k1_modinv64_modinfo *modinfo) {
   89|  46.3k|    const int64_t M62 = (int64_t)(UINT64_MAX >> 2);
   90|  46.3k|    int64_t r0 = r->v[0], r1 = r->v[1], r2 = r->v[2], r3 = r->v[3], r4 = r->v[4];
   91|  46.3k|    volatile int64_t cond_add, cond_negate;
   92|       |
   93|       |#ifdef VERIFY
   94|       |    /* Verify that all limbs are in range (-2^62,2^62). */
   95|       |    int i;
   96|       |    for (i = 0; i < 5; ++i) {
   97|       |        VERIFY_CHECK(r->v[i] >= -M62);
   98|       |        VERIFY_CHECK(r->v[i] <= M62);
   99|       |    }
  100|       |    VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(r, 5, &modinfo->modulus, -2) > 0); /* r > -2*modulus */
  101|       |    VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(r, 5, &modinfo->modulus, 1) < 0); /* r < modulus */
  102|       |#endif
  103|       |
  104|       |    /* In a first step, add the modulus if the input is negative, and then negate if requested.
  105|       |     * This brings r from range (-2*modulus,modulus) to range (-modulus,modulus). As all input
  106|       |     * limbs are in range (-2^62,2^62), this cannot overflow an int64_t. Note that the right
  107|       |     * shifts below are signed sign-extending shifts (see assumptions.h for tests that that is
  108|       |     * indeed the behavior of the right shift operator). */
  109|  46.3k|    cond_add = r4 >> 63;
  110|  46.3k|    r0 += modinfo->modulus.v[0] & cond_add;
  111|  46.3k|    r1 += modinfo->modulus.v[1] & cond_add;
  112|  46.3k|    r2 += modinfo->modulus.v[2] & cond_add;
  113|  46.3k|    r3 += modinfo->modulus.v[3] & cond_add;
  114|  46.3k|    r4 += modinfo->modulus.v[4] & cond_add;
  115|  46.3k|    cond_negate = sign >> 63;
  116|  46.3k|    r0 = (r0 ^ cond_negate) - cond_negate;
  117|  46.3k|    r1 = (r1 ^ cond_negate) - cond_negate;
  118|  46.3k|    r2 = (r2 ^ cond_negate) - cond_negate;
  119|  46.3k|    r3 = (r3 ^ cond_negate) - cond_negate;
  120|  46.3k|    r4 = (r4 ^ cond_negate) - cond_negate;
  121|       |    /* Propagate the top bits, to bring limbs back to range (-2^62,2^62). */
  122|  46.3k|    r1 += r0 >> 62; r0 &= M62;
  123|  46.3k|    r2 += r1 >> 62; r1 &= M62;
  124|  46.3k|    r3 += r2 >> 62; r2 &= M62;
  125|  46.3k|    r4 += r3 >> 62; r3 &= M62;
  126|       |
  127|       |    /* In a second step add the modulus again if the result is still negative, bringing
  128|       |     * r to range [0,modulus). */
  129|  46.3k|    cond_add = r4 >> 63;
  130|  46.3k|    r0 += modinfo->modulus.v[0] & cond_add;
  131|  46.3k|    r1 += modinfo->modulus.v[1] & cond_add;
  132|  46.3k|    r2 += modinfo->modulus.v[2] & cond_add;
  133|  46.3k|    r3 += modinfo->modulus.v[3] & cond_add;
  134|  46.3k|    r4 += modinfo->modulus.v[4] & cond_add;
  135|       |    /* And propagate again. */
  136|  46.3k|    r1 += r0 >> 62; r0 &= M62;
  137|  46.3k|    r2 += r1 >> 62; r1 &= M62;
  138|  46.3k|    r3 += r2 >> 62; r2 &= M62;
  139|  46.3k|    r4 += r3 >> 62; r3 &= M62;
  140|       |
  141|  46.3k|    r->v[0] = r0;
  142|  46.3k|    r->v[1] = r1;
  143|  46.3k|    r->v[2] = r2;
  144|  46.3k|    r->v[3] = r3;
  145|  46.3k|    r->v[4] = r4;
  146|       |
  147|  46.3k|    VERIFY_CHECK(r0 >> 62 == 0);
  148|  46.3k|    VERIFY_CHECK(r1 >> 62 == 0);
  149|  46.3k|    VERIFY_CHECK(r2 >> 62 == 0);
  150|  46.3k|    VERIFY_CHECK(r3 >> 62 == 0);
  151|  46.3k|    VERIFY_CHECK(r4 >> 62 == 0);
  152|  46.3k|    VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(r, 5, &modinfo->modulus, 0) >= 0); /* r >= 0 */
  153|  46.3k|    VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(r, 5, &modinfo->modulus, 1) < 0); /* r < modulus */
  154|  46.3k|}
secp256k1.c:secp256k1_modinv64:
  588|  36.5k|static void secp256k1_modinv64(secp256k1_modinv64_signed62 *x, const secp256k1_modinv64_modinfo *modinfo) {
  589|       |    /* Start with d=0, e=1, f=modulus, g=x, zeta=-1. */
  590|  36.5k|    secp256k1_modinv64_signed62 d = {{0, 0, 0, 0, 0}};
  591|  36.5k|    secp256k1_modinv64_signed62 e = {{1, 0, 0, 0, 0}};
  592|  36.5k|    secp256k1_modinv64_signed62 f = modinfo->modulus;
  593|  36.5k|    secp256k1_modinv64_signed62 g = *x;
  594|  36.5k|    int i;
  595|  36.5k|    int64_t zeta = -1; /* zeta = -(delta+1/2); delta starts at 1/2. */
  596|       |
  597|       |    /* Do 10 iterations of 59 divsteps each = 590 divsteps. This suffices for 256-bit inputs. */
  598|   402k|    for (i = 0; i < 10; ++i) {
  ------------------
  |  Branch (598:17): [True: 365k, False: 36.5k]
  ------------------
  599|       |        /* Compute transition matrix and new zeta after 59 divsteps. */
  600|   365k|        secp256k1_modinv64_trans2x2 t;
  601|   365k|        zeta = secp256k1_modinv64_divsteps_59(zeta, f.v[0], g.v[0], &t);
  602|       |        /* Update d,e using that transition matrix. */
  603|   365k|        secp256k1_modinv64_update_de_62(&d, &e, &t, modinfo);
  604|       |        /* Update f,g using that transition matrix. */
  605|   365k|        VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(&f, 5, &modinfo->modulus, -1) > 0); /* f > -modulus */
  606|   365k|        VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(&f, 5, &modinfo->modulus, 1) <= 0); /* f <= modulus */
  607|   365k|        VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(&g, 5, &modinfo->modulus, -1) > 0); /* g > -modulus */
  608|   365k|        VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(&g, 5, &modinfo->modulus, 1) < 0);  /* g <  modulus */
  609|       |
  610|   365k|        secp256k1_modinv64_update_fg_62(&f, &g, &t);
  611|       |
  612|   365k|        VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(&f, 5, &modinfo->modulus, -1) > 0); /* f > -modulus */
  613|   365k|        VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(&f, 5, &modinfo->modulus, 1) <= 0); /* f <= modulus */
  614|   365k|        VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(&g, 5, &modinfo->modulus, -1) > 0); /* g > -modulus */
  615|   365k|        VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(&g, 5, &modinfo->modulus, 1) < 0);  /* g <  modulus */
  616|   365k|    }
  617|       |
  618|       |    /* At this point sufficient iterations have been performed that g must have reached 0
  619|       |     * and (if g was not originally 0) f must now equal +/- GCD of the initial f, g
  620|       |     * values i.e. +/- 1, and d now contains +/- the modular inverse. */
  621|       |
  622|       |    /* g == 0 */
  623|  36.5k|    VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(&g, 5, &SECP256K1_SIGNED62_ONE, 0) == 0);
  624|       |    /* |f| == 1, or (x == 0 and d == 0 and f == modulus) */
  625|  36.5k|    VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(&f, 5, &SECP256K1_SIGNED62_ONE, -1) == 0 ||
  626|  36.5k|                 secp256k1_modinv64_mul_cmp_62(&f, 5, &SECP256K1_SIGNED62_ONE, 1) == 0 ||
  627|  36.5k|                 (secp256k1_modinv64_mul_cmp_62(x, 5, &SECP256K1_SIGNED62_ONE, 0) == 0 &&
  628|  36.5k|                  secp256k1_modinv64_mul_cmp_62(&d, 5, &SECP256K1_SIGNED62_ONE, 0) == 0 &&
  629|  36.5k|                  secp256k1_modinv64_mul_cmp_62(&f, 5, &modinfo->modulus, 1) == 0));
  630|       |
  631|       |    /* Optionally negate d, normalize to [0,modulus), and return it. */
  632|  36.5k|    secp256k1_modinv64_normalize_62(&d, f.v[4], modinfo);
  633|  36.5k|    *x = d;
  634|  36.5k|}
secp256k1.c:secp256k1_modinv64_divsteps_59:
  167|   365k|static int64_t secp256k1_modinv64_divsteps_59(int64_t zeta, uint64_t f0, uint64_t g0, secp256k1_modinv64_trans2x2 *t) {
  168|       |    /* u,v,q,r are the elements of the transformation matrix being built up,
  169|       |     * starting with the identity matrix times 8 (because the caller expects
  170|       |     * a result scaled by 2^62). Semantically they are signed integers
  171|       |     * in range [-2^62,2^62], but here represented as unsigned mod 2^64. This
  172|       |     * permits left shifting (which is UB for negative numbers). The range
  173|       |     * being inside [-2^63,2^63) means that casting to signed works correctly.
  174|       |     */
  175|   365k|    uint64_t u = 8, v = 0, q = 0, r = 8;
  176|   365k|    volatile uint64_t c1, c2;
  177|   365k|    uint64_t mask1, mask2, f = f0, g = g0, x, y, z;
  178|   365k|    int i;
  179|       |
  180|  21.9M|    for (i = 3; i < 62; ++i) {
  ------------------
  |  Branch (180:17): [True: 21.5M, False: 365k]
  ------------------
  181|  21.5M|        VERIFY_CHECK((f & 1) == 1); /* f must always be odd */
  182|  21.5M|        VERIFY_CHECK((u * f0 + v * g0) == f << i);
  183|  21.5M|        VERIFY_CHECK((q * f0 + r * g0) == g << i);
  184|       |        /* Compute conditional masks for (zeta < 0) and for (g & 1). */
  185|  21.5M|        c1 = zeta >> 63;
  186|  21.5M|        mask1 = c1;
  187|  21.5M|        c2 = g & 1;
  188|  21.5M|        mask2 = -c2;
  189|       |        /* Compute x,y,z, conditionally negated versions of f,u,v. */
  190|  21.5M|        x = (f ^ mask1) - mask1;
  191|  21.5M|        y = (u ^ mask1) - mask1;
  192|  21.5M|        z = (v ^ mask1) - mask1;
  193|       |        /* Conditionally add x,y,z to g,q,r. */
  194|  21.5M|        g += x & mask2;
  195|  21.5M|        q += y & mask2;
  196|  21.5M|        r += z & mask2;
  197|       |        /* In what follows, c1 is a condition mask for (zeta < 0) and (g & 1). */
  198|  21.5M|        mask1 &= mask2;
  199|       |        /* Conditionally change zeta into -zeta-2 or zeta-1. */
  200|  21.5M|        zeta = (zeta ^ mask1) - 1;
  201|       |        /* Conditionally add g,q,r to f,u,v. */
  202|  21.5M|        f += g & mask1;
  203|  21.5M|        u += q & mask1;
  204|  21.5M|        v += r & mask1;
  205|       |        /* Shifts */
  206|  21.5M|        g >>= 1;
  207|  21.5M|        u <<= 1;
  208|  21.5M|        v <<= 1;
  209|       |        /* Bounds on zeta that follow from the bounds on iteration count (max 10*59 divsteps). */
  210|  21.5M|        VERIFY_CHECK(zeta >= -591 && zeta <= 591);
  211|  21.5M|    }
  212|       |    /* Return data in t and return value. */
  213|   365k|    t->u = (int64_t)u;
  214|   365k|    t->v = (int64_t)v;
  215|   365k|    t->q = (int64_t)q;
  216|   365k|    t->r = (int64_t)r;
  217|       |
  218|       |    /* The determinant of t must be a power of two. This guarantees that multiplication with t
  219|       |     * does not change the gcd of f and g, apart from adding a power-of-2 factor to it (which
  220|       |     * will be divided out again). As each divstep's individual matrix has determinant 2, the
  221|       |     * aggregate of 59 of them will have determinant 2^59. Multiplying with the initial
  222|       |     * 8*identity (which has determinant 2^6) means the overall outputs has determinant
  223|       |     * 2^65. */
  224|   365k|    VERIFY_CHECK(secp256k1_modinv64_det_check_pow2(t, 65, 0));
  225|       |
  226|   365k|    return zeta;
  227|   365k|}
secp256k1.c:secp256k1_modinv64_update_fg_62:
  500|   365k|static void secp256k1_modinv64_update_fg_62(secp256k1_modinv64_signed62 *f, secp256k1_modinv64_signed62 *g, const secp256k1_modinv64_trans2x2 *t) {
  501|   365k|    const uint64_t M62 = UINT64_MAX >> 2;
  502|   365k|    const int64_t f0 = f->v[0], f1 = f->v[1], f2 = f->v[2], f3 = f->v[3], f4 = f->v[4];
  503|   365k|    const int64_t g0 = g->v[0], g1 = g->v[1], g2 = g->v[2], g3 = g->v[3], g4 = g->v[4];
  504|   365k|    const int64_t u = t->u, v = t->v, q = t->q, r = t->r;
  505|   365k|    secp256k1_int128 cf, cg;
  506|       |    /* Start computing t*[f,g]. */
  507|   365k|    secp256k1_i128_mul(&cf, u, f0);
  508|   365k|    secp256k1_i128_accum_mul(&cf, v, g0);
  509|   365k|    secp256k1_i128_mul(&cg, q, f0);
  510|   365k|    secp256k1_i128_accum_mul(&cg, r, g0);
  511|       |    /* Verify that the bottom 62 bits of the result are zero, and then throw them away. */
  512|   365k|    VERIFY_CHECK((secp256k1_i128_to_u64(&cf) & M62) == 0); secp256k1_i128_rshift(&cf, 62);
  513|   365k|    VERIFY_CHECK((secp256k1_i128_to_u64(&cg) & M62) == 0); secp256k1_i128_rshift(&cg, 62);
  514|       |    /* Compute limb 1 of t*[f,g], and store it as output limb 0 (= down shift). */
  515|   365k|    secp256k1_i128_accum_mul(&cf, u, f1);
  516|   365k|    secp256k1_i128_accum_mul(&cf, v, g1);
  517|   365k|    secp256k1_i128_accum_mul(&cg, q, f1);
  518|   365k|    secp256k1_i128_accum_mul(&cg, r, g1);
  519|   365k|    f->v[0] = secp256k1_i128_to_u64(&cf) & M62; secp256k1_i128_rshift(&cf, 62);
  520|   365k|    g->v[0] = secp256k1_i128_to_u64(&cg) & M62; secp256k1_i128_rshift(&cg, 62);
  521|       |    /* Compute limb 2 of t*[f,g], and store it as output limb 1. */
  522|   365k|    secp256k1_i128_accum_mul(&cf, u, f2);
  523|   365k|    secp256k1_i128_accum_mul(&cf, v, g2);
  524|   365k|    secp256k1_i128_accum_mul(&cg, q, f2);
  525|   365k|    secp256k1_i128_accum_mul(&cg, r, g2);
  526|   365k|    f->v[1] = secp256k1_i128_to_u64(&cf) & M62; secp256k1_i128_rshift(&cf, 62);
  527|   365k|    g->v[1] = secp256k1_i128_to_u64(&cg) & M62; secp256k1_i128_rshift(&cg, 62);
  528|       |    /* Compute limb 3 of t*[f,g], and store it as output limb 2. */
  529|   365k|    secp256k1_i128_accum_mul(&cf, u, f3);
  530|   365k|    secp256k1_i128_accum_mul(&cf, v, g3);
  531|   365k|    secp256k1_i128_accum_mul(&cg, q, f3);
  532|   365k|    secp256k1_i128_accum_mul(&cg, r, g3);
  533|   365k|    f->v[2] = secp256k1_i128_to_u64(&cf) & M62; secp256k1_i128_rshift(&cf, 62);
  534|   365k|    g->v[2] = secp256k1_i128_to_u64(&cg) & M62; secp256k1_i128_rshift(&cg, 62);
  535|       |    /* Compute limb 4 of t*[f,g], and store it as output limb 3. */
  536|   365k|    secp256k1_i128_accum_mul(&cf, u, f4);
  537|   365k|    secp256k1_i128_accum_mul(&cf, v, g4);
  538|   365k|    secp256k1_i128_accum_mul(&cg, q, f4);
  539|   365k|    secp256k1_i128_accum_mul(&cg, r, g4);
  540|   365k|    f->v[3] = secp256k1_i128_to_u64(&cf) & M62; secp256k1_i128_rshift(&cf, 62);
  541|   365k|    g->v[3] = secp256k1_i128_to_u64(&cg) & M62; secp256k1_i128_rshift(&cg, 62);
  542|       |    /* What remains is limb 5 of t*[f,g]; store it as output limb 4. */
  543|   365k|    f->v[4] = secp256k1_i128_to_i64(&cf);
  544|   365k|    g->v[4] = secp256k1_i128_to_i64(&cg);
  545|   365k|}
