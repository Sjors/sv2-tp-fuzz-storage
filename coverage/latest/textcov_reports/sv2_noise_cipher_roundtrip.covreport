   64|  16.1M|    secp256k1_u128_accum_mul(&d, a3, b[1]);
   65|  16.1M|    secp256k1_u128_accum_mul(&d, a4, b[0]);
   66|  16.1M|    VERIFY_BITS_128(&d, 115);
