   76|  2.80M|   VERIFY_CHECK(INT64_MIN <= *a && *a <= INT64_MAX);
   77|  2.80M|   return *a;
   78|  2.80M|}

secp256k1.c:secp256k1_modinv64_var:
  637|  9.80k|static void secp256k1_modinv64_var(secp256k1_modinv64_signed62 *x, const secp256k1_modinv64_modinfo *modinfo) {
  638|       |    /* Start with d=0, e=1, f=modulus, g=x, eta=-1. */
  639|  9.80k|    secp256k1_modinv64_signed62 d = {{0, 0, 0, 0, 0}};
  640|  9.80k|    secp256k1_modinv64_signed62 e = {{1, 0, 0, 0, 0}};
  641|  9.80k|    secp256k1_modinv64_signed62 f = modinfo->modulus;
  642|  9.80k|    secp256k1_modinv64_signed62 g = *x;
  643|       |#ifdef VERIFY
  644|       |    int i = 0;
  645|       |#endif
  646|  9.80k|    int j, len = 5;
  647|  9.80k|    int64_t eta = -1; /* eta = -delta; delta is initially 1 */
  648|  9.80k|    int64_t cond, fn, gn;
  649|       |
  650|       |    /* Do iterations of 62 divsteps each until g=0. */
  651|  88.2k|    while (1) {
  ------------------
  |  Branch (651:12): [True: 88.2k, Folded]
  ------------------
  652|       |        /* Compute transition matrix and new eta after 62 divsteps. */
  653|  88.2k|        secp256k1_modinv64_trans2x2 t;
  654|  88.2k|        eta = secp256k1_modinv64_divsteps_62_var(eta, f.v[0], g.v[0], &t);
  655|       |        /* Update d,e using that transition matrix. */
  656|  88.2k|        secp256k1_modinv64_update_de_62(&d, &e, &t, modinfo);
  657|       |        /* Update f,g using that transition matrix. */
  658|  88.2k|        VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(&f, len, &modinfo->modulus, -1) > 0); /* f > -modulus */
  659|  88.2k|        VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(&f, len, &modinfo->modulus, 1) <= 0); /* f <= modulus */
  660|  88.2k|        VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(&g, len, &modinfo->modulus, -1) > 0); /* g > -modulus */
  661|  88.2k|        VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(&g, len, &modinfo->modulus, 1) < 0);  /* g <  modulus */
  662|       |
  663|  88.2k|        secp256k1_modinv64_update_fg_62_var(len, &f, &g, &t);
  664|       |        /* If the bottom limb of g is zero, there is a chance that g=0. */
  665|  88.2k|        if (g.v[0] == 0) {
  ------------------
  |  Branch (665:13): [True: 9.80k, False: 78.4k]
  ------------------
  666|  9.80k|            cond = 0;
  667|       |            /* Check if the other limbs are also 0. */
  668|  9.80k|            for (j = 1; j < len; ++j) {
  ------------------
  |  Branch (668:25): [True: 0, False: 9.80k]
  ------------------
  669|      0|                cond |= g.v[j];
  670|      0|            }
  671|       |            /* If so, we're done. */
  672|  9.80k|            if (cond == 0) break;
  ------------------
  |  Branch (672:17): [True: 9.80k, False: 0]
  ------------------
  673|  9.80k|        }
  674|       |
  675|       |        /* Determine if len>1 and limb (len-1) of both f and g is 0 or -1. */
  676|  78.4k|        fn = f.v[len - 1];
  677|  78.4k|        gn = g.v[len - 1];
  678|  78.4k|        cond = ((int64_t)len - 2) >> 63;
  679|  78.4k|        cond |= fn ^ (fn >> 63);
  680|  78.4k|        cond |= gn ^ (gn >> 63);
  681|       |        /* If so, reduce length, propagating the sign of f and g's top limb into the one below. */
  682|  78.4k|        if (cond == 0) {
  ------------------
  |  Branch (682:13): [True: 39.2k, False: 39.2k]
  ------------------
  683|  39.2k|            f.v[len - 2] |= (uint64_t)fn << 62;
  684|  39.2k|            g.v[len - 2] |= (uint64_t)gn << 62;
  685|  39.2k|            --len;
  686|  39.2k|        }
  687|       |
  688|  78.4k|        VERIFY_CHECK(++i < 12); /* We should never need more than 12*62 = 744 divsteps */
  689|  78.4k|        VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(&f, len, &modinfo->modulus, -1) > 0); /* f > -modulus */
  690|  78.4k|        VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(&f, len, &modinfo->modulus, 1) <= 0); /* f <= modulus */
  691|  78.4k|        VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(&g, len, &modinfo->modulus, -1) > 0); /* g > -modulus */
  692|  78.4k|        VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(&g, len, &modinfo->modulus, 1) < 0);  /* g <  modulus */
  693|  78.4k|    }
  694|       |
  695|       |    /* At this point g is 0 and (if g was not originally 0) f must now equal +/- GCD of
  696|       |     * the initial f, g values i.e. +/- 1, and d now contains +/- the modular inverse. */
  697|       |
  698|       |    /* g == 0 */
  699|  9.80k|    VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(&g, len, &SECP256K1_SIGNED62_ONE, 0) == 0);
  700|       |    /* |f| == 1, or (x == 0 and d == 0 and f == modulus) */
  701|  9.80k|    VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(&f, len, &SECP256K1_SIGNED62_ONE, -1) == 0 ||
  702|  9.80k|                 secp256k1_modinv64_mul_cmp_62(&f, len, &SECP256K1_SIGNED62_ONE, 1) == 0 ||
