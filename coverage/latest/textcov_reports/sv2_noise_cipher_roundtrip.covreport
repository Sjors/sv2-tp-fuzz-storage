  237|  19.1M|    VERIFY_BITS_128(&c, 115);
  238|  19.1M|    VERIFY_BITS_128(&d, 62);
  239|       |    /* [d 0 0 t4 t3 0 c r0] = [p8 0 p6 p5 p4 p3 0 p1 p0] */
