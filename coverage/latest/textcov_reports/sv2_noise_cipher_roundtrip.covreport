  740|       |        /* Compute transition matrix and new eta after 62 posdivsteps. */
  741|   493k|        secp256k1_modinv64_trans2x2 t;
  742|   493k|        eta = secp256k1_modinv64_posdivsteps_62_var(eta, f.v[0] | ((uint64_t)f.v[1] << 62), g.v[0] | ((uint64_t)g.v[1] << 62), &t, &jac);
