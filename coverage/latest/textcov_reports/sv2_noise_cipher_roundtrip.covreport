  |  |   18|  52.8k|#define SECP256K1_N_2 ((uint64_t)0xFFFFFFFFFFFFFFFEULL)
  ------------------
   67|  52.8k|    yes |= (a->d[2] > SECP256K1_N_2) & ~no;
