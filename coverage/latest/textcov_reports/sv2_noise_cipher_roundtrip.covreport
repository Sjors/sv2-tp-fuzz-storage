  726|  39.3k|    "mulq %%r12\n"
  727|  39.3k|    "addq %%rax, %%r9\n"
  728|  39.3k|    "adcq %%rdx, %%r10\n"
  729|  39.3k|    "adcq $0, %%r8\n"
