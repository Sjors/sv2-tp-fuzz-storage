   44|  21.1M|    secp256k1_u128_accum_mul(&d, a1, b[2]);
   45|  21.1M|    secp256k1_u128_accum_mul(&d, a2, b[1]);
   46|  21.1M|    secp256k1_u128_accum_mul(&d, a3, b[0]);
