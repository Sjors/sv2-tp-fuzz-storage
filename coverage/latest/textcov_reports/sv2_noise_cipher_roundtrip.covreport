  640|  11.4k|static void secp256k1_modinv64_var(secp256k1_modinv64_signed62 *x, const secp256k1_modinv64_modinfo *modinfo) {
  641|       |    /* Start with d=0, e=1, f=modulus, g=x, eta=-1. */
  642|  11.4k|    secp256k1_modinv64_signed62 d = {{0, 0, 0, 0, 0}};
  643|  11.4k|    secp256k1_modinv64_signed62 e = {{1, 0, 0, 0, 0}};
  644|  11.4k|    secp256k1_modinv64_signed62 f = modinfo->modulus;
  645|  11.4k|    secp256k1_modinv64_signed62 g = *x;
  646|       |#ifdef VERIFY
  647|       |    int i = 0;
  648|       |#endif
  649|  11.4k|    int j, len = 5;
  650|  11.4k|    int64_t eta = -1; /* eta = -delta; delta is initially 1 */
  651|  11.4k|    int64_t cond, fn, gn;
  652|       |
  653|       |    /* Do iterations of 62 divsteps each until g=0. */
  654|   103k|    while (1) {
  ------------------
  |  Branch (654:12): [True: 103k, Folded]
  ------------------
  655|       |        /* Compute transition matrix and new eta after 62 divsteps. */
  656|   103k|        secp256k1_modinv64_trans2x2 t;
  657|   103k|        eta = secp256k1_modinv64_divsteps_62_var(eta, f.v[0], g.v[0], &t);
  658|       |        /* Update d,e using that transition matrix. */
  659|   103k|        secp256k1_modinv64_update_de_62(&d, &e, &t, modinfo);
  660|       |        /* Update f,g using that transition matrix. */
  661|   103k|        VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(&f, len, &modinfo->modulus, -1) > 0); /* f > -modulus */
  662|   103k|        VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(&f, len, &modinfo->modulus, 1) <= 0); /* f <= modulus */
  663|   103k|        VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(&g, len, &modinfo->modulus, -1) > 0); /* g > -modulus */
  664|   103k|        VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(&g, len, &modinfo->modulus, 1) < 0);  /* g <  modulus */
  665|       |
  666|   103k|        secp256k1_modinv64_update_fg_62_var(len, &f, &g, &t);
  667|       |        /* If the bottom limb of g is zero, there is a chance that g=0. */
  668|   103k|        if (g.v[0] == 0) {
  ------------------
  |  Branch (668:13): [True: 11.4k, False: 91.6k]
  ------------------
  669|  11.4k|            cond = 0;
  670|       |            /* Check if the other limbs are also 0. */
  671|  11.4k|            for (j = 1; j < len; ++j) {
  ------------------
  |  Branch (671:25): [True: 0, False: 11.4k]
  ------------------
  672|      0|                cond |= g.v[j];
  673|      0|            }
  674|       |            /* If so, we're done. */
  675|  11.4k|            if (cond == 0) break;
  ------------------
  |  Branch (675:17): [True: 11.4k, False: 0]
  ------------------
  676|  11.4k|        }
  677|       |
  678|       |        /* Determine if len>1 and limb (len-1) of both f and g is 0 or -1. */
  679|  91.6k|        fn = f.v[len - 1];
  680|  91.6k|        gn = g.v[len - 1];
  681|  91.6k|        cond = ((int64_t)len - 2) >> 63;
  682|  91.6k|        cond |= fn ^ (fn >> 63);
  683|  91.6k|        cond |= gn ^ (gn >> 63);
  684|       |        /* If so, reduce length, propagating the sign of f and g's top limb into the one below. */
  685|  91.6k|        if (cond == 0) {
  ------------------
  |  Branch (685:13): [True: 45.8k, False: 45.8k]
  ------------------
  686|  45.8k|            f.v[len - 2] |= (uint64_t)fn << 62;
  687|  45.8k|            g.v[len - 2] |= (uint64_t)gn << 62;
  688|  45.8k|            --len;
  689|  45.8k|        }
  690|       |
  691|  91.6k|        VERIFY_CHECK(++i < 12); /* We should never need more than 12*62 = 744 divsteps */
  692|  91.6k|        VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(&f, len, &modinfo->modulus, -1) > 0); /* f > -modulus */
  693|  91.6k|        VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(&f, len, &modinfo->modulus, 1) <= 0); /* f <= modulus */
  694|  91.6k|        VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(&g, len, &modinfo->modulus, -1) > 0); /* g > -modulus */
  695|  91.6k|        VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(&g, len, &modinfo->modulus, 1) < 0);  /* g <  modulus */
  696|  91.6k|    }
  697|       |
  698|       |    /* At this point g is 0 and (if g was not originally 0) f must now equal +/- GCD of
  699|       |     * the initial f, g values i.e. +/- 1, and d now contains +/- the modular inverse. */
  700|       |
  701|       |    /* g == 0 */
  702|  11.4k|    VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(&g, len, &SECP256K1_SIGNED62_ONE, 0) == 0);
  703|       |    /* |f| == 1, or (x == 0 and d == 0 and f == modulus) */
  704|  11.4k|    VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(&f, len, &SECP256K1_SIGNED62_ONE, -1) == 0 ||
  705|  11.4k|                 secp256k1_modinv64_mul_cmp_62(&f, len, &SECP256K1_SIGNED62_ONE, 1) == 0 ||
  706|  11.4k|                 (secp256k1_modinv64_mul_cmp_62(x, 5, &SECP256K1_SIGNED62_ONE, 0) == 0 &&
  707|  11.4k|                  secp256k1_modinv64_mul_cmp_62(&d, 5, &SECP256K1_SIGNED62_ONE, 0) == 0 &&
  708|  11.4k|                  secp256k1_modinv64_mul_cmp_62(&f, len, &modinfo->modulus, 1) == 0));
