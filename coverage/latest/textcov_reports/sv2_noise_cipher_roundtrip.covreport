  188|  19.1M|    secp256k1_u128_accum_mul(&d, a0, a4);
  189|  19.1M|    secp256k1_u128_accum_mul(&d, a1*2, a3);
  190|  19.1M|    secp256k1_u128_accum_mul(&d, a2, a2);
