  682|  43.7k|static void secp256k1_scalar_mul_512(uint64_t *l8, const secp256k1_scalar *a, const secp256k1_scalar *b) {
  683|  43.7k|#ifdef USE_ASM_X86_64
  684|  43.7k|    const uint64_t *pb = b->d;
  685|  43.7k|    __asm__ __volatile__(
  686|       |    /* Preload */
  687|  43.7k|    "movq 0(%%rdi), %%r15\n"
  688|  43.7k|    "movq 8(%%rdi), %%rbx\n"
  689|  43.7k|    "movq 16(%%rdi), %%rcx\n"
  690|  43.7k|    "movq 0(%%rdx), %%r11\n"
  691|  43.7k|    "movq 8(%%rdx), %%r12\n"
  692|  43.7k|    "movq 16(%%rdx), %%r13\n"
  693|  43.7k|    "movq 24(%%rdx), %%r14\n"
  694|       |    /* (rax,rdx) = a0 * b0 */
