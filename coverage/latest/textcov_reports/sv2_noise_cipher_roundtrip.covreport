  108|       |    /* [d 0 t4 t3 0 c r0] = [p8 0 0 p5 p4 p3 0 p1 p0] */
  109|  16.1M|    secp256k1_u128_accum_mul(&d, a2, b[4]);
  110|  16.1M|    secp256k1_u128_accum_mul(&d, a3, b[3]);
