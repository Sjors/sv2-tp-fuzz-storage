  680|  45.9k|static void secp256k1_scalar_mul_512(uint64_t *l8, const secp256k1_scalar *a, const secp256k1_scalar *b) {
  681|  45.9k|#ifdef USE_ASM_X86_64
  682|  45.9k|    const uint64_t *pb = b->d;
  683|  45.9k|    __asm__ __volatile__(
  684|       |    /* Preload */
  685|  45.9k|    "movq 0(%%rdi), %%r15\n"
  686|  45.9k|    "movq 8(%%rdi), %%rbx\n"
  687|  45.9k|    "movq 16(%%rdi), %%rcx\n"
  688|  45.9k|    "movq 0(%%rdx), %%r11\n"
  689|  45.9k|    "movq 8(%%rdx), %%r12\n"
  690|  45.9k|    "movq 16(%%rdx), %%r13\n"
  691|  45.9k|    "movq 24(%%rdx), %%r14\n"
  692|       |    /* (rax,rdx) = a0 * b0 */
  693|  45.9k|    "movq %%r15, %%rax\n"
  694|  45.9k|    "mulq %%r11\n"
  695|       |    /* Extract l8[0] */
  696|  45.9k|    "movq %%rax, 0(%%rsi)\n"
  697|       |    /* (r8,r9,r10) = (rdx) */
