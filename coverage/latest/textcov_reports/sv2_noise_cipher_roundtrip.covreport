secp256k1.c:secp256k1_fe_impl_half:
  335|  3.15M|static SECP256K1_INLINE void secp256k1_fe_impl_half(secp256k1_fe *r) {
  336|  3.15M|    uint64_t t0 = r->n[0], t1 = r->n[1], t2 = r->n[2], t3 = r->n[3], t4 = r->n[4];
  337|  3.15M|    uint64_t one = (uint64_t)1;
  338|  3.15M|    uint64_t mask = -(t0 & one) >> 12;
  339|       |
  340|       |    /* Bounds analysis (over the rationals).
  341|       |     *
  342|       |     * Let m = r->magnitude
  343|       |     *     C = 0xFFFFFFFFFFFFFULL * 2
  344|       |     *     D = 0x0FFFFFFFFFFFFULL * 2
  345|       |     *
  346|       |     * Initial bounds: t0..t3 <= C * m
  347|       |     *                     t4 <= D * m
  348|       |     */
  349|       |
  350|  3.15M|    t0 += 0xFFFFEFFFFFC2FULL & mask;
  351|  3.15M|    t1 += mask;
  352|  3.15M|    t2 += mask;
  353|  3.15M|    t3 += mask;
  354|  3.15M|    t4 += mask >> 4;
  355|       |
  356|  3.15M|    VERIFY_CHECK((t0 & one) == 0);
  357|       |
  358|       |    /* t0..t3: added <= C/2
  359|       |     *     t4: added <= D/2
  360|       |     *
  361|       |     * Current bounds: t0..t3 <= C * (m + 1/2)
  362|       |     *                     t4 <= D * (m + 1/2)
  363|       |     */
  364|       |
  365|  3.15M|    r->n[0] = (t0 >> 1) + ((t1 & one) << 51);
  366|  3.15M|    r->n[1] = (t1 >> 1) + ((t2 & one) << 51);
  367|  3.15M|    r->n[2] = (t2 >> 1) + ((t3 & one) << 51);
  368|  3.15M|    r->n[3] = (t3 >> 1) + ((t4 & one) << 51);
  369|  3.15M|    r->n[4] = (t4 >> 1);
  370|       |
  371|       |    /* t0..t3: shifted right and added <= C/4 + 1/2
  372|       |     *     t4: shifted right
  373|       |     *
  374|       |     * Current bounds: t0..t3 <= C * (m/2 + 1/2)
  375|       |     *                     t4 <= D * (m/2 + 1/4)
  376|       |     *
  377|       |     * Therefore the output magnitude (M) has to be set such that:
  378|       |     *     t0..t3: C * M >= C * (m/2 + 1/2)
  379|       |     *         t4: D * M >= D * (m/2 + 1/4)
  380|       |     *
  381|       |     * It suffices for all limbs that, for any input magnitude m:
  382|       |     *     M >= m/2 + 1/2
  383|       |     *
  384|       |     * and since we want the smallest such integer value for M:
  385|       |     *     M == floor(m/2) + 1
  386|       |     */
  387|  3.15M|}
secp256k1.c:secp256k1_fe_impl_inv:
  453|  43.0k|static void secp256k1_fe_impl_inv(secp256k1_fe *r, const secp256k1_fe *x) {
  454|  43.0k|    secp256k1_fe tmp = *x;
  455|  43.0k|    secp256k1_modinv64_signed62 s;
  456|       |
  457|  43.0k|    secp256k1_fe_normalize(&tmp);
  ------------------
  |  |   78|  43.0k|#  define secp256k1_fe_normalize secp256k1_fe_impl_normalize
  ------------------
  458|  43.0k|    secp256k1_fe_to_signed62(&s, &tmp);
  459|  43.0k|    secp256k1_modinv64(&s, &secp256k1_const_modinfo_fe);
  460|  43.0k|    secp256k1_fe_from_signed62(r, &s);
  461|  43.0k|}
secp256k1.c:secp256k1_fe_to_signed62:
  437|  99.6k|static void secp256k1_fe_to_signed62(secp256k1_modinv64_signed62 *r, const secp256k1_fe *a) {
  438|  99.6k|    const uint64_t M62 = UINT64_MAX >> 2;
  439|  99.6k|    const uint64_t a0 = a->n[0], a1 = a->n[1], a2 = a->n[2], a3 = a->n[3], a4 = a->n[4];
  440|       |
  441|  99.6k|    r->v[0] = (a0       | a1 << 52) & M62;
  442|  99.6k|    r->v[1] = (a1 >> 10 | a2 << 42) & M62;
  443|  99.6k|    r->v[2] = (a2 >> 20 | a3 << 32) & M62;
  444|  99.6k|    r->v[3] = (a3 >> 30 | a4 << 22) & M62;
  445|  99.6k|    r->v[4] =  a4 >> 40;
  446|  99.6k|}
secp256k1.c:secp256k1_fe_from_signed62:
  417|  54.5k|static void secp256k1_fe_from_signed62(secp256k1_fe *r, const secp256k1_modinv64_signed62 *a) {
  418|  54.5k|    const uint64_t M52 = UINT64_MAX >> 12;
  419|  54.5k|    const uint64_t a0 = a->v[0], a1 = a->v[1], a2 = a->v[2], a3 = a->v[3], a4 = a->v[4];
  420|       |
  421|       |    /* The output from secp256k1_modinv64{_var} should be normalized to range [0,modulus), and
  422|       |     * have limbs in [0,2^62). The modulus is < 2^256, so the top limb must be below 2^(256-62*4).
  423|       |     */
  424|  54.5k|    VERIFY_CHECK(a0 >> 62 == 0);
  425|  54.5k|    VERIFY_CHECK(a1 >> 62 == 0);
  426|  54.5k|    VERIFY_CHECK(a2 >> 62 == 0);
  427|  54.5k|    VERIFY_CHECK(a3 >> 62 == 0);
  428|  54.5k|    VERIFY_CHECK(a4 >> 8 == 0);
  429|       |
  430|  54.5k|    r->n[0] =  a0                   & M52;
  431|  54.5k|    r->n[1] = (a0 >> 52 | a1 << 10) & M52;
  432|  54.5k|    r->n[2] = (a1 >> 42 | a2 << 20) & M52;
  433|  54.5k|    r->n[3] = (a2 >> 32 | a3 << 30) & M52;
  434|  54.5k|    r->n[4] = (a3 >> 22 | a4 << 40);
  435|  54.5k|}
secp256k1.c:secp256k1_fe_impl_set_b32_limit:
  265|  6.31k|static int secp256k1_fe_impl_set_b32_limit(secp256k1_fe *r, const unsigned char *a) {
  266|  6.31k|    secp256k1_fe_impl_set_b32_mod(r, a);
  267|  6.31k|    return !((r->n[4] == 0x0FFFFFFFFFFFFULL) & ((r->n[3] & r->n[2] & r->n[1]) == 0xFFFFFFFFFFFFFULL) & (r->n[0] >= 0xFFFFEFFFFFC2FULL));
  268|  6.31k|}
secp256k1.c:secp256k1_fe_impl_get_b32:
  271|  48.2k|static void secp256k1_fe_impl_get_b32(unsigned char *r, const secp256k1_fe *a) {
  272|  48.2k|    secp256k1_write_be64(&r[0], (a->n[4] << 16) | (a->n[3] >> 36));
  273|  48.2k|    secp256k1_write_be64(&r[8], (a->n[3] << 28) | (a->n[2] >> 24));
  274|  48.2k|    secp256k1_write_be64(&r[16], (a->n[2] << 40) | (a->n[1] >> 12));
  275|  48.2k|    secp256k1_write_be64(&r[24], (a->n[1] << 52) | a->n[0]);
  276|  48.2k|}
secp256k1.c:secp256k1_fe_impl_normalize_var:
   99|   148k|static void secp256k1_fe_impl_normalize_var(secp256k1_fe *r) {
  100|   148k|    uint64_t t0 = r->n[0], t1 = r->n[1], t2 = r->n[2], t3 = r->n[3], t4 = r->n[4];
  101|       |
  102|       |    /* Reduce t4 at the start so there will be at most a single carry from the first pass */
  103|   148k|    uint64_t m;
  104|   148k|    uint64_t x = t4 >> 48; t4 &= 0x0FFFFFFFFFFFFULL;
  105|       |
  106|       |    /* The first pass ensures the magnitude is 1, ... */
  107|   148k|    t0 += x * 0x1000003D1ULL;
  108|   148k|    t1 += (t0 >> 52); t0 &= 0xFFFFFFFFFFFFFULL;
  109|   148k|    t2 += (t1 >> 52); t1 &= 0xFFFFFFFFFFFFFULL; m = t1;
  110|   148k|    t3 += (t2 >> 52); t2 &= 0xFFFFFFFFFFFFFULL; m &= t2;
  111|   148k|    t4 += (t3 >> 52); t3 &= 0xFFFFFFFFFFFFFULL; m &= t3;
  112|       |
  113|       |    /* ... except for a possible carry at bit 48 of t4 (i.e. bit 256 of the field element) */
  114|   148k|    VERIFY_CHECK(t4 >> 49 == 0);
  115|       |
  116|       |    /* At most a single final reduction is needed; check if the value is >= the field characteristic */
  117|   148k|    x = (t4 >> 48) | ((t4 == 0x0FFFFFFFFFFFFULL) & (m == 0xFFFFFFFFFFFFFULL)
  118|   148k|        & (t0 >= 0xFFFFEFFFFFC2FULL));
  119|       |
  120|   148k|    if (x) {
  ------------------
  |  Branch (120:9): [True: 0, False: 148k]
  ------------------
  121|      0|        t0 += 0x1000003D1ULL;
  122|      0|        t1 += (t0 >> 52); t0 &= 0xFFFFFFFFFFFFFULL;
  123|      0|        t2 += (t1 >> 52); t1 &= 0xFFFFFFFFFFFFFULL;
  124|      0|        t3 += (t2 >> 52); t2 &= 0xFFFFFFFFFFFFFULL;
  125|      0|        t4 += (t3 >> 52); t3 &= 0xFFFFFFFFFFFFFULL;
  126|       |
  127|       |        /* If t4 didn't carry to bit 48 already, then it should have after any final reduction */
  128|      0|        VERIFY_CHECK(t4 >> 48 == x);
  129|       |
  130|       |        /* Mask off the possible multiple of 2^256 from the final reduction */
  131|      0|        t4 &= 0x0FFFFFFFFFFFFULL;
  132|      0|    }
  133|       |
  134|   148k|    r->n[0] = t0; r->n[1] = t1; r->n[2] = t2; r->n[3] = t3; r->n[4] = t4;
  135|   148k|}
secp256k1.c:secp256k1_fe_impl_is_odd:
  211|  54.9k|SECP256K1_INLINE static int secp256k1_fe_impl_is_odd(const secp256k1_fe *a) {
  212|  54.9k|    return a->n[0] & 1;
  213|  54.9k|}
secp256k1.c:secp256k1_fe_impl_from_storage:
  409|  3.39M|static SECP256K1_INLINE void secp256k1_fe_impl_from_storage(secp256k1_fe *r, const secp256k1_fe_storage *a) {
  410|  3.39M|    r->n[0] = a->n[0] & 0xFFFFFFFFFFFFFULL;
  411|  3.39M|    r->n[1] = a->n[0] >> 52 | ((a->n[1] << 12) & 0xFFFFFFFFFFFFFULL);
  412|  3.39M|    r->n[2] = a->n[1] >> 40 | ((a->n[2] << 24) & 0xFFFFFFFFFFFFFULL);
  413|  3.39M|    r->n[3] = a->n[2] >> 28 | ((a->n[3] << 36) & 0xFFFFFFFFFFFFFULL);
  414|  3.39M|    r->n[4] = a->n[3] >> 16;
  415|  3.39M|}
secp256k1.c:secp256k1_fe_impl_normalizes_to_zero_var:
  160|   376k|static int secp256k1_fe_impl_normalizes_to_zero_var(const secp256k1_fe *r) {
  161|   376k|    uint64_t t0, t1, t2, t3, t4;
  162|   376k|    uint64_t z0, z1;
  163|   376k|    uint64_t x;
  164|       |
  165|   376k|    t0 = r->n[0];
  166|   376k|    t4 = r->n[4];
  167|       |
  168|       |    /* Reduce t4 at the start so there will be at most a single carry from the first pass */
  169|   376k|    x = t4 >> 48;
  170|       |
  171|       |    /* The first pass ensures the magnitude is 1, ... */
  172|   376k|    t0 += x * 0x1000003D1ULL;
  173|       |
  174|       |    /* z0 tracks a possible raw value of 0, z1 tracks a possible raw value of P */
  175|   376k|    z0 = t0 & 0xFFFFFFFFFFFFFULL;
  176|   376k|    z1 = z0 ^ 0x1000003D0ULL;
  177|       |
  178|       |    /* Fast return path should catch the majority of cases */
  179|   376k|    if ((z0 != 0ULL) & (z1 != 0xFFFFFFFFFFFFFULL)) {
  ------------------
  |  Branch (179:9): [True: 376k, False: 0]
  ------------------
  180|   376k|        return 0;
  181|   376k|    }
  182|       |
  183|      0|    t1 = r->n[1];
  184|      0|    t2 = r->n[2];
  185|      0|    t3 = r->n[3];
  186|       |
  187|      0|    t4 &= 0x0FFFFFFFFFFFFULL;
  188|       |
  189|      0|    t1 += (t0 >> 52);
  190|      0|    t2 += (t1 >> 52); t1 &= 0xFFFFFFFFFFFFFULL; z0 |= t1; z1 &= t1;
  191|      0|    t3 += (t2 >> 52); t2 &= 0xFFFFFFFFFFFFFULL; z0 |= t2; z1 &= t2;
  192|      0|    t4 += (t3 >> 52); t3 &= 0xFFFFFFFFFFFFFULL; z0 |= t3; z1 &= t3;
  193|      0|                                                z0 |= t4; z1 &= t4 ^ 0xF000000000000ULL;
  194|       |
  195|       |    /* ... except for a possible carry at bit 48 of t4 (i.e. bit 256 of the field element) */
  196|      0|    VERIFY_CHECK(t4 >> 49 == 0);
  197|       |
  198|      0|    return (z0 == 0) | (z1 == 0xFFFFFFFFFFFFFULL);
  199|   376k|}
secp256k1.c:secp256k1_fe_impl_inv_var:
  463|  11.4k|static void secp256k1_fe_impl_inv_var(secp256k1_fe *r, const secp256k1_fe *x) {
  464|  11.4k|    secp256k1_fe tmp = *x;
  465|  11.4k|    secp256k1_modinv64_signed62 s;
  466|       |
  467|  11.4k|    secp256k1_fe_normalize_var(&tmp);
  ------------------
  |  |   80|  11.4k|#  define secp256k1_fe_normalize_var secp256k1_fe_impl_normalize_var
  ------------------
  468|  11.4k|    secp256k1_fe_to_signed62(&s, &tmp);
  469|  11.4k|    secp256k1_modinv64_var(&s, &secp256k1_const_modinfo_fe);
  470|  11.4k|    secp256k1_fe_from_signed62(r, &s);
  471|  11.4k|}
secp256k1.c:secp256k1_fe_storage_cmov:
  389|   102M|static SECP256K1_INLINE void secp256k1_fe_storage_cmov(secp256k1_fe_storage *r, const secp256k1_fe_storage *a, int flag) {
  390|   102M|    uint64_t mask0, mask1;
  391|   102M|    volatile int vflag = flag;
  392|   102M|    VERIFY_CHECK(flag == 0 || flag == 1);
  393|   102M|    SECP256K1_CHECKMEM_CHECK_VERIFY(r->n, sizeof(r->n));
  ------------------
  |  |  114|   102M|#define SECP256K1_CHECKMEM_CHECK_VERIFY(p, len) SECP256K1_CHECKMEM_NOOP((p), (len))
  |  |  ------------------
  |  |  |  |   42|   102M|#define SECP256K1_CHECKMEM_NOOP(p, len) do { (void)(p); (void)(len); } while(0)
  |  |  |  |  ------------------
  |  |  |  |  |  Branch (42:78): [Folded, False: 102M]
  |  |  |  |  ------------------
  |  |  ------------------
  ------------------
  394|   102M|    mask0 = vflag + ~((uint64_t)0);
  395|   102M|    mask1 = ~mask0;
  396|   102M|    r->n[0] = (r->n[0] & mask0) | (a->n[0] & mask1);
  397|   102M|    r->n[1] = (r->n[1] & mask0) | (a->n[1] & mask1);
  398|   102M|    r->n[2] = (r->n[2] & mask0) | (a->n[2] & mask1);
  399|   102M|    r->n[3] = (r->n[3] & mask0) | (a->n[3] & mask1);
  400|   102M|}
secp256k1.c:secp256k1_fe_impl_is_square_var:
  473|  45.1k|static int secp256k1_fe_impl_is_square_var(const secp256k1_fe *x) {
  474|  45.1k|    secp256k1_fe tmp;
  475|  45.1k|    secp256k1_modinv64_signed62 s;
  476|  45.1k|    int jac, ret;
  477|       |
  478|  45.1k|    tmp = *x;
  479|  45.1k|    secp256k1_fe_normalize_var(&tmp);
  ------------------
  |  |   80|  45.1k|#  define secp256k1_fe_normalize_var secp256k1_fe_impl_normalize_var
  ------------------
  480|       |    /* secp256k1_jacobi64_maybe_var cannot deal with input 0. */
  481|  45.1k|    if (secp256k1_fe_is_zero(&tmp)) return 1;
  ------------------
  |  |   84|  45.1k|#  define secp256k1_fe_is_zero secp256k1_fe_impl_is_zero
  ------------------
  |  Branch (481:9): [True: 0, False: 45.1k]
  ------------------
  482|  45.1k|    secp256k1_fe_to_signed62(&s, &tmp);
  483|  45.1k|    jac = secp256k1_jacobi64_maybe_var(&s, &secp256k1_const_modinfo_fe);
  484|  45.1k|    if (jac == 0) {
  ------------------
  |  Branch (484:9): [True: 0, False: 45.1k]
  ------------------
  485|       |        /* secp256k1_jacobi64_maybe_var failed to compute the Jacobi symbol. Fall back
  486|       |         * to computing a square root. This should be extremely rare with random
  487|       |         * input (except in VERIFY mode, where a lower iteration count is used). */
  488|      0|        secp256k1_fe dummy;
  489|      0|        ret = secp256k1_fe_sqrt(&dummy, &tmp);
  490|  45.1k|    } else {
  491|  45.1k|        ret = jac >= 0;
  492|  45.1k|    }
  493|  45.1k|    return ret;
  494|  45.1k|}
secp256k1.c:secp256k1_fe_impl_set_b32_mod:
  228|  43.3k|static void secp256k1_fe_impl_set_b32_mod(secp256k1_fe *r, const unsigned char *a) {
  229|  43.3k|    r->n[0] = (uint64_t)a[31]
  230|  43.3k|            | ((uint64_t)a[30] << 8)
  231|  43.3k|            | ((uint64_t)a[29] << 16)
  232|  43.3k|            | ((uint64_t)a[28] << 24)
  233|  43.3k|            | ((uint64_t)a[27] << 32)
  234|  43.3k|            | ((uint64_t)a[26] << 40)
  235|  43.3k|            | ((uint64_t)(a[25] & 0xF)  << 48);
  236|  43.3k|    r->n[1] = (uint64_t)((a[25] >> 4) & 0xF)
  237|  43.3k|            | ((uint64_t)a[24] << 4)
  238|  43.3k|            | ((uint64_t)a[23] << 12)
  239|  43.3k|            | ((uint64_t)a[22] << 20)
  240|  43.3k|            | ((uint64_t)a[21] << 28)
  241|  43.3k|            | ((uint64_t)a[20] << 36)
  242|  43.3k|            | ((uint64_t)a[19] << 44);
  243|  43.3k|    r->n[2] = (uint64_t)a[18]
  244|  43.3k|            | ((uint64_t)a[17] << 8)
  245|  43.3k|            | ((uint64_t)a[16] << 16)
  246|  43.3k|            | ((uint64_t)a[15] << 24)
  247|  43.3k|            | ((uint64_t)a[14] << 32)
  248|  43.3k|            | ((uint64_t)a[13] << 40)
  249|  43.3k|            | ((uint64_t)(a[12] & 0xF) << 48);
  250|  43.3k|    r->n[3] = (uint64_t)((a[12] >> 4) & 0xF)
  251|  43.3k|            | ((uint64_t)a[11] << 4)
  252|  43.3k|            | ((uint64_t)a[10] << 12)
  253|  43.3k|            | ((uint64_t)a[9]  << 20)
  254|  43.3k|            | ((uint64_t)a[8]  << 28)
  255|  43.3k|            | ((uint64_t)a[7]  << 36)
  256|  43.3k|            | ((uint64_t)a[6]  << 44);
  257|  43.3k|    r->n[4] = (uint64_t)a[5]
  258|  43.3k|            | ((uint64_t)a[4] << 8)
  259|  43.3k|            | ((uint64_t)a[3] << 16)
  260|  43.3k|            | ((uint64_t)a[2] << 24)
  261|  43.3k|            | ((uint64_t)a[1] << 32)
  262|  43.3k|            | ((uint64_t)a[0] << 40);
  263|  43.3k|}
secp256k1.c:secp256k1_fe_impl_normalize:
   43|   117k|static void secp256k1_fe_impl_normalize(secp256k1_fe *r) {
   44|   117k|    uint64_t t0 = r->n[0], t1 = r->n[1], t2 = r->n[2], t3 = r->n[3], t4 = r->n[4];
   45|       |
   46|       |    /* Reduce t4 at the start so there will be at most a single carry from the first pass */
   47|   117k|    uint64_t m;
   48|   117k|    uint64_t x = t4 >> 48; t4 &= 0x0FFFFFFFFFFFFULL;
   49|       |
   50|       |    /* The first pass ensures the magnitude is 1, ... */
   51|   117k|    t0 += x * 0x1000003D1ULL;
   52|   117k|    t1 += (t0 >> 52); t0 &= 0xFFFFFFFFFFFFFULL;
   53|   117k|    t2 += (t1 >> 52); t1 &= 0xFFFFFFFFFFFFFULL; m = t1;
   54|   117k|    t3 += (t2 >> 52); t2 &= 0xFFFFFFFFFFFFFULL; m &= t2;
   55|   117k|    t4 += (t3 >> 52); t3 &= 0xFFFFFFFFFFFFFULL; m &= t3;
   56|       |
   57|       |    /* ... except for a possible carry at bit 48 of t4 (i.e. bit 256 of the field element) */
   58|   117k|    VERIFY_CHECK(t4 >> 49 == 0);
   59|       |
   60|       |    /* At most a single final reduction is needed; check if the value is >= the field characteristic */
   61|   117k|    x = (t4 >> 48) | ((t4 == 0x0FFFFFFFFFFFFULL) & (m == 0xFFFFFFFFFFFFFULL)
   62|   117k|        & (t0 >= 0xFFFFEFFFFFC2FULL));
   63|       |
   64|       |    /* Apply the final reduction (for constant-time behaviour, we do it always) */
   65|   117k|    t0 += x * 0x1000003D1ULL;
   66|   117k|    t1 += (t0 >> 52); t0 &= 0xFFFFFFFFFFFFFULL;
   67|   117k|    t2 += (t1 >> 52); t1 &= 0xFFFFFFFFFFFFFULL;
   68|   117k|    t3 += (t2 >> 52); t2 &= 0xFFFFFFFFFFFFFULL;
   69|   117k|    t4 += (t3 >> 52); t3 &= 0xFFFFFFFFFFFFFULL;
   70|       |
   71|       |    /* If t4 didn't carry to bit 48 already, then it should have after any final reduction */
   72|   117k|    VERIFY_CHECK(t4 >> 48 == x);
   73|       |
   74|       |    /* Mask off the possible multiple of 2^256 from the final reduction */
   75|   117k|    t4 &= 0x0FFFFFFFFFFFFULL;
   76|       |
   77|   117k|    r->n[0] = t0; r->n[1] = t1; r->n[2] = t2; r->n[3] = t3; r->n[4] = t4;
   78|   117k|}
secp256k1.c:secp256k1_fe_impl_to_storage:
  402|  68.8k|static void secp256k1_fe_impl_to_storage(secp256k1_fe_storage *r, const secp256k1_fe *a) {
  403|  68.8k|    r->n[0] = a->n[0] | a->n[1] << 52;
  404|  68.8k|    r->n[1] = a->n[1] >> 12 | a->n[2] << 40;
  405|  68.8k|    r->n[2] = a->n[2] >> 24 | a->n[3] << 28;
  406|  68.8k|    r->n[3] = a->n[3] >> 36 | a->n[4] << 16;
  407|  68.8k|}

secp256k1.c:secp256k1_fe_sqr_inner:
  154|  19.1M|SECP256K1_FORCE_INLINE static void secp256k1_fe_sqr_inner(uint64_t *r, const uint64_t *a) {
  155|  19.1M|    secp256k1_uint128 c, d;
  156|  19.1M|    uint64_t a0 = a[0], a1 = a[1], a2 = a[2], a3 = a[3], a4 = a[4];
  157|  19.1M|    uint64_t t3, t4, tx, u0;
  158|  19.1M|    const uint64_t M = 0xFFFFFFFFFFFFFULL, R = 0x1000003D10ULL;
  159|       |
  160|  19.1M|    VERIFY_BITS(a[0], 56);
  161|  19.1M|    VERIFY_BITS(a[1], 56);
  162|  19.1M|    VERIFY_BITS(a[2], 56);
  163|  19.1M|    VERIFY_BITS(a[3], 56);
  164|  19.1M|    VERIFY_BITS(a[4], 52);
  165|       |
  166|       |    /**  [... a b c] is a shorthand for ... + a<<104 + b<<52 + c<<0 mod n.
  167|       |     *  px is a shorthand for sum(a[i]*a[x-i], i=0..x).
  168|       |     *  Note that [x 0 0 0 0 0] = [x*R].
  169|       |     */
  170|       |
  171|  19.1M|    secp256k1_u128_mul(&d, a0*2, a3);
  172|  19.1M|    secp256k1_u128_accum_mul(&d, a1*2, a2);
  173|  19.1M|    VERIFY_BITS_128(&d, 114);
  174|       |    /* [d 0 0 0] = [p3 0 0 0] */
  175|  19.1M|    secp256k1_u128_mul(&c, a4, a4);
  176|  19.1M|    VERIFY_BITS_128(&c, 112);
  177|       |    /* [c 0 0 0 0 d 0 0 0] = [p8 0 0 0 0 p3 0 0 0] */
  178|  19.1M|    secp256k1_u128_accum_mul(&d, R, secp256k1_u128_to_u64(&c)); secp256k1_u128_rshift(&c, 64);
  179|  19.1M|    VERIFY_BITS_128(&d, 115);
  180|  19.1M|    VERIFY_BITS_128(&c, 48);
  181|       |    /* [(c<<12) 0 0 0 0 0 d 0 0 0] = [p8 0 0 0 0 p3 0 0 0] */
