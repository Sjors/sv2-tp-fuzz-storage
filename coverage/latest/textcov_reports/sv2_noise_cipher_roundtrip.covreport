  893|  15.2k|SECP256K1_INLINE static void secp256k1_scalar_mul_shift_var(secp256k1_scalar *r, const secp256k1_scalar *a, const secp256k1_scalar *b, unsigned int shift) {
  894|  15.2k|    uint64_t l[8];
  895|  15.2k|    unsigned int shiftlimbs;
  896|  15.2k|    unsigned int shiftlow;
