secp256k1.c:secp256k1_fe_storage_cmov:
  389|  77.0M|static SECP256K1_INLINE void secp256k1_fe_storage_cmov(secp256k1_fe_storage *r, const secp256k1_fe_storage *a, int flag) {
  390|  77.0M|    uint64_t mask0, mask1;
  391|  77.0M|    volatile int vflag = flag;
  392|  77.0M|    VERIFY_CHECK(flag == 0 || flag == 1);
  393|  77.0M|    SECP256K1_CHECKMEM_CHECK_VERIFY(r->n, sizeof(r->n));
  ------------------
  |  |  114|  77.0M|#define SECP256K1_CHECKMEM_CHECK_VERIFY(p, len) SECP256K1_CHECKMEM_NOOP((p), (len))
  |  |  ------------------
  |  |  |  |   42|  77.0M|#define SECP256K1_CHECKMEM_NOOP(p, len) do { (void)(p); (void)(len); } while(0)
  |  |  |  |  ------------------
  |  |  |  |  |  Branch (42:78): [Folded, False: 77.0M]
  |  |  |  |  ------------------
  |  |  ------------------
  ------------------
  394|  77.0M|    mask0 = vflag + ~((uint64_t)0);
  395|  77.0M|    mask1 = ~mask0;
  396|  77.0M|    r->n[0] = (r->n[0] & mask0) | (a->n[0] & mask1);
  397|  77.0M|    r->n[1] = (r->n[1] & mask0) | (a->n[1] & mask1);
  398|  77.0M|    r->n[2] = (r->n[2] & mask0) | (a->n[2] & mask1);
  399|  77.0M|    r->n[3] = (r->n[3] & mask0) | (a->n[3] & mask1);
  400|  77.0M|}
secp256k1.c:secp256k1_fe_impl_is_square_var:
  473|  35.0k|static int secp256k1_fe_impl_is_square_var(const secp256k1_fe *x) {
  474|  35.0k|    secp256k1_fe tmp;
  475|  35.0k|    secp256k1_modinv64_signed62 s;
  476|  35.0k|    int jac, ret;
  477|       |
  478|  35.0k|    tmp = *x;
  479|  35.0k|    secp256k1_fe_normalize_var(&tmp);
  ------------------
  |  |   80|  35.0k|#  define secp256k1_fe_normalize_var secp256k1_fe_impl_normalize_var
  ------------------
  480|       |    /* secp256k1_jacobi64_maybe_var cannot deal with input 0. */
  481|  35.0k|    if (secp256k1_fe_is_zero(&tmp)) return 1;
  ------------------
  |  |   84|  35.0k|#  define secp256k1_fe_is_zero secp256k1_fe_impl_is_zero
  ------------------
  |  Branch (481:9): [True: 0, False: 35.0k]
  ------------------
  482|  35.0k|    secp256k1_fe_to_signed62(&s, &tmp);
  483|  35.0k|    jac = secp256k1_jacobi64_maybe_var(&s, &secp256k1_const_modinfo_fe);
  484|  35.0k|    if (jac == 0) {
  ------------------
  |  Branch (484:9): [True: 0, False: 35.0k]
  ------------------
  485|       |        /* secp256k1_jacobi64_maybe_var failed to compute the Jacobi symbol. Fall back
  486|       |         * to computing a square root. This should be extremely rare with random
  487|       |         * input (except in VERIFY mode, where a lower iteration count is used). */
  488|      0|        secp256k1_fe dummy;
  489|      0|        ret = secp256k1_fe_sqrt(&dummy, &tmp);
  490|  35.0k|    } else {
  491|  35.0k|        ret = jac >= 0;
  492|  35.0k|    }
  493|  35.0k|    return ret;
  494|  35.0k|}
secp256k1.c:secp256k1_fe_impl_set_b32_mod:
  228|  33.7k|static void secp256k1_fe_impl_set_b32_mod(secp256k1_fe *r, const unsigned char *a) {
  229|  33.7k|    r->n[0] = (uint64_t)a[31]
  230|  33.7k|            | ((uint64_t)a[30] << 8)
  231|  33.7k|            | ((uint64_t)a[29] << 16)
  232|  33.7k|            | ((uint64_t)a[28] << 24)
  233|  33.7k|            | ((uint64_t)a[27] << 32)
  234|  33.7k|            | ((uint64_t)a[26] << 40)
  235|  33.7k|            | ((uint64_t)(a[25] & 0xF)  << 48);
  236|  33.7k|    r->n[1] = (uint64_t)((a[25] >> 4) & 0xF)
  237|  33.7k|            | ((uint64_t)a[24] << 4)
  238|  33.7k|            | ((uint64_t)a[23] << 12)
  239|  33.7k|            | ((uint64_t)a[22] << 20)
  240|  33.7k|            | ((uint64_t)a[21] << 28)
  241|  33.7k|            | ((uint64_t)a[20] << 36)
  242|  33.7k|            | ((uint64_t)a[19] << 44);
  243|  33.7k|    r->n[2] = (uint64_t)a[18]
  244|  33.7k|            | ((uint64_t)a[17] << 8)
  245|  33.7k|            | ((uint64_t)a[16] << 16)
  246|  33.7k|            | ((uint64_t)a[15] << 24)
  247|  33.7k|            | ((uint64_t)a[14] << 32)
  248|  33.7k|            | ((uint64_t)a[13] << 40)
  249|  33.7k|            | ((uint64_t)(a[12] & 0xF) << 48);
  250|  33.7k|    r->n[3] = (uint64_t)((a[12] >> 4) & 0xF)
  251|  33.7k|            | ((uint64_t)a[11] << 4)
  252|  33.7k|            | ((uint64_t)a[10] << 12)
  253|  33.7k|            | ((uint64_t)a[9]  << 20)
  254|  33.7k|            | ((uint64_t)a[8]  << 28)
  255|  33.7k|            | ((uint64_t)a[7]  << 36)
  256|  33.7k|            | ((uint64_t)a[6]  << 44);
  257|  33.7k|    r->n[4] = (uint64_t)a[5]
  258|  33.7k|            | ((uint64_t)a[4] << 8)
  259|  33.7k|            | ((uint64_t)a[3] << 16)
  260|  33.7k|            | ((uint64_t)a[2] << 24)
  261|  33.7k|            | ((uint64_t)a[1] << 32)
  262|  33.7k|            | ((uint64_t)a[0] << 40);
  263|  33.7k|}
secp256k1.c:secp256k1_fe_impl_normalize:
   43|  89.3k|static void secp256k1_fe_impl_normalize(secp256k1_fe *r) {
   44|  89.3k|    uint64_t t0 = r->n[0], t1 = r->n[1], t2 = r->n[2], t3 = r->n[3], t4 = r->n[4];
   45|       |
   46|       |    /* Reduce t4 at the start so there will be at most a single carry from the first pass */
   47|  89.3k|    uint64_t m;
   48|  89.3k|    uint64_t x = t4 >> 48; t4 &= 0x0FFFFFFFFFFFFULL;
   49|       |
   50|       |    /* The first pass ensures the magnitude is 1, ... */
   51|  89.3k|    t0 += x * 0x1000003D1ULL;
   52|  89.3k|    t1 += (t0 >> 52); t0 &= 0xFFFFFFFFFFFFFULL;
   53|  89.3k|    t2 += (t1 >> 52); t1 &= 0xFFFFFFFFFFFFFULL; m = t1;
   54|  89.3k|    t3 += (t2 >> 52); t2 &= 0xFFFFFFFFFFFFFULL; m &= t2;
   55|  89.3k|    t4 += (t3 >> 52); t3 &= 0xFFFFFFFFFFFFFULL; m &= t3;
   56|       |
   57|       |    /* ... except for a possible carry at bit 48 of t4 (i.e. bit 256 of the field element) */
   58|  89.3k|    VERIFY_CHECK(t4 >> 49 == 0);
   59|       |
   60|       |    /* At most a single final reduction is needed; check if the value is >= the field characteristic */
   61|  89.3k|    x = (t4 >> 48) | ((t4 == 0x0FFFFFFFFFFFFULL) & (m == 0xFFFFFFFFFFFFFULL)
   62|  89.3k|        & (t0 >= 0xFFFFEFFFFFC2FULL));
   63|       |
   64|       |    /* Apply the final reduction (for constant-time behaviour, we do it always) */
   65|  89.3k|    t0 += x * 0x1000003D1ULL;
   66|  89.3k|    t1 += (t0 >> 52); t0 &= 0xFFFFFFFFFFFFFULL;
   67|  89.3k|    t2 += (t1 >> 52); t1 &= 0xFFFFFFFFFFFFFULL;
   68|  89.3k|    t3 += (t2 >> 52); t2 &= 0xFFFFFFFFFFFFFULL;
   69|  89.3k|    t4 += (t3 >> 52); t3 &= 0xFFFFFFFFFFFFFULL;
   70|       |
   71|       |    /* If t4 didn't carry to bit 48 already, then it should have after any final reduction */
   72|  89.3k|    VERIFY_CHECK(t4 >> 48 == x);
   73|       |
   74|       |    /* Mask off the possible multiple of 2^256 from the final reduction */
   75|  89.3k|    t4 &= 0x0FFFFFFFFFFFFULL;
   76|       |
   77|  89.3k|    r->n[0] = t0; r->n[1] = t1; r->n[2] = t2; r->n[3] = t3; r->n[4] = t4;
   78|  89.3k|}
secp256k1.c:secp256k1_fe_impl_to_storage:
  402|  52.2k|static void secp256k1_fe_impl_to_storage(secp256k1_fe_storage *r, const secp256k1_fe *a) {
  403|  52.2k|    r->n[0] = a->n[0] | a->n[1] << 52;
  404|  52.2k|    r->n[1] = a->n[1] >> 12 | a->n[2] << 40;
  405|  52.2k|    r->n[2] = a->n[2] >> 24 | a->n[3] << 28;
  406|  52.2k|    r->n[3] = a->n[3] >> 36 | a->n[4] << 16;
  407|  52.2k|}

secp256k1.c:secp256k1_fe_sqr_inner:
  154|  14.6M|SECP256K1_FORCE_INLINE static void secp256k1_fe_sqr_inner(uint64_t *r, const uint64_t *a) {
  155|  14.6M|    secp256k1_uint128 c, d;
  156|  14.6M|    uint64_t a0 = a[0], a1 = a[1], a2 = a[2], a3 = a[3], a4 = a[4];
  157|  14.6M|    uint64_t t3, t4, tx, u0;
  158|  14.6M|    const uint64_t M = 0xFFFFFFFFFFFFFULL, R = 0x1000003D10ULL;
  159|       |
  160|  14.6M|    VERIFY_BITS(a[0], 56);
  161|  14.6M|    VERIFY_BITS(a[1], 56);
  162|  14.6M|    VERIFY_BITS(a[2], 56);
  163|  14.6M|    VERIFY_BITS(a[3], 56);
  164|  14.6M|    VERIFY_BITS(a[4], 52);
  165|       |
  166|       |    /**  [... a b c] is a shorthand for ... + a<<104 + b<<52 + c<<0 mod n.
  167|       |     *  px is a shorthand for sum(a[i]*a[x-i], i=0..x).
  168|       |     *  Note that [x 0 0 0 0 0] = [x*R].
  169|       |     */
  170|       |
  171|  14.6M|    secp256k1_u128_mul(&d, a0*2, a3);
  172|  14.6M|    secp256k1_u128_accum_mul(&d, a1*2, a2);
  173|  14.6M|    VERIFY_BITS_128(&d, 114);
  174|       |    /* [d 0 0 0] = [p3 0 0 0] */
