   53|  16.1M|    VERIFY_BITS_128(&d, 115);
   54|  16.1M|    VERIFY_BITS_128(&c, 48);
   55|       |    /* [(c<<12) 0 0 0 0 0 d 0 0 0] = [p8 0 0 0 0 p3 0 0 0] */
   56|  16.1M|    t3 = secp256k1_u128_to_u64(&d) & M; secp256k1_u128_rshift(&d, 52);
   57|  16.1M|    VERIFY_BITS(t3, 52);
   58|  16.1M|    VERIFY_BITS_128(&d, 63);
   59|       |    /* [(c<<12) 0 0 0 0 d t3 0 0 0] = [p8 0 0 0 0 p3 0 0 0] */
   60|       |
   61|  16.1M|    secp256k1_u128_accum_mul(&d, a0, b[4]);
   62|  16.1M|    secp256k1_u128_accum_mul(&d, a1, b[3]);
