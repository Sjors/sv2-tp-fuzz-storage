secp256k1.c:secp256k1_scalar_half:
  195|  1.53k|static void secp256k1_scalar_half(secp256k1_scalar *r, const secp256k1_scalar *a) {
  196|       |    /* Writing `/` for field division and `//` for integer division, we compute
  197|       |     *
  198|       |     *   a/2 = (a - (a&1))/2 + (a&1)/2
  199|       |     *       = (a >> 1) + (a&1 ?    1/2 : 0)
  200|       |     *       = (a >> 1) + (a&1 ? n//2+1 : 0),
  201|       |     *
  202|       |     * where n is the group order and in the last equality we have used 1/2 = n//2+1 (mod n).
  203|       |     * For n//2, we have the constants SECP256K1_N_H_0, ...
  204|       |     *
  205|       |     * This sum does not overflow. The most extreme case is a = -2, the largest odd scalar. Here:
  206|       |     * - the left summand is:  a >> 1 = (a - a&1)/2 = (n-2-1)//2           = (n-3)//2
  207|       |     * - the right summand is: a&1 ? n//2+1 : 0 = n//2+1 = (n-1)//2 + 2//2 = (n+1)//2
  208|       |     * Together they sum to (n-3)//2 + (n+1)//2 = (2n-2)//2 = n - 1, which is less than n.
  209|       |     */
  210|  1.53k|    uint64_t mask = -(uint64_t)(a->d[0] & 1U);
  211|  1.53k|    secp256k1_uint128 t;
  212|  1.53k|    SECP256K1_SCALAR_VERIFY(a);
  ------------------
  |  |  103|  1.53k|#define SECP256K1_SCALAR_VERIFY(r) secp256k1_scalar_verify(r)
  ------------------
  213|       |
  214|  1.53k|    secp256k1_u128_from_u64(&t, (a->d[0] >> 1) | (a->d[1] << 63));
  215|  1.53k|    secp256k1_u128_accum_u64(&t, (SECP256K1_N_H_0 + 1U) & mask);
  ------------------
  |  |   27|  1.53k|#define SECP256K1_N_H_0 ((uint64_t)0xDFE92F46681B20A0ULL)
  ------------------
  216|  1.53k|    r->d[0] = secp256k1_u128_to_u64(&t); secp256k1_u128_rshift(&t, 64);
  217|  1.53k|    secp256k1_u128_accum_u64(&t, (a->d[1] >> 1) | (a->d[2] << 63));
  218|  1.53k|    secp256k1_u128_accum_u64(&t, SECP256K1_N_H_1 & mask);
  ------------------
  |  |   28|  1.53k|#define SECP256K1_N_H_1 ((uint64_t)0x5D576E7357A4501DULL)
  ------------------
  219|  1.53k|    r->d[1] = secp256k1_u128_to_u64(&t); secp256k1_u128_rshift(&t, 64);
  220|  1.53k|    secp256k1_u128_accum_u64(&t, (a->d[2] >> 1) | (a->d[3] << 63));
  221|  1.53k|    secp256k1_u128_accum_u64(&t, SECP256K1_N_H_2 & mask);
  ------------------
  |  |   29|  1.53k|#define SECP256K1_N_H_2 ((uint64_t)0xFFFFFFFFFFFFFFFFULL)
  ------------------
  222|  1.53k|    r->d[2] = secp256k1_u128_to_u64(&t); secp256k1_u128_rshift(&t, 64);
  223|  1.53k|    r->d[3] = secp256k1_u128_to_u64(&t) + (a->d[3] >> 1) + (SECP256K1_N_H_3 & mask);
  ------------------
  |  |   30|  1.53k|#define SECP256K1_N_H_3 ((uint64_t)0x7FFFFFFFFFFFFFFFULL)
  ------------------
  224|       |#ifdef VERIFY
  225|       |    /* The line above only computed the bottom 64 bits of r->d[3]; redo the computation
  226|       |     * in full 128 bits to make sure the top 64 bits are indeed zero. */
  227|       |    secp256k1_u128_accum_u64(&t, a->d[3] >> 1);
  228|       |    secp256k1_u128_accum_u64(&t, SECP256K1_N_H_3 & mask);
  229|       |    secp256k1_u128_rshift(&t, 64);
  230|       |    VERIFY_CHECK(secp256k1_u128_to_u64(&t) == 0);
  231|       |
  232|       |    SECP256K1_SCALAR_VERIFY(r);
  233|       |#endif
  234|  1.53k|}
secp256k1.c:secp256k1_scalar_mul_shift_var:
  891|  5.27k|SECP256K1_INLINE static void secp256k1_scalar_mul_shift_var(secp256k1_scalar *r, const secp256k1_scalar *a, const secp256k1_scalar *b, unsigned int shift) {
  892|  5.27k|    uint64_t l[8];
  893|  5.27k|    unsigned int shiftlimbs;
  894|  5.27k|    unsigned int shiftlow;
  895|  5.27k|    unsigned int shifthigh;
  896|  5.27k|    SECP256K1_SCALAR_VERIFY(a);
  ------------------
  |  |  103|  5.27k|#define SECP256K1_SCALAR_VERIFY(r) secp256k1_scalar_verify(r)
  ------------------
  897|  5.27k|    SECP256K1_SCALAR_VERIFY(b);
  ------------------
  |  |  103|  5.27k|#define SECP256K1_SCALAR_VERIFY(r) secp256k1_scalar_verify(r)
  ------------------
  898|  5.27k|    VERIFY_CHECK(shift >= 256);
  899|       |
  900|  5.27k|    secp256k1_scalar_mul_512(l, a, b);
  901|  5.27k|    shiftlimbs = shift >> 6;
  902|  5.27k|    shiftlow = shift & 0x3F;
  903|  5.27k|    shifthigh = 64 - shiftlow;
  904|  5.27k|    r->d[0] = shift < 512 ? (l[0 + shiftlimbs] >> shiftlow | (shift < 448 && shiftlow ? (l[1 + shiftlimbs] << shifthigh) : 0)) : 0;
  ------------------
  |  Branch (904:15): [True: 5.27k, False: 0]
  |  Branch (904:63): [True: 5.27k, False: 0]
  |  Branch (904:78): [True: 0, False: 5.27k]
  ------------------
  905|  5.27k|    r->d[1] = shift < 448 ? (l[1 + shiftlimbs] >> shiftlow | (shift < 384 && shiftlow ? (l[2 + shiftlimbs] << shifthigh) : 0)) : 0;
  ------------------
  |  Branch (905:15): [True: 5.27k, False: 0]
  |  Branch (905:63): [True: 0, False: 5.27k]
  |  Branch (905:78): [True: 0, False: 0]
  ------------------
  906|  5.27k|    r->d[2] = shift < 384 ? (l[2 + shiftlimbs] >> shiftlow | (shift < 320 && shiftlow ? (l[3 + shiftlimbs] << shifthigh) : 0)) : 0;
  ------------------
  |  Branch (906:15): [True: 0, False: 5.27k]
  |  Branch (906:63): [True: 0, False: 0]
  |  Branch (906:78): [True: 0, False: 0]
  ------------------
  907|  5.27k|    r->d[3] = shift < 320 ? (l[3 + shiftlimbs] >> shiftlow) : 0;
  ------------------
  |  Branch (907:15): [True: 0, False: 5.27k]
  ------------------
  908|  5.27k|    secp256k1_scalar_cadd_bit(r, 0, (l[(shift - 1) >> 6] >> ((shift - 1) & 0x3f)) & 1);
  909|       |
  910|  5.27k|    SECP256K1_SCALAR_VERIFY(r);
  ------------------
  |  |  103|  5.27k|#define SECP256K1_SCALAR_VERIFY(r) secp256k1_scalar_verify(r)
  ------------------
  911|  5.27k|}
secp256k1.c:secp256k1_scalar_mul_512:
  680|  13.5k|static void secp256k1_scalar_mul_512(uint64_t *l8, const secp256k1_scalar *a, const secp256k1_scalar *b) {
  681|  13.5k|#ifdef USE_ASM_X86_64
  682|  13.5k|    const uint64_t *pb = b->d;
  683|  13.5k|    __asm__ __volatile__(
  684|       |    /* Preload */
  685|  13.5k|    "movq 0(%%rdi), %%r15\n"
  686|  13.5k|    "movq 8(%%rdi), %%rbx\n"
  687|  13.5k|    "movq 16(%%rdi), %%rcx\n"
  688|  13.5k|    "movq 0(%%rdx), %%r11\n"
  689|  13.5k|    "movq 8(%%rdx), %%r12\n"
  690|  13.5k|    "movq 16(%%rdx), %%r13\n"
  691|  13.5k|    "movq 24(%%rdx), %%r14\n"
  692|       |    /* (rax,rdx) = a0 * b0 */
  693|  13.5k|    "movq %%r15, %%rax\n"
  694|  13.5k|    "mulq %%r11\n"
  695|       |    /* Extract l8[0] */
  696|  13.5k|    "movq %%rax, 0(%%rsi)\n"
  697|       |    /* (r8,r9,r10) = (rdx) */
  698|  13.5k|    "movq %%rdx, %%r8\n"
  699|  13.5k|    "xorq %%r9, %%r9\n"
  700|  13.5k|    "xorq %%r10, %%r10\n"
  701|       |    /* (r8,r9,r10) += a0 * b1 */
  702|  13.5k|    "movq %%r15, %%rax\n"
  703|  13.5k|    "mulq %%r12\n"
  704|  13.5k|    "addq %%rax, %%r8\n"
  705|  13.5k|    "adcq %%rdx, %%r9\n"
  706|  13.5k|    "adcq $0, %%r10\n"
  707|       |    /* (r8,r9,r10) += a1 * b0 */
  708|  13.5k|    "movq %%rbx, %%rax\n"
  709|  13.5k|    "mulq %%r11\n"
  710|  13.5k|    "addq %%rax, %%r8\n"
  711|  13.5k|    "adcq %%rdx, %%r9\n"
  712|  13.5k|    "adcq $0, %%r10\n"
  713|       |    /* Extract l8[1] */
  714|  13.5k|    "movq %%r8, 8(%%rsi)\n"
  715|  13.5k|    "xorq %%r8, %%r8\n"
  716|       |    /* (r9,r10,r8) += a0 * b2 */
  717|  13.5k|    "movq %%r15, %%rax\n"
  718|  13.5k|    "mulq %%r13\n"
  719|  13.5k|    "addq %%rax, %%r9\n"
  720|  13.5k|    "adcq %%rdx, %%r10\n"
  721|  13.5k|    "adcq $0, %%r8\n"
  722|       |    /* (r9,r10,r8) += a1 * b1 */
  723|  13.5k|    "movq %%rbx, %%rax\n"
  724|  13.5k|    "mulq %%r12\n"
  725|  13.5k|    "addq %%rax, %%r9\n"
  726|  13.5k|    "adcq %%rdx, %%r10\n"
  727|  13.5k|    "adcq $0, %%r8\n"
  728|       |    /* (r9,r10,r8) += a2 * b0 */
  729|  13.5k|    "movq %%rcx, %%rax\n"
  730|  13.5k|    "mulq %%r11\n"
  731|  13.5k|    "addq %%rax, %%r9\n"
  732|  13.5k|    "adcq %%rdx, %%r10\n"
  733|  13.5k|    "adcq $0, %%r8\n"
  734|       |    /* Extract l8[2] */
  735|  13.5k|    "movq %%r9, 16(%%rsi)\n"
  736|  13.5k|    "xorq %%r9, %%r9\n"
  737|       |    /* (r10,r8,r9) += a0 * b3 */
  738|  13.5k|    "movq %%r15, %%rax\n"
  739|  13.5k|    "mulq %%r14\n"
  740|  13.5k|    "addq %%rax, %%r10\n"
  741|  13.5k|    "adcq %%rdx, %%r8\n"
  742|  13.5k|    "adcq $0, %%r9\n"
  743|       |    /* Preload a3 */
  744|  13.5k|    "movq 24(%%rdi), %%r15\n"
  745|       |    /* (r10,r8,r9) += a1 * b2 */
  746|  13.5k|    "movq %%rbx, %%rax\n"
  747|  13.5k|    "mulq %%r13\n"
  748|  13.5k|    "addq %%rax, %%r10\n"
  749|  13.5k|    "adcq %%rdx, %%r8\n"
  750|  13.5k|    "adcq $0, %%r9\n"
  751|       |    /* (r10,r8,r9) += a2 * b1 */
  752|  13.5k|    "movq %%rcx, %%rax\n"
  753|  13.5k|    "mulq %%r12\n"
  754|  13.5k|    "addq %%rax, %%r10\n"
  755|  13.5k|    "adcq %%rdx, %%r8\n"
  756|  13.5k|    "adcq $0, %%r9\n"
  757|       |    /* (r10,r8,r9) += a3 * b0 */
  758|  13.5k|    "movq %%r15, %%rax\n"
  759|  13.5k|    "mulq %%r11\n"
  760|  13.5k|    "addq %%rax, %%r10\n"
  761|  13.5k|    "adcq %%rdx, %%r8\n"
  762|  13.5k|    "adcq $0, %%r9\n"
  763|       |    /* Extract l8[3] */
