  910|  16.9k|    secp256k1_scalar_cadd_bit(r, 0, (l[(shift - 1) >> 6] >> ((shift - 1) & 0x3f)) & 1);
  911|       |
  912|  16.9k|    SECP256K1_SCALAR_VERIFY(r);
  ------------------
  |  |  103|  16.9k|#define SECP256K1_SCALAR_VERIFY(r) secp256k1_scalar_verify(r)
  ------------------
  913|  16.9k|}
