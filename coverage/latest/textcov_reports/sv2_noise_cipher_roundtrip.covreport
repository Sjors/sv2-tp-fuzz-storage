  711|  43.7k|    "mulq %%r11\n"
  712|  43.7k|    "addq %%rax, %%r8\n"
  713|  43.7k|    "adcq %%rdx, %%r9\n"
  714|  43.7k|    "adcq $0, %%r10\n"
  715|       |    /* Extract l8[1] */
