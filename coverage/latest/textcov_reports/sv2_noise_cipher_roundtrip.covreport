  210|   135k|static void secp256k1_sha256_write(const secp256k1_hash_ctx *hash_ctx, secp256k1_sha256 *hash, const unsigned char *data, size_t len) {
  211|   135k|    size_t chunk_len;
  212|   135k|    size_t bufsize = hash->bytes & 0x3F;
  213|   135k|    hash->bytes += len;
  214|   135k|    VERIFY_CHECK(hash->bytes >= len);
  215|   135k|    VERIFY_CHECK(hash_ctx != NULL);
  216|   135k|    VERIFY_CHECK(hash_ctx->fn_sha256_compression != NULL);
  217|       |
  218|       |    /* If we exceed the 64-byte block size with this input, process it and wipe the buffer */
  219|   135k|    chunk_len = 64 - bufsize;
  220|   135k|    if (bufsize && len >= chunk_len) {
  ------------------
  |  Branch (220:9): [True: 99.9k, False: 35.2k]
  |  Branch (220:20): [True: 43.8k, False: 56.1k]
  ------------------
  221|  43.8k|        memcpy(hash->buf + bufsize, data, chunk_len);
  222|  43.8k|        data += chunk_len;
  223|  43.8k|        len -= chunk_len;
  224|  43.8k|        hash_ctx->fn_sha256_compression(hash->s, hash->buf, 1);
  225|  43.8k|        bufsize = 0;
  226|  43.8k|    }
  227|       |
  228|       |    /* If we still have data to process, invoke compression directly on the input */
  229|   135k|    if (len >= 64) {
  ------------------
  |  Branch (229:9): [True: 9.11k, False: 126k]
  ------------------
  230|  9.11k|        const size_t n_blocks = len / 64;
  231|  9.11k|        const size_t advance = n_blocks * 64;
  232|  9.11k|        hash_ctx->fn_sha256_compression(hash->s, data, n_blocks);
  233|  9.11k|        data += advance;
  234|  9.11k|        len -= advance;
  235|  9.11k|    }
  236|       |
  237|       |    /* Fill the buffer with what remains */
  238|   135k|    if (len) {
  ------------------
  |  Branch (238:9): [True: 82.2k, False: 52.9k]
  ------------------
  239|  82.2k|        memcpy(hash->buf + bufsize, data, len);
  240|  82.2k|    }
