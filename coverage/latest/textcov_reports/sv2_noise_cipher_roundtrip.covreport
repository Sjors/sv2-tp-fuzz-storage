  701|  39.3k|    "xorq %%r9, %%r9\n"
  702|  39.3k|    "xorq %%r10, %%r10\n"
  703|       |    /* (r8,r9,r10) += a0 * b1 */
  704|  39.3k|    "movq %%r15, %%rax\n"
  705|  39.3k|    "mulq %%r12\n"
  706|  39.3k|    "addq %%rax, %%r8\n"
  707|  39.3k|    "adcq %%rdx, %%r9\n"
  708|  39.3k|    "adcq $0, %%r10\n"
  709|       |    /* (r8,r9,r10) += a1 * b0 */
  710|  39.3k|    "movq %%rbx, %%rax\n"
  711|  39.3k|    "mulq %%r11\n"
  712|  39.3k|    "addq %%rax, %%r8\n"
  713|  39.3k|    "adcq %%rdx, %%r9\n"
  714|  39.3k|    "adcq $0, %%r10\n"
  715|       |    /* Extract l8[1] */
