  682|  39.3k|static void secp256k1_scalar_mul_512(uint64_t *l8, const secp256k1_scalar *a, const secp256k1_scalar *b) {
  683|  39.3k|#ifdef USE_ASM_X86_64
  684|  39.3k|    const uint64_t *pb = b->d;
  685|  39.3k|    __asm__ __volatile__(
  686|       |    /* Preload */
  687|  39.3k|    "movq 0(%%rdi), %%r15\n"
  688|  39.3k|    "movq 8(%%rdi), %%rbx\n"
  689|  39.3k|    "movq 16(%%rdi), %%rcx\n"
  690|  39.3k|    "movq 0(%%rdx), %%r11\n"
  691|  39.3k|    "movq 8(%%rdx), %%r12\n"
  692|  39.3k|    "movq 16(%%rdx), %%r13\n"
  693|  39.3k|    "movq 24(%%rdx), %%r14\n"
  694|       |    /* (rax,rdx) = a0 * b0 */
  695|  39.3k|    "movq %%r15, %%rax\n"
  696|  39.3k|    "mulq %%r11\n"
  697|       |    /* Extract l8[0] */
  698|  39.3k|    "movq %%rax, 0(%%rsi)\n"
  699|       |    /* (r8,r9,r10) = (rdx) */
