  284|       |            /* In this branch, use a simpler formula that only lets us cancel up to 4 bits of g, as
  285|       |             * eta tends to be smaller here. */
  286|  54.8k|            limit = ((int)eta + 1) > i ? i : ((int)eta + 1);
  ------------------
  |  Branch (286:21): [True: 355, False: 54.4k]
  ------------------
  287|  54.8k|            VERIFY_CHECK(limit > 0 && limit <= 62);
  288|       |            /* m is a mask for the bottom min(limit, 4) bits. */
  289|  54.8k|            m = (UINT64_MAX >> (64 - limit)) & 15U;
  290|       |            /* Find what multiple of f must be added to g to cancel its bottom min(limit, 4)
  291|       |             * bits. */
  292|  54.8k|            w = f + (((f + 1) & 4) << 1);
