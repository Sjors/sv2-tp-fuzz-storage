  119|  16.1M|    VERIFY_BITS(r[1], 52);
  120|  16.1M|    VERIFY_BITS_128(&c, 63);
  121|       |    /* [d 0 0 t4 t3 c r1 r0] = [p8 0 p6 p5 p4 p3 0 p1 p0] */
  122|       |
  123|  16.1M|    secp256k1_u128_accum_mul(&c, a0, b[2]);
  124|  16.1M|    secp256k1_u128_accum_mul(&c, a1, b[1]);
  125|  16.1M|    secp256k1_u128_accum_mul(&c, a2, b[0]);
