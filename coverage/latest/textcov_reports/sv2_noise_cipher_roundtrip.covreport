  231|  39.6k|            | ((uint64_t)a[29] << 16)
  232|  39.6k|            | ((uint64_t)a[28] << 24)
  233|  39.6k|            | ((uint64_t)a[27] << 32)
  234|  39.6k|            | ((uint64_t)a[26] << 40)
  235|  39.6k|            | ((uint64_t)(a[25] & 0xF)  << 48);
  236|  39.6k|    r->n[1] = (uint64_t)((a[25] >> 4) & 0xF)
  237|  39.6k|            | ((uint64_t)a[24] << 4)
  238|  39.6k|            | ((uint64_t)a[23] << 12)
  239|  39.6k|            | ((uint64_t)a[22] << 20)
  240|  39.6k|            | ((uint64_t)a[21] << 28)
  241|  39.6k|            | ((uint64_t)a[20] << 36)
  242|  39.6k|            | ((uint64_t)a[19] << 44);
  243|  39.6k|    r->n[2] = (uint64_t)a[18]
  244|  39.6k|            | ((uint64_t)a[17] << 8)
  245|  39.6k|            | ((uint64_t)a[16] << 16)
  246|  39.6k|            | ((uint64_t)a[15] << 24)
  247|  39.6k|            | ((uint64_t)a[14] << 32)
  248|  39.6k|            | ((uint64_t)a[13] << 40)
  249|  39.6k|            | ((uint64_t)(a[12] & 0xF) << 48);
  250|  39.6k|    r->n[3] = (uint64_t)((a[12] >> 4) & 0xF)
  251|  39.6k|            | ((uint64_t)a[11] << 4)
  252|  39.6k|            | ((uint64_t)a[10] << 12)
  253|  39.6k|            | ((uint64_t)a[9]  << 20)
  254|  39.6k|            | ((uint64_t)a[8]  << 28)
  255|  39.6k|            | ((uint64_t)a[7]  << 36)
  256|  39.6k|            | ((uint64_t)a[6]  << 44);
  257|  39.6k|    r->n[4] = (uint64_t)a[5]
  258|  39.6k|            | ((uint64_t)a[4] << 8)
  259|  39.6k|            | ((uint64_t)a[3] << 16)
  260|  39.6k|            | ((uint64_t)a[2] << 24)
  261|  39.6k|            | ((uint64_t)a[1] << 32)
  262|  39.6k|            | ((uint64_t)a[0] << 40);
