secp256k1.c:secp256k1_fe_to_signed62:
  465|  91.4k|static void secp256k1_fe_to_signed62(secp256k1_modinv64_signed62 *r, const secp256k1_fe *a) {
  466|  91.4k|    const uint64_t M62 = UINT64_MAX >> 2;
  467|  91.4k|    const uint64_t a0 = a->n[0], a1 = a->n[1], a2 = a->n[2], a3 = a->n[3], a4 = a->n[4];
  468|       |
  469|  91.4k|    r->v[0] = (a0       | a1 << 52) & M62;
  470|  91.4k|    r->v[1] = (a1 >> 10 | a2 << 42) & M62;
  471|  91.4k|    r->v[2] = (a2 >> 20 | a3 << 32) & M62;
  472|  91.4k|    r->v[3] = (a3 >> 30 | a4 << 22) & M62;
  473|  91.4k|    r->v[4] =  a4 >> 40;
  474|  91.4k|}
secp256k1.c:secp256k1_fe_from_signed62:
  445|  49.7k|static void secp256k1_fe_from_signed62(secp256k1_fe *r, const secp256k1_modinv64_signed62 *a) {
  446|  49.7k|    const uint64_t M52 = UINT64_MAX >> 12;
  447|  49.7k|    const uint64_t a0 = a->v[0], a1 = a->v[1], a2 = a->v[2], a3 = a->v[3], a4 = a->v[4];
  448|       |
  449|       |    /* The output from secp256k1_modinv64{_var} should be normalized to range [0,modulus), and
  450|       |     * have limbs in [0,2^62). The modulus is < 2^256, so the top limb must be below 2^(256-62*4).
  451|       |     */
  452|  49.7k|    VERIFY_CHECK(a0 >> 62 == 0);
  453|  49.7k|    VERIFY_CHECK(a1 >> 62 == 0);
  454|  49.7k|    VERIFY_CHECK(a2 >> 62 == 0);
  455|  49.7k|    VERIFY_CHECK(a3 >> 62 == 0);
  456|  49.7k|    VERIFY_CHECK(a4 >> 8 == 0);
  457|       |
  458|  49.7k|    r->n[0] =  a0                   & M52;
  459|  49.7k|    r->n[1] = (a0 >> 52 | a1 << 10) & M52;
  460|  49.7k|    r->n[2] = (a1 >> 42 | a2 << 20) & M52;
  461|  49.7k|    r->n[3] = (a2 >> 32 | a3 << 30) & M52;
  462|  49.7k|    r->n[4] = (a3 >> 22 | a4 << 40);
  463|  49.7k|}
secp256k1.c:secp256k1_fe_impl_set_b32_limit:
  265|  5.42k|static int secp256k1_fe_impl_set_b32_limit(secp256k1_fe *r, const unsigned char *a) {
  266|  5.42k|    secp256k1_fe_impl_set_b32_mod(r, a);
  267|  5.42k|    return !((r->n[4] == 0x0FFFFFFFFFFFFULL) & ((r->n[3] & r->n[2] & r->n[1]) == 0xFFFFFFFFFFFFFULL) & (r->n[0] >= 0xFFFFEFFFFFC2FULL));
  268|  5.42k|}
secp256k1.c:secp256k1_fe_impl_get_b32:
  271|  43.9k|static void secp256k1_fe_impl_get_b32(unsigned char *r, const secp256k1_fe *a) {
  272|  43.9k|    r[0] = (a->n[4] >> 40) & 0xFF;
  273|  43.9k|    r[1] = (a->n[4] >> 32) & 0xFF;
  274|  43.9k|    r[2] = (a->n[4] >> 24) & 0xFF;
  275|  43.9k|    r[3] = (a->n[4] >> 16) & 0xFF;
  276|  43.9k|    r[4] = (a->n[4] >> 8) & 0xFF;
  277|  43.9k|    r[5] = a->n[4] & 0xFF;
  278|  43.9k|    r[6] = (a->n[3] >> 44) & 0xFF;
  279|  43.9k|    r[7] = (a->n[3] >> 36) & 0xFF;
  280|  43.9k|    r[8] = (a->n[3] >> 28) & 0xFF;
  281|  43.9k|    r[9] = (a->n[3] >> 20) & 0xFF;
  282|  43.9k|    r[10] = (a->n[3] >> 12) & 0xFF;
  283|  43.9k|    r[11] = (a->n[3] >> 4) & 0xFF;
  284|  43.9k|    r[12] = ((a->n[2] >> 48) & 0xF) | ((a->n[3] & 0xF) << 4);
  285|  43.9k|    r[13] = (a->n[2] >> 40) & 0xFF;
  286|  43.9k|    r[14] = (a->n[2] >> 32) & 0xFF;
  287|  43.9k|    r[15] = (a->n[2] >> 24) & 0xFF;
  288|  43.9k|    r[16] = (a->n[2] >> 16) & 0xFF;
  289|  43.9k|    r[17] = (a->n[2] >> 8) & 0xFF;
  290|  43.9k|    r[18] = a->n[2] & 0xFF;
  291|  43.9k|    r[19] = (a->n[1] >> 44) & 0xFF;
  292|  43.9k|    r[20] = (a->n[1] >> 36) & 0xFF;
  293|  43.9k|    r[21] = (a->n[1] >> 28) & 0xFF;
  294|  43.9k|    r[22] = (a->n[1] >> 20) & 0xFF;
  295|  43.9k|    r[23] = (a->n[1] >> 12) & 0xFF;
  296|  43.9k|    r[24] = (a->n[1] >> 4) & 0xFF;
  297|  43.9k|    r[25] = ((a->n[0] >> 48) & 0xF) | ((a->n[1] & 0xF) << 4);
  298|  43.9k|    r[26] = (a->n[0] >> 40) & 0xFF;
  299|  43.9k|    r[27] = (a->n[0] >> 32) & 0xFF;
  300|  43.9k|    r[28] = (a->n[0] >> 24) & 0xFF;
  301|  43.9k|    r[29] = (a->n[0] >> 16) & 0xFF;
  302|  43.9k|    r[30] = (a->n[0] >> 8) & 0xFF;
  303|  43.9k|    r[31] = a->n[0] & 0xFF;
  304|  43.9k|}
secp256k1.c:secp256k1_fe_impl_normalize_var:
   99|   135k|static void secp256k1_fe_impl_normalize_var(secp256k1_fe *r) {
  100|   135k|    uint64_t t0 = r->n[0], t1 = r->n[1], t2 = r->n[2], t3 = r->n[3], t4 = r->n[4];
  101|       |
  102|       |    /* Reduce t4 at the start so there will be at most a single carry from the first pass */
  103|   135k|    uint64_t m;
  104|   135k|    uint64_t x = t4 >> 48; t4 &= 0x0FFFFFFFFFFFFULL;
  105|       |
  106|       |    /* The first pass ensures the magnitude is 1, ... */
  107|   135k|    t0 += x * 0x1000003D1ULL;
  108|   135k|    t1 += (t0 >> 52); t0 &= 0xFFFFFFFFFFFFFULL;
  109|   135k|    t2 += (t1 >> 52); t1 &= 0xFFFFFFFFFFFFFULL; m = t1;
  110|   135k|    t3 += (t2 >> 52); t2 &= 0xFFFFFFFFFFFFFULL; m &= t2;
  111|   135k|    t4 += (t3 >> 52); t3 &= 0xFFFFFFFFFFFFFULL; m &= t3;
  112|       |
  113|       |    /* ... except for a possible carry at bit 48 of t4 (i.e. bit 256 of the field element) */
  114|   135k|    VERIFY_CHECK(t4 >> 49 == 0);
  115|       |
  116|       |    /* At most a single final reduction is needed; check if the value is >= the field characteristic */
  117|   135k|    x = (t4 >> 48) | ((t4 == 0x0FFFFFFFFFFFFULL) & (m == 0xFFFFFFFFFFFFFULL)
  118|   135k|        & (t0 >= 0xFFFFEFFFFFC2FULL));
  119|       |
  120|   135k|    if (x) {
  ------------------
  |  Branch (120:9): [True: 0, False: 135k]
  ------------------
  121|      0|        t0 += 0x1000003D1ULL;
  122|      0|        t1 += (t0 >> 52); t0 &= 0xFFFFFFFFFFFFFULL;
  123|      0|        t2 += (t1 >> 52); t1 &= 0xFFFFFFFFFFFFFULL;
  124|      0|        t3 += (t2 >> 52); t2 &= 0xFFFFFFFFFFFFFULL;
  125|      0|        t4 += (t3 >> 52); t3 &= 0xFFFFFFFFFFFFFULL;
  126|       |
  127|       |        /* If t4 didn't carry to bit 48 already, then it should have after any final reduction */
  128|      0|        VERIFY_CHECK(t4 >> 48 == x);
  129|       |
  130|       |        /* Mask off the possible multiple of 2^256 from the final reduction */
  131|      0|        t4 &= 0x0FFFFFFFFFFFFULL;
  132|      0|    }
  133|       |
  134|   135k|    r->n[0] = t0; r->n[1] = t1; r->n[2] = t2; r->n[3] = t3; r->n[4] = t4;
  135|   135k|}
secp256k1.c:secp256k1_fe_impl_is_odd:
