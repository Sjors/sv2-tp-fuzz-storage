   84|  19.2M|    secp256k1_u128_accum_mul(&d, a2, b[3]);
   85|  19.2M|    secp256k1_u128_accum_mul(&d, a3, b[2]);
   86|  19.2M|    secp256k1_u128_accum_mul(&d, a4, b[1]);
   87|  19.2M|    VERIFY_BITS_128(&d, 114);
   88|       |    /* [d t4+(tx<<48) t3 0 0 c] = [p8 0 0 p5 p4 p3 0 0 p0] */
   89|  19.2M|    u0 = secp256k1_u128_to_u64(&d) & M; secp256k1_u128_rshift(&d, 52);
   90|  19.2M|    VERIFY_BITS(u0, 52);
   91|  19.2M|    VERIFY_BITS_128(&d, 62);
   92|       |    /* [d u0 t4+(tx<<48) t3 0 0 c] = [p8 0 0 p5 p4 p3 0 0 p0] */
