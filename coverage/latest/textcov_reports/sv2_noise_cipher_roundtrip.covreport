secp256k1.c:secp256k1_fe_storage_cmov:
  389|  86.6M|static SECP256K1_INLINE void secp256k1_fe_storage_cmov(secp256k1_fe_storage *r, const secp256k1_fe_storage *a, int flag) {
  390|  86.6M|    uint64_t mask0, mask1;
  391|  86.6M|    volatile int vflag = flag;
  392|  86.6M|    VERIFY_CHECK(flag == 0 || flag == 1);
  393|  86.6M|    SECP256K1_CHECKMEM_CHECK_VERIFY(r->n, sizeof(r->n));
  ------------------
  |  |  114|  86.6M|#define SECP256K1_CHECKMEM_CHECK_VERIFY(p, len) SECP256K1_CHECKMEM_NOOP((p), (len))
  |  |  ------------------
  |  |  |  |   42|  86.6M|#define SECP256K1_CHECKMEM_NOOP(p, len) do { (void)(p); (void)(len); } while(0)
  |  |  |  |  ------------------
  |  |  |  |  |  Branch (42:78): [Folded, False: 86.6M]
  |  |  |  |  ------------------
  |  |  ------------------
  ------------------
  394|  86.6M|    mask0 = vflag + ~((uint64_t)0);
  395|  86.6M|    mask1 = ~mask0;
  396|  86.6M|    r->n[0] = (r->n[0] & mask0) | (a->n[0] & mask1);
  397|  86.6M|    r->n[1] = (r->n[1] & mask0) | (a->n[1] & mask1);
  398|  86.6M|    r->n[2] = (r->n[2] & mask0) | (a->n[2] & mask1);
  399|  86.6M|    r->n[3] = (r->n[3] & mask0) | (a->n[3] & mask1);
  400|  86.6M|}
secp256k1.c:secp256k1_fe_impl_is_square_var:
  473|  38.9k|static int secp256k1_fe_impl_is_square_var(const secp256k1_fe *x) {
  474|  38.9k|    secp256k1_fe tmp;
  475|  38.9k|    secp256k1_modinv64_signed62 s;
  476|  38.9k|    int jac, ret;
  477|       |
  478|  38.9k|    tmp = *x;
  479|  38.9k|    secp256k1_fe_normalize_var(&tmp);
  ------------------
  |  |   80|  38.9k|#  define secp256k1_fe_normalize_var secp256k1_fe_impl_normalize_var
  ------------------
  480|       |    /* secp256k1_jacobi64_maybe_var cannot deal with input 0. */
  481|  38.9k|    if (secp256k1_fe_is_zero(&tmp)) return 1;
  ------------------
  |  |   84|  38.9k|#  define secp256k1_fe_is_zero secp256k1_fe_impl_is_zero
  ------------------
  |  Branch (481:9): [True: 0, False: 38.9k]
  ------------------
  482|  38.9k|    secp256k1_fe_to_signed62(&s, &tmp);
  483|  38.9k|    jac = secp256k1_jacobi64_maybe_var(&s, &secp256k1_const_modinfo_fe);
  484|  38.9k|    if (jac == 0) {
  ------------------
  |  Branch (484:9): [True: 0, False: 38.9k]
  ------------------
  485|       |        /* secp256k1_jacobi64_maybe_var failed to compute the Jacobi symbol. Fall back
  486|       |         * to computing a square root. This should be extremely rare with random
  487|       |         * input (except in VERIFY mode, where a lower iteration count is used). */
  488|      0|        secp256k1_fe dummy;
  489|      0|        ret = secp256k1_fe_sqrt(&dummy, &tmp);
  490|  38.9k|    } else {
  491|  38.9k|        ret = jac >= 0;
  492|  38.9k|    }
  493|  38.9k|    return ret;
  494|  38.9k|}
secp256k1.c:secp256k1_fe_impl_set_b32_mod:
  228|  37.3k|static void secp256k1_fe_impl_set_b32_mod(secp256k1_fe *r, const unsigned char *a) {
  229|  37.3k|    r->n[0] = (uint64_t)a[31]
  230|  37.3k|            | ((uint64_t)a[30] << 8)
  231|  37.3k|            | ((uint64_t)a[29] << 16)
  232|  37.3k|            | ((uint64_t)a[28] << 24)
  233|  37.3k|            | ((uint64_t)a[27] << 32)
  234|  37.3k|            | ((uint64_t)a[26] << 40)
  235|  37.3k|            | ((uint64_t)(a[25] & 0xF)  << 48);
  236|  37.3k|    r->n[1] = (uint64_t)((a[25] >> 4) & 0xF)
  237|  37.3k|            | ((uint64_t)a[24] << 4)
  238|  37.3k|            | ((uint64_t)a[23] << 12)
  239|  37.3k|            | ((uint64_t)a[22] << 20)
  240|  37.3k|            | ((uint64_t)a[21] << 28)
  241|  37.3k|            | ((uint64_t)a[20] << 36)
  242|  37.3k|            | ((uint64_t)a[19] << 44);
  243|  37.3k|    r->n[2] = (uint64_t)a[18]
  244|  37.3k|            | ((uint64_t)a[17] << 8)
  245|  37.3k|            | ((uint64_t)a[16] << 16)
  246|  37.3k|            | ((uint64_t)a[15] << 24)
  247|  37.3k|            | ((uint64_t)a[14] << 32)
  248|  37.3k|            | ((uint64_t)a[13] << 40)
  249|  37.3k|            | ((uint64_t)(a[12] & 0xF) << 48);
  250|  37.3k|    r->n[3] = (uint64_t)((a[12] >> 4) & 0xF)
  251|  37.3k|            | ((uint64_t)a[11] << 4)
  252|  37.3k|            | ((uint64_t)a[10] << 12)
  253|  37.3k|            | ((uint64_t)a[9]  << 20)
  254|  37.3k|            | ((uint64_t)a[8]  << 28)
  255|  37.3k|            | ((uint64_t)a[7]  << 36)
  256|  37.3k|            | ((uint64_t)a[6]  << 44);
  257|  37.3k|    r->n[4] = (uint64_t)a[5]
  258|  37.3k|            | ((uint64_t)a[4] << 8)
  259|  37.3k|            | ((uint64_t)a[3] << 16)
  260|  37.3k|            | ((uint64_t)a[2] << 24)
  261|  37.3k|            | ((uint64_t)a[1] << 32)
  262|  37.3k|            | ((uint64_t)a[0] << 40);
  263|  37.3k|}
secp256k1.c:secp256k1_fe_impl_normalize:
   43|   100k|static void secp256k1_fe_impl_normalize(secp256k1_fe *r) {
   44|   100k|    uint64_t t0 = r->n[0], t1 = r->n[1], t2 = r->n[2], t3 = r->n[3], t4 = r->n[4];
   45|       |
   46|       |    /* Reduce t4 at the start so there will be at most a single carry from the first pass */
   47|   100k|    uint64_t m;
   48|   100k|    uint64_t x = t4 >> 48; t4 &= 0x0FFFFFFFFFFFFULL;
   49|       |
   50|       |    /* The first pass ensures the magnitude is 1, ... */
   51|   100k|    t0 += x * 0x1000003D1ULL;
   52|   100k|    t1 += (t0 >> 52); t0 &= 0xFFFFFFFFFFFFFULL;
   53|   100k|    t2 += (t1 >> 52); t1 &= 0xFFFFFFFFFFFFFULL; m = t1;
   54|   100k|    t3 += (t2 >> 52); t2 &= 0xFFFFFFFFFFFFFULL; m &= t2;
   55|   100k|    t4 += (t3 >> 52); t3 &= 0xFFFFFFFFFFFFFULL; m &= t3;
   56|       |
   57|       |    /* ... except for a possible carry at bit 48 of t4 (i.e. bit 256 of the field element) */
   58|   100k|    VERIFY_CHECK(t4 >> 49 == 0);
   59|       |
   60|       |    /* At most a single final reduction is needed; check if the value is >= the field characteristic */
   61|   100k|    x = (t4 >> 48) | ((t4 == 0x0FFFFFFFFFFFFULL) & (m == 0xFFFFFFFFFFFFFULL)
   62|   100k|        & (t0 >= 0xFFFFEFFFFFC2FULL));
   63|       |
   64|       |    /* Apply the final reduction (for constant-time behaviour, we do it always) */
   65|   100k|    t0 += x * 0x1000003D1ULL;
   66|   100k|    t1 += (t0 >> 52); t0 &= 0xFFFFFFFFFFFFFULL;
   67|   100k|    t2 += (t1 >> 52); t1 &= 0xFFFFFFFFFFFFFULL;
   68|   100k|    t3 += (t2 >> 52); t2 &= 0xFFFFFFFFFFFFFULL;
   69|   100k|    t4 += (t3 >> 52); t3 &= 0xFFFFFFFFFFFFFULL;
   70|       |
   71|       |    /* If t4 didn't carry to bit 48 already, then it should have after any final reduction */
   72|   100k|    VERIFY_CHECK(t4 >> 48 == x);
   73|       |
   74|       |    /* Mask off the possible multiple of 2^256 from the final reduction */
   75|   100k|    t4 &= 0x0FFFFFFFFFFFFULL;
   76|       |
   77|   100k|    r->n[0] = t0; r->n[1] = t1; r->n[2] = t2; r->n[3] = t3; r->n[4] = t4;
   78|   100k|}
secp256k1.c:secp256k1_fe_impl_to_storage:
  402|  58.5k|static void secp256k1_fe_impl_to_storage(secp256k1_fe_storage *r, const secp256k1_fe *a) {
  403|  58.5k|    r->n[0] = a->n[0] | a->n[1] << 52;
  404|  58.5k|    r->n[1] = a->n[1] >> 12 | a->n[2] << 40;
  405|  58.5k|    r->n[2] = a->n[2] >> 24 | a->n[3] << 28;
  406|  58.5k|    r->n[3] = a->n[3] >> 36 | a->n[4] << 16;
  407|  58.5k|}

secp256k1.c:secp256k1_fe_sqr_inner:
  154|  16.3M|SECP256K1_FORCE_INLINE static void secp256k1_fe_sqr_inner(uint64_t *r, const uint64_t *a) {
  155|  16.3M|    secp256k1_uint128 c, d;
  156|  16.3M|    uint64_t a0 = a[0], a1 = a[1], a2 = a[2], a3 = a[3], a4 = a[4];
  157|  16.3M|    uint64_t t3, t4, tx, u0;
  158|  16.3M|    const uint64_t M = 0xFFFFFFFFFFFFFULL, R = 0x1000003D10ULL;
  159|       |
  160|  16.3M|    VERIFY_BITS(a[0], 56);
  161|  16.3M|    VERIFY_BITS(a[1], 56);
  162|  16.3M|    VERIFY_BITS(a[2], 56);
  163|  16.3M|    VERIFY_BITS(a[3], 56);
  164|  16.3M|    VERIFY_BITS(a[4], 52);
  165|       |
  166|       |    /**  [... a b c] is a shorthand for ... + a<<104 + b<<52 + c<<0 mod n.
  167|       |     *  px is a shorthand for sum(a[i]*a[x-i], i=0..x).
  168|       |     *  Note that [x 0 0 0 0 0] = [x*R].
  169|       |     */
  170|       |
  171|  16.3M|    secp256k1_u128_mul(&d, a0*2, a3);
  172|  16.3M|    secp256k1_u128_accum_mul(&d, a1*2, a2);
  173|  16.3M|    VERIFY_BITS_128(&d, 114);
  174|       |    /* [d 0 0 0] = [p3 0 0 0] */
  175|  16.3M|    secp256k1_u128_mul(&c, a4, a4);
