  891|  17.8k|SECP256K1_INLINE static void secp256k1_scalar_mul_shift_var(secp256k1_scalar *r, const secp256k1_scalar *a, const secp256k1_scalar *b, unsigned int shift) {
  892|  17.8k|    uint64_t l[8];
  893|  17.8k|    unsigned int shiftlimbs;
  894|  17.8k|    unsigned int shiftlow;
