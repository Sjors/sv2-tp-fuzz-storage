  977|  8.74k|static void secp256k1_ge_to_bytes(unsigned char *buf, const secp256k1_ge *a) {
  978|  8.74k|    secp256k1_ge_storage s;
  979|       |
  980|       |    /* We require that the secp256k1_ge_storage type is exactly 64 bytes.
  981|       |     * This is formally not guaranteed by the C standard, but should hold on any
  982|       |     * sane compiler in the real world. */
  983|  8.74k|    STATIC_ASSERT(sizeof(secp256k1_ge_storage) == 64);
  ------------------
  |  |   64|  8.74k|#define STATIC_ASSERT(expr) do { \
  |  |   65|  8.74k|    switch(0) { \
  |  |  ------------------
  |  |  |  Branch (65:12): [Folded, False: 0]
  |  |  ------------------
  |  |   66|  8.74k|        case 0: \
  |  |  ------------------
  |  |  |  Branch (66:9): [True: 8.74k, False: 0]
  |  |  ------------------
  |  |   67|  8.74k|        /* If expr evaluates to 0, we have two case labels "0", which is illegal. */ \
  |  |   68|  8.74k|        case /* ERROR: static assertion failed */ (expr): \
  |  |  ------------------
  |  |  |  Branch (68:9): [True: 0, False: 8.74k]
  |  |  ------------------
  |  |   69|  8.74k|        ; \
  |  |   70|  8.74k|    } \
  |  |   71|  8.74k|} while(0)
  |  |  ------------------
  |  |  |  Branch (71:9): [Folded, False: 8.74k]
  |  |  ------------------
  ------------------
  984|  8.74k|    VERIFY_CHECK(!secp256k1_ge_is_infinity(a));
  985|  8.74k|    secp256k1_ge_to_storage(&s, a);
  986|  8.74k|    memcpy(buf, &s, 64);
  987|  8.74k|}
