secp256k1.c:secp256k1_fe_impl_inv:
  481|  39.3k|static void secp256k1_fe_impl_inv(secp256k1_fe *r, const secp256k1_fe *x) {
  482|  39.3k|    secp256k1_fe tmp = *x;
  483|  39.3k|    secp256k1_modinv64_signed62 s;
  484|       |
  485|  39.3k|    secp256k1_fe_normalize(&tmp);
  ------------------
  |  |   78|  39.3k|#  define secp256k1_fe_normalize secp256k1_fe_impl_normalize
  ------------------
  486|  39.3k|    secp256k1_fe_to_signed62(&s, &tmp);
  487|  39.3k|    secp256k1_modinv64(&s, &secp256k1_const_modinfo_fe);
  488|  39.3k|    secp256k1_fe_from_signed62(r, &s);
