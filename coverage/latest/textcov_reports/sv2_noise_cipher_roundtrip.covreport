secp256k1.c:secp256k1_scalar_get_bits_limb32:
   41|   345k|SECP256K1_INLINE static uint32_t secp256k1_scalar_get_bits_limb32(const secp256k1_scalar *a, unsigned int offset, unsigned int count) {
   42|   345k|    SECP256K1_SCALAR_VERIFY(a);
  ------------------
  |  |  103|   345k|#define SECP256K1_SCALAR_VERIFY(r) secp256k1_scalar_verify(r)
  ------------------
   43|   345k|    VERIFY_CHECK(count > 0 && count <= 32);
   44|   345k|    VERIFY_CHECK((offset + count - 1) >> 6 == offset >> 6);
   45|       |
   46|   345k|    return (a->d[offset >> 6] >> (offset & 0x3F)) & (0xFFFFFFFF >> (32 - count));
   47|   345k|}
