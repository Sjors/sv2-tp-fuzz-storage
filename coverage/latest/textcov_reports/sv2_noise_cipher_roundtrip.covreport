  154|  17.3M|SECP256K1_INLINE static void secp256k1_fe_sqr_inner(uint64_t *r, const uint64_t *a) {
  155|  17.3M|    secp256k1_uint128 c, d;
  156|  17.3M|    uint64_t a0 = a[0], a1 = a[1], a2 = a[2], a3 = a[3], a4 = a[4];
  157|  17.3M|    uint64_t t3, t4, tx, u0;
  158|  17.3M|    const uint64_t M = 0xFFFFFFFFFFFFFULL, R = 0x1000003D10ULL;
  159|       |
  160|  17.3M|    VERIFY_BITS(a[0], 56);
  161|  17.3M|    VERIFY_BITS(a[1], 56);
  162|  17.3M|    VERIFY_BITS(a[2], 56);
  163|  17.3M|    VERIFY_BITS(a[3], 56);
  164|  17.3M|    VERIFY_BITS(a[4], 52);
  165|       |
  166|       |    /**  [... a b c] is a shorthand for ... + a<<104 + b<<52 + c<<0 mod n.
  167|       |     *  px is a shorthand for sum(a[i]*a[x-i], i=0..x).
  168|       |     *  Note that [x 0 0 0 0 0] = [x*R].
  169|       |     */
  170|       |
  171|  17.3M|    secp256k1_u128_mul(&d, a0*2, a3);
  172|  17.3M|    secp256k1_u128_accum_mul(&d, a1*2, a2);
  173|  17.3M|    VERIFY_BITS_128(&d, 114);
  174|       |    /* [d 0 0 0] = [p3 0 0 0] */
  175|  17.3M|    secp256k1_u128_mul(&c, a4, a4);
  176|  17.3M|    VERIFY_BITS_128(&c, 112);
  177|       |    /* [c 0 0 0 0 d 0 0 0] = [p8 0 0 0 0 p3 0 0 0] */
  178|  17.3M|    secp256k1_u128_accum_mul(&d, R, secp256k1_u128_to_u64(&c)); secp256k1_u128_rshift(&c, 64);
  179|  17.3M|    VERIFY_BITS_128(&d, 115);
  180|  17.3M|    VERIFY_BITS_128(&c, 48);
  181|       |    /* [(c<<12) 0 0 0 0 0 d 0 0 0] = [p8 0 0 0 0 p3 0 0 0] */
  182|  17.3M|    t3 = secp256k1_u128_to_u64(&d) & M; secp256k1_u128_rshift(&d, 52);
  183|  17.3M|    VERIFY_BITS(t3, 52);
  184|  17.3M|    VERIFY_BITS_128(&d, 63);
  185|       |    /* [(c<<12) 0 0 0 0 d t3 0 0 0] = [p8 0 0 0 0 p3 0 0 0] */
  186|       |
  187|  17.3M|    a4 *= 2;
  188|  17.3M|    secp256k1_u128_accum_mul(&d, a0, a4);
  189|  17.3M|    secp256k1_u128_accum_mul(&d, a1*2, a3);
  190|  17.3M|    secp256k1_u128_accum_mul(&d, a2, a2);
  191|  17.3M|    VERIFY_BITS_128(&d, 115);
  192|       |    /* [(c<<12) 0 0 0 0 d t3 0 0 0] = [p8 0 0 0 p4 p3 0 0 0] */
  193|  17.3M|    secp256k1_u128_accum_mul(&d, R << 12, secp256k1_u128_to_u64(&c));
  194|  17.3M|    VERIFY_BITS_128(&d, 116);
  195|       |    /* [d t3 0 0 0] = [p8 0 0 0 p4 p3 0 0 0] */
  196|  17.3M|    t4 = secp256k1_u128_to_u64(&d) & M; secp256k1_u128_rshift(&d, 52);
  197|  17.3M|    VERIFY_BITS(t4, 52);
  198|  17.3M|    VERIFY_BITS_128(&d, 64);
  199|       |    /* [d t4 t3 0 0 0] = [p8 0 0 0 p4 p3 0 0 0] */
  200|  17.3M|    tx = (t4 >> 48); t4 &= (M >> 4);
  201|  17.3M|    VERIFY_BITS(tx, 4);
  202|  17.3M|    VERIFY_BITS(t4, 48);
  203|       |    /* [d t4+(tx<<48) t3 0 0 0] = [p8 0 0 0 p4 p3 0 0 0] */
  204|       |
  205|  17.3M|    secp256k1_u128_mul(&c, a0, a0);
  206|  17.3M|    VERIFY_BITS_128(&c, 112);
  207|       |    /* [d t4+(tx<<48) t3 0 0 c] = [p8 0 0 0 p4 p3 0 0 p0] */
  208|  17.3M|    secp256k1_u128_accum_mul(&d, a1, a4);
  209|  17.3M|    secp256k1_u128_accum_mul(&d, a2*2, a3);
  210|  17.3M|    VERIFY_BITS_128(&d, 114);
  211|       |    /* [d t4+(tx<<48) t3 0 0 c] = [p8 0 0 p5 p4 p3 0 0 p0] */
  212|  17.3M|    u0 = secp256k1_u128_to_u64(&d) & M; secp256k1_u128_rshift(&d, 52);
  213|  17.3M|    VERIFY_BITS(u0, 52);
  214|  17.3M|    VERIFY_BITS_128(&d, 62);
  215|       |    /* [d u0 t4+(tx<<48) t3 0 0 c] = [p8 0 0 p5 p4 p3 0 0 p0] */
  216|       |    /* [d 0 t4+(tx<<48)+(u0<<52) t3 0 0 c] = [p8 0 0 p5 p4 p3 0 0 p0] */
  217|  17.3M|    u0 = (u0 << 4) | tx;
  218|  17.3M|    VERIFY_BITS(u0, 56);
  219|       |    /* [d 0 t4+(u0<<48) t3 0 0 c] = [p8 0 0 p5 p4 p3 0 0 p0] */
  220|  17.3M|    secp256k1_u128_accum_mul(&c, u0, R >> 4);
  221|  17.3M|    VERIFY_BITS_128(&c, 113);
  222|       |    /* [d 0 t4 t3 0 0 c] = [p8 0 0 p5 p4 p3 0 0 p0] */
  223|  17.3M|    r[0] = secp256k1_u128_to_u64(&c) & M; secp256k1_u128_rshift(&c, 52);
  224|  17.3M|    VERIFY_BITS(r[0], 52);
  225|  17.3M|    VERIFY_BITS_128(&c, 61);
  226|       |    /* [d 0 t4 t3 0 c r0] = [p8 0 0 p5 p4 p3 0 0 p0] */
  227|       |
  228|  17.3M|    a0 *= 2;
  229|  17.3M|    secp256k1_u128_accum_mul(&c, a0, a1);
  230|  17.3M|    VERIFY_BITS_128(&c, 114);
  231|       |    /* [d 0 t4 t3 0 c r0] = [p8 0 0 p5 p4 p3 0 p1 p0] */
  232|  17.3M|    secp256k1_u128_accum_mul(&d, a2, a4);
  233|  17.3M|    secp256k1_u128_accum_mul(&d, a3, a3);
  234|  17.3M|    VERIFY_BITS_128(&d, 114);
  235|       |    /* [d 0 t4 t3 0 c r0] = [p8 0 p6 p5 p4 p3 0 p1 p0] */
  236|  17.3M|    secp256k1_u128_accum_mul(&c, secp256k1_u128_to_u64(&d) & M, R); secp256k1_u128_rshift(&d, 52);
  237|  17.3M|    VERIFY_BITS_128(&c, 115);
  238|  17.3M|    VERIFY_BITS_128(&d, 62);
  239|       |    /* [d 0 0 t4 t3 0 c r0] = [p8 0 p6 p5 p4 p3 0 p1 p0] */
  240|  17.3M|    r[1] = secp256k1_u128_to_u64(&c) & M; secp256k1_u128_rshift(&c, 52);
  241|  17.3M|    VERIFY_BITS(r[1], 52);
  242|  17.3M|    VERIFY_BITS_128(&c, 63);
  243|       |    /* [d 0 0 t4 t3 c r1 r0] = [p8 0 p6 p5 p4 p3 0 p1 p0] */
  244|       |
  245|  17.3M|    secp256k1_u128_accum_mul(&c, a0, a2);
  246|  17.3M|    secp256k1_u128_accum_mul(&c, a1, a1);
  247|  17.3M|    VERIFY_BITS_128(&c, 114);
  248|       |    /* [d 0 0 t4 t3 c r1 r0] = [p8 0 p6 p5 p4 p3 p2 p1 p0] */
  249|  17.3M|    secp256k1_u128_accum_mul(&d, a3, a4);
  250|  17.3M|    VERIFY_BITS_128(&d, 114);
  251|       |    /* [d 0 0 t4 t3 c r1 r0] = [p8 p7 p6 p5 p4 p3 p2 p1 p0] */
  252|  17.3M|    secp256k1_u128_accum_mul(&c, R, secp256k1_u128_to_u64(&d)); secp256k1_u128_rshift(&d, 64);
  253|  17.3M|    VERIFY_BITS_128(&c, 115);
  254|  17.3M|    VERIFY_BITS_128(&d, 50);
  255|       |    /* [(d<<12) 0 0 0 t4 t3 c r1 r0] = [p8 p7 p6 p5 p4 p3 p2 p1 p0] */
  256|  17.3M|    r[2] = secp256k1_u128_to_u64(&c) & M; secp256k1_u128_rshift(&c, 52);
  257|  17.3M|    VERIFY_BITS(r[2], 52);
  258|  17.3M|    VERIFY_BITS_128(&c, 63);
  259|       |    /* [(d<<12) 0 0 0 t4 t3+c r2 r1 r0] = [p8 p7 p6 p5 p4 p3 p2 p1 p0] */
  260|       |
  261|  17.3M|    secp256k1_u128_accum_mul(&c, R << 12, secp256k1_u128_to_u64(&d));
  262|  17.3M|    secp256k1_u128_accum_u64(&c, t3);
  263|  17.3M|    VERIFY_BITS_128(&c, 100);
  264|       |    /* [t4 c r2 r1 r0] = [p8 p7 p6 p5 p4 p3 p2 p1 p0] */
  265|  17.3M|    r[3] = secp256k1_u128_to_u64(&c) & M; secp256k1_u128_rshift(&c, 52);
  266|  17.3M|    VERIFY_BITS(r[3], 52);
  267|  17.3M|    VERIFY_BITS_128(&c, 48);
  268|       |    /* [t4+c r3 r2 r1 r0] = [p8 p7 p6 p5 p4 p3 p2 p1 p0] */
  269|  17.3M|    r[4] = secp256k1_u128_to_u64(&c) + t4;
  270|  17.3M|    VERIFY_BITS(r[4], 49);
  271|       |    /* [r4 r3 r2 r1 r0] = [p8 p7 p6 p5 p4 p3 p2 p1 p0] */
  272|  17.3M|}
