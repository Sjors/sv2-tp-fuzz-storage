secp256k1.c:secp256k1_ge_impl_is_in_correct_subgroup:
  969|  2.37k|SECP256K1_INLINE static int secp256k1_ge_impl_is_in_correct_subgroup(const secp256k1_ge* ge) {
  970|       |#ifdef EXHAUSTIVE_TEST_ORDER
  971|       |    secp256k1_gej out;
  972|       |    int i;
  973|       |
  974|       |    /* A very simple EC multiplication ladder that avoids a dependency on ecmult. */
  975|       |    secp256k1_gej_set_infinity(&out);
  976|       |    for (i = 0; i < 32; ++i) {
  977|       |        secp256k1_gej_double_var(&out, &out, NULL);
  978|       |        if ((((uint32_t)EXHAUSTIVE_TEST_ORDER) >> (31 - i)) & 1) {
  979|       |            secp256k1_gej_add_ge_var(&out, &out, ge, NULL);
  980|       |        }
  981|       |    }
  982|       |    return secp256k1_gej_is_infinity(&out);
  983|       |#else
  984|  2.37k|    (void)ge;
  985|       |    /* The real secp256k1 group has cofactor 1, so the subgroup is the entire curve. */
  986|  2.37k|    return 1;
  987|  2.37k|#endif
  988|  2.37k|}
