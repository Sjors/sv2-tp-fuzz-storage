  154|  4.95M|SECP256K1_INLINE static void secp256k1_fe_sqr_inner(uint64_t *r, const uint64_t *a) {
  155|  4.95M|    secp256k1_uint128 c, d;
  156|  4.95M|    uint64_t a0 = a[0], a1 = a[1], a2 = a[2], a3 = a[3], a4 = a[4];
  157|  4.95M|    uint64_t t3, t4, tx, u0;
  158|  4.95M|    const uint64_t M = 0xFFFFFFFFFFFFFULL, R = 0x1000003D10ULL;
  159|       |
  160|  4.95M|    VERIFY_BITS(a[0], 56);
  161|  4.95M|    VERIFY_BITS(a[1], 56);
  162|  4.95M|    VERIFY_BITS(a[2], 56);
  163|  4.95M|    VERIFY_BITS(a[3], 56);
  164|  4.95M|    VERIFY_BITS(a[4], 52);
  165|       |
  166|       |    /**  [... a b c] is a shorthand for ... + a<<104 + b<<52 + c<<0 mod n.
  167|       |     *  px is a shorthand for sum(a[i]*a[x-i], i=0..x).
  168|       |     *  Note that [x 0 0 0 0 0] = [x*R].
  169|       |     */
  170|       |
  171|  4.95M|    secp256k1_u128_mul(&d, a0*2, a3);
  172|  4.95M|    secp256k1_u128_accum_mul(&d, a1*2, a2);
  173|  4.95M|    VERIFY_BITS_128(&d, 114);
  174|       |    /* [d 0 0 0] = [p3 0 0 0] */
  175|  4.95M|    secp256k1_u128_mul(&c, a4, a4);
  176|  4.95M|    VERIFY_BITS_128(&c, 112);
  177|       |    /* [c 0 0 0 0 d 0 0 0] = [p8 0 0 0 0 p3 0 0 0] */
  178|  4.95M|    secp256k1_u128_accum_mul(&d, R, secp256k1_u128_to_u64(&c)); secp256k1_u128_rshift(&c, 64);
  179|  4.95M|    VERIFY_BITS_128(&d, 115);
  180|  4.95M|    VERIFY_BITS_128(&c, 48);
  181|       |    /* [(c<<12) 0 0 0 0 0 d 0 0 0] = [p8 0 0 0 0 p3 0 0 0] */
  182|  4.95M|    t3 = secp256k1_u128_to_u64(&d) & M; secp256k1_u128_rshift(&d, 52);
  183|  4.95M|    VERIFY_BITS(t3, 52);
  184|  4.95M|    VERIFY_BITS_128(&d, 63);
  185|       |    /* [(c<<12) 0 0 0 0 d t3 0 0 0] = [p8 0 0 0 0 p3 0 0 0] */
  186|       |
  187|  4.95M|    a4 *= 2;
  188|  4.95M|    secp256k1_u128_accum_mul(&d, a0, a4);
  189|  4.95M|    secp256k1_u128_accum_mul(&d, a1*2, a3);
  190|  4.95M|    secp256k1_u128_accum_mul(&d, a2, a2);
  191|  4.95M|    VERIFY_BITS_128(&d, 115);
  192|       |    /* [(c<<12) 0 0 0 0 d t3 0 0 0] = [p8 0 0 0 p4 p3 0 0 0] */
  193|  4.95M|    secp256k1_u128_accum_mul(&d, R << 12, secp256k1_u128_to_u64(&c));
  194|  4.95M|    VERIFY_BITS_128(&d, 116);
  195|       |    /* [d t3 0 0 0] = [p8 0 0 0 p4 p3 0 0 0] */
  196|  4.95M|    t4 = secp256k1_u128_to_u64(&d) & M; secp256k1_u128_rshift(&d, 52);
  197|  4.95M|    VERIFY_BITS(t4, 52);
  198|  4.95M|    VERIFY_BITS_128(&d, 64);
  199|       |    /* [d t4 t3 0 0 0] = [p8 0 0 0 p4 p3 0 0 0] */
  200|  4.95M|    tx = (t4 >> 48); t4 &= (M >> 4);
