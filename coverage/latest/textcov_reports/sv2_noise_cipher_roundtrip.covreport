  111|  49.7k|    r1 += modinfo->modulus.v[1] & cond_add;
  112|  49.7k|    r2 += modinfo->modulus.v[2] & cond_add;
  113|  49.7k|    r3 += modinfo->modulus.v[3] & cond_add;
  114|  49.7k|    r4 += modinfo->modulus.v[4] & cond_add;
  115|  49.7k|    cond_negate = sign >> 63;
