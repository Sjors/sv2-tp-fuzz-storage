  521|  4.55k|    secp256k1_sha256_write(hash_ctx, &sha, ell_b64, 64);
  522|  4.55k|    secp256k1_sha256_write(hash_ctx, &sha, x32, 32);
  523|  4.55k|    secp256k1_sha256_finalize(hash_ctx, &sha, output);
  524|  4.55k|    secp256k1_sha256_clear(&sha);
  525|       |
  526|  4.55k|    return 1;
  527|  4.55k|}
