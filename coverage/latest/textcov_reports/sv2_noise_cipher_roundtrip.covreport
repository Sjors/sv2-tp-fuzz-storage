  |  |  |  Branch (71:9): [Folded, False: 32.7k]
  |  |  ------------------
  ------------------
  993|  32.7k|    memcpy(&s, buf, 64);
  994|  32.7k|    secp256k1_ge_from_storage(r, &s);
  995|  32.7k|}
