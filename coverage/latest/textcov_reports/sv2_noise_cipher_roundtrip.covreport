  ------------------
  230|  11.9k|        const size_t n_blocks = len / 64;
  231|  11.9k|        const size_t advance = n_blocks * 64;
  232|  11.9k|        hash_ctx->fn_sha256_compression(hash->s, data, n_blocks);
  233|  11.9k|        data += advance;
  234|  11.9k|        len -= advance;
  235|  11.9k|    }
