   95|  19.2M|    VERIFY_BITS(u0, 56);
   96|       |    /* [d 0 t4+(u0<<48) t3 0 0 c] = [p8 0 0 p5 p4 p3 0 0 p0] */
   97|  19.2M|    secp256k1_u128_accum_mul(&c, u0, R >> 4);
   98|  19.2M|    VERIFY_BITS_128(&c, 113);
   99|       |    /* [d 0 t4 t3 0 0 c] = [p8 0 0 p5 p4 p3 0 0 p0] */
  100|  19.2M|    r[0] = secp256k1_u128_to_u64(&c) & M; secp256k1_u128_rshift(&c, 52);
  101|  19.2M|    VERIFY_BITS(r[0], 52);
  102|  19.2M|    VERIFY_BITS_128(&c, 61);
  103|       |    /* [d 0 t4 t3 0 c r0] = [p8 0 0 p5 p4 p3 0 0 p0] */
  104|       |
  105|  19.2M|    secp256k1_u128_accum_mul(&c, a0, b[1]);
  106|  19.2M|    secp256k1_u128_accum_mul(&c, a1, b[0]);
  107|  19.2M|    VERIFY_BITS_128(&c, 114);
  108|       |    /* [d 0 t4 t3 0 c r0] = [p8 0 0 p5 p4 p3 0 p1 p0] */
  109|  19.2M|    secp256k1_u128_accum_mul(&d, a2, b[4]);
  110|  19.2M|    secp256k1_u128_accum_mul(&d, a3, b[3]);
  111|  19.2M|    secp256k1_u128_accum_mul(&d, a4, b[2]);
  112|  19.2M|    VERIFY_BITS_128(&d, 114);
  113|       |    /* [d 0 t4 t3 0 c r0] = [p8 0 p6 p5 p4 p3 0 p1 p0] */
  114|  19.2M|    secp256k1_u128_accum_mul(&c, secp256k1_u128_to_u64(&d) & M, R); secp256k1_u128_rshift(&d, 52);
  115|  19.2M|    VERIFY_BITS_128(&c, 115);
  116|  19.2M|    VERIFY_BITS_128(&d, 62);
  117|       |    /* [d 0 0 t4 t3 0 c r0] = [p8 0 p6 p5 p4 p3 0 p1 p0] */
  118|  19.2M|    r[1] = secp256k1_u128_to_u64(&c) & M; secp256k1_u128_rshift(&c, 52);
  119|  19.2M|    VERIFY_BITS(r[1], 52);
  120|  19.2M|    VERIFY_BITS_128(&c, 63);
  121|       |    /* [d 0 0 t4 t3 c r1 r0] = [p8 0 p6 p5 p4 p3 0 p1 p0] */
  122|       |
  123|  19.2M|    secp256k1_u128_accum_mul(&c, a0, b[2]);
  124|  19.2M|    secp256k1_u128_accum_mul(&c, a1, b[1]);
  125|  19.2M|    secp256k1_u128_accum_mul(&c, a2, b[0]);
  126|  19.2M|    VERIFY_BITS_128(&c, 114);
  127|       |    /* [d 0 0 t4 t3 c r1 r0] = [p8 0 p6 p5 p4 p3 p2 p1 p0] */
  128|  19.2M|    secp256k1_u128_accum_mul(&d, a3, b[4]);
  129|  19.2M|    secp256k1_u128_accum_mul(&d, a4, b[3]);
  130|  19.2M|    VERIFY_BITS_128(&d, 114);
  131|       |    /* [d 0 0 t4 t3 c t1 r0] = [p8 p7 p6 p5 p4 p3 p2 p1 p0] */
  132|  19.2M|    secp256k1_u128_accum_mul(&c, R, secp256k1_u128_to_u64(&d)); secp256k1_u128_rshift(&d, 64);
  133|  19.2M|    VERIFY_BITS_128(&c, 115);
  134|  19.2M|    VERIFY_BITS_128(&d, 50);
  135|       |    /* [(d<<12) 0 0 0 t4 t3 c r1 r0] = [p8 p7 p6 p5 p4 p3 p2 p1 p0] */
  136|       |
  137|  19.2M|    r[2] = secp256k1_u128_to_u64(&c) & M; secp256k1_u128_rshift(&c, 52);
  138|  19.2M|    VERIFY_BITS(r[2], 52);
  139|  19.2M|    VERIFY_BITS_128(&c, 63);
  140|       |    /* [(d<<12) 0 0 0 t4 t3+c r2 r1 r0] = [p8 p7 p6 p5 p4 p3 p2 p1 p0] */
