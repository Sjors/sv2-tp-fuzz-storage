  |  |   18|  52.8k|#define SECP256K1_N_2 ((uint64_t)0xFFFFFFFFFFFFFFFEULL)
  ------------------
   68|  52.8k|    no |= (a->d[1] < SECP256K1_N_1);
  ------------------
  |  |   17|  52.8k|#define SECP256K1_N_1 ((uint64_t)0xBAAEDCE6AF48A03BULL)
