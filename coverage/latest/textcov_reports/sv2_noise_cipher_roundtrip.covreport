  213|   175k|    hash->bytes += len;
  214|   175k|    VERIFY_CHECK(hash->bytes >= len);
  215|   175k|    VERIFY_CHECK(hash_ctx != NULL);
  216|   175k|    VERIFY_CHECK(hash_ctx->fn_sha256_compression != NULL);
  217|       |
  218|       |    /* If we exceed the 64-byte block size with this input, process it and wipe the buffer */
  219|   175k|    chunk_len = 64 - bufsize;
  220|   175k|    if (bufsize && len >= chunk_len) {
  ------------------
  |  Branch (220:9): [True: 129k, False: 46.1k]
  |  Branch (220:20): [True: 56.9k, False: 72.4k]
  ------------------
  221|  56.9k|        memcpy(hash->buf + bufsize, data, chunk_len);
  222|  56.9k|        data += chunk_len;
  223|  56.9k|        len -= chunk_len;
  224|  56.9k|        hash_ctx->fn_sha256_compression(hash->s, hash->buf, 1);
  225|  56.9k|        bufsize = 0;
  226|  56.9k|    }
  227|       |
