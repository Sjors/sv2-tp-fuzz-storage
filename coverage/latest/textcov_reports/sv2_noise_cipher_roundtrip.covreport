secp256k1.c:secp256k1_modinv64_divsteps_62_var:
  239|  79.1k|static int64_t secp256k1_modinv64_divsteps_62_var(int64_t eta, uint64_t f0, uint64_t g0, secp256k1_modinv64_trans2x2 *t) {
  240|       |    /* Transformation matrix; see comments in secp256k1_modinv64_divsteps_62. */
  241|  79.1k|    uint64_t u = 1, v = 0, q = 0, r = 1;
  242|  79.1k|    uint64_t f = f0, g = g0, m;
  243|  79.1k|    uint32_t w;
  244|  79.1k|    int i = 62, limit, zeros;
  245|       |
  246|  1.29M|    for (;;) {
  247|       |        /* Use a sentinel bit to count zeros only up to i. */
  248|  1.29M|        zeros = secp256k1_ctz64_var(g | (UINT64_MAX << i));
  249|       |        /* Perform zeros divsteps at once; they all just divide g by two. */
  250|  1.29M|        g >>= zeros;
  251|  1.29M|        u <<= zeros;
  252|  1.29M|        v <<= zeros;
  253|  1.29M|        eta -= zeros;
  254|  1.29M|        i -= zeros;
  255|       |        /* We're done once we've done 62 divsteps. */
  256|  1.29M|        if (i == 0) break;
  ------------------
  |  Branch (256:13): [True: 79.1k, False: 1.21M]
  ------------------
  257|  1.21M|        VERIFY_CHECK((f & 1) == 1);
  258|  1.21M|        VERIFY_CHECK((g & 1) == 1);
  259|  1.21M|        VERIFY_CHECK((u * f0 + v * g0) == f << (62 - i));
  260|  1.21M|        VERIFY_CHECK((q * f0 + r * g0) == g << (62 - i));
  261|       |        /* Bounds on eta that follow from the bounds on iteration count (max 12*62 divsteps). */
  262|  1.21M|        VERIFY_CHECK(eta >= -745 && eta <= 745);
  263|       |        /* If eta is negative, negate it and replace f,g with g,-f. */
  264|  1.21M|        if (eta < 0) {
  ------------------
  |  Branch (264:13): [True: 1.17M, False: 42.3k]
  ------------------
  265|  1.17M|            uint64_t tmp;
  266|  1.17M|            eta = -eta;
  267|  1.17M|            tmp = f; f = g; g = -tmp;
  268|  1.17M|            tmp = u; u = q; q = -tmp;
  269|  1.17M|            tmp = v; v = r; r = -tmp;
  270|       |            /* Use a formula to cancel out up to 6 bits of g. Also, no more than i can be cancelled
  271|       |             * out (as we'd be done before that point), and no more than eta+1 can be done as its
  272|       |             * sign will flip again once that happens. */
  273|  1.17M|            limit = ((int)eta + 1) > i ? i : ((int)eta + 1);
  ------------------
  |  Branch (273:21): [True: 23.5k, False: 1.15M]
  ------------------
  274|  1.17M|            VERIFY_CHECK(limit > 0 && limit <= 62);
  275|       |            /* m is a mask for the bottom min(limit, 6) bits. */
  276|  1.17M|            m = (UINT64_MAX >> (64 - limit)) & 63U;
  277|       |            /* Find what multiple of f must be added to g to cancel its bottom min(limit, 6)
  278|       |             * bits. */
  279|  1.17M|            w = (f * g * (f * f - 2)) & m;
  280|  1.17M|        } else {
  281|       |            /* In this branch, use a simpler formula that only lets us cancel up to 4 bits of g, as
  282|       |             * eta tends to be smaller here. */
  283|  42.3k|            limit = ((int)eta + 1) > i ? i : ((int)eta + 1);
  ------------------
  |  Branch (283:21): [True: 283, False: 42.0k]
  ------------------
  284|  42.3k|            VERIFY_CHECK(limit > 0 && limit <= 62);
  285|       |            /* m is a mask for the bottom min(limit, 4) bits. */
  286|  42.3k|            m = (UINT64_MAX >> (64 - limit)) & 15U;
  287|       |            /* Find what multiple of f must be added to g to cancel its bottom min(limit, 4)
  288|       |             * bits. */
  289|  42.3k|            w = f + (((f + 1) & 4) << 1);
  290|  42.3k|            w = (-w * g) & m;
  291|  42.3k|        }
  292|  1.21M|        g += f * w;
  293|  1.21M|        q += u * w;
  294|  1.21M|        r += v * w;
  295|  1.21M|        VERIFY_CHECK((g & m) == 0);
  296|  1.21M|    }
  297|       |    /* Return data in t and return value. */
  298|  79.1k|    t->u = (int64_t)u;
  299|  79.1k|    t->v = (int64_t)v;
  300|  79.1k|    t->q = (int64_t)q;
  301|  79.1k|    t->r = (int64_t)r;
  302|       |
  303|       |    /* The determinant of t must be a power of two. This guarantees that multiplication with t
  304|       |     * does not change the gcd of f and g, apart from adding a power-of-2 factor to it (which
  305|       |     * will be divided out again). As each divstep's individual matrix has determinant 2, the
  306|       |     * aggregate of 62 of them will have determinant 2^62. */
  307|  79.1k|    VERIFY_CHECK(secp256k1_modinv64_det_check_pow2(t, 62, 0));
  308|       |
  309|  79.1k|    return eta;
  310|  79.1k|}
