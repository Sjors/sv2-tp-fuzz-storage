  701|  43.7k|    "xorq %%r9, %%r9\n"
  702|  43.7k|    "xorq %%r10, %%r10\n"
  703|       |    /* (r8,r9,r10) += a0 * b1 */
  704|  43.7k|    "movq %%r15, %%rax\n"
  705|  43.7k|    "mulq %%r12\n"
  706|  43.7k|    "addq %%rax, %%r8\n"
  707|  43.7k|    "adcq %%rdx, %%r9\n"
  708|  43.7k|    "adcq $0, %%r10\n"
  709|       |    /* (r8,r9,r10) += a1 * b0 */
