  117|  49.7k|    r1 = (r1 ^ cond_negate) - cond_negate;
  118|  49.7k|    r2 = (r2 ^ cond_negate) - cond_negate;
  119|  49.7k|    r3 = (r3 ^ cond_negate) - cond_negate;
  120|  49.7k|    r4 = (r4 ^ cond_negate) - cond_negate;
