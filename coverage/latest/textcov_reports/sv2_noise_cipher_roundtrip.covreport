  959|       |    /* We want to determine whether (xn/xd) is on the curve.
  960|       |     *
  961|       |     * (xn/xd)^3 + 7 is square <=> xd*xn^3 + 7*xd^4 is square (multiplying by xd^4, a square).
  962|       |     */
  963|  10.0k|     secp256k1_fe r, t;
  964|  10.0k|     VERIFY_CHECK(!secp256k1_fe_normalizes_to_zero_var(xd));
  965|       |
  966|  10.0k|     secp256k1_fe_mul(&r, xd, xn); /* r = xd*xn */
  ------------------
  |  |   93|  10.0k|#  define secp256k1_fe_mul secp256k1_fe_impl_mul
  ------------------
  967|  10.0k|     secp256k1_fe_sqr(&t, xn); /* t = xn^2 */
  ------------------
  |  |   94|  10.0k|#  define secp256k1_fe_sqr secp256k1_fe_impl_sqr
  ------------------
  968|  10.0k|     secp256k1_fe_mul(&r, &r, &t); /* r = xd*xn^3 */
  ------------------
  |  |   93|  10.0k|#  define secp256k1_fe_mul secp256k1_fe_impl_mul
  ------------------
  969|  10.0k|     secp256k1_fe_sqr(&t, xd); /* t = xd^2 */
  ------------------
  |  |   94|  10.0k|#  define secp256k1_fe_sqr secp256k1_fe_impl_sqr
  ------------------
  970|  10.0k|     secp256k1_fe_sqr(&t, &t); /* t = xd^4 */
  ------------------
  |  |   94|  10.0k|#  define secp256k1_fe_sqr secp256k1_fe_impl_sqr
  ------------------
  971|  10.0k|     VERIFY_CHECK(SECP256K1_B <= 31);
  972|  10.0k|     secp256k1_fe_mul_int(&t, SECP256K1_B); /* t = 7*xd^4 */
  ------------------
  |  |  233|  10.0k|#define secp256k1_fe_mul_int(r, a) ASSERT_INT_CONST_AND_DO(a, secp256k1_fe_mul_int_unchecked(r, a))
  |  |  ------------------
  |  |  |  |   77|  10.0k|#define ASSERT_INT_CONST_AND_DO(expr, stmt) do { \
  |  |  |  |   78|  10.0k|    switch(42) { \
  |  |  |  |   79|      0|        /* C allows only integer constant expressions as case labels. */ \
  |  |  |  |   80|      0|        case /* ERROR: integer argument is not constant */ (expr): \
  |  |  |  |  ------------------
  |  |  |  |  |  Branch (80:9): [True: 0, False: 10.0k]
  |  |  |  |  ------------------
  |  |  |  |   81|      0|            break; \
  |  |  |  |   82|  10.0k|        default: ; \
  |  |  |  |  ------------------
  |  |  |  |  |  Branch (82:9): [True: 10.0k, False: 0]
  |  |  |  |  ------------------
  |  |  |  |   83|  10.0k|    } \
  |  |  |  |   84|  10.0k|    stmt; \
  |  |  |  |   85|  10.0k|} while(0)
  |  |  |  |  ------------------
  |  |  |  |  |  Branch (85:9): [Folded, False: 10.0k]
  |  |  |  |  ------------------
  |  |  ------------------
  ------------------
  973|  10.0k|     secp256k1_fe_add(&r, &t); /* r = xd*xn^3 + 7*xd^4 */
  ------------------
  |  |   92|  10.0k|#  define secp256k1_fe_add secp256k1_fe_impl_add
  ------------------
  974|  10.0k|     return secp256k1_fe_is_square_var(&r);
  ------------------
  |  |  103|  10.0k|#  define secp256k1_fe_is_square_var secp256k1_fe_impl_is_square_var
  ------------------
  975|  10.0k|}

