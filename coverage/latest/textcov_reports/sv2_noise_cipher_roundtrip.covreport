  553|   187k|static void secp256k1_modinv64_update_fg_62_var(int len, secp256k1_modinv64_signed62 *f, secp256k1_modinv64_signed62 *g, const secp256k1_modinv64_trans2x2 *t) {
  554|   187k|    const uint64_t M62 = UINT64_MAX >> 2;
  555|   187k|    const int64_t u = t->u, v = t->v, q = t->q, r = t->r;
  556|   187k|    int64_t fi, gi;
