  212|  19.1M|    u0 = secp256k1_u128_to_u64(&d) & M; secp256k1_u128_rshift(&d, 52);
  213|  19.1M|    VERIFY_BITS(u0, 52);
  214|  19.1M|    VERIFY_BITS_128(&d, 62);
