secp256k1.c:secp256k1_scalar_half:
  195|  5.47k|static void secp256k1_scalar_half(secp256k1_scalar *r, const secp256k1_scalar *a) {
  196|       |    /* Writing `/` for field division and `//` for integer division, we compute
  197|       |     *
  198|       |     *   a/2 = (a - (a&1))/2 + (a&1)/2
  199|       |     *       = (a >> 1) + (a&1 ?    1/2 : 0)
  200|       |     *       = (a >> 1) + (a&1 ? n//2+1 : 0),
  201|       |     *
  202|       |     * where n is the group order and in the last equality we have used 1/2 = n//2+1 (mod n).
  203|       |     * For n//2, we have the constants SECP256K1_N_H_0, ...
  204|       |     *
  205|       |     * This sum does not overflow. The most extreme case is a = -2, the largest odd scalar. Here:
  206|       |     * - the left summand is:  a >> 1 = (a - a&1)/2 = (n-2-1)//2           = (n-3)//2
  207|       |     * - the right summand is: a&1 ? n//2+1 : 0 = n//2+1 = (n-1)//2 + 2//2 = (n+1)//2
  208|       |     * Together they sum to (n-3)//2 + (n+1)//2 = (2n-2)//2 = n - 1, which is less than n.
  209|       |     */
  210|  5.47k|    uint64_t mask = -(uint64_t)(a->d[0] & 1U);
  211|  5.47k|    secp256k1_uint128 t;
  212|  5.47k|    SECP256K1_SCALAR_VERIFY(a);
  ------------------
  |  |  103|  5.47k|#define SECP256K1_SCALAR_VERIFY(r) secp256k1_scalar_verify(r)
  ------------------
  213|       |
  214|  5.47k|    secp256k1_u128_from_u64(&t, (a->d[0] >> 1) | (a->d[1] << 63));
  215|  5.47k|    secp256k1_u128_accum_u64(&t, (SECP256K1_N_H_0 + 1U) & mask);
  ------------------
  |  |   27|  5.47k|#define SECP256K1_N_H_0 ((uint64_t)0xDFE92F46681B20A0ULL)
  ------------------
  216|  5.47k|    r->d[0] = secp256k1_u128_to_u64(&t); secp256k1_u128_rshift(&t, 64);
  217|  5.47k|    secp256k1_u128_accum_u64(&t, (a->d[1] >> 1) | (a->d[2] << 63));
  218|  5.47k|    secp256k1_u128_accum_u64(&t, SECP256K1_N_H_1 & mask);
  ------------------
  |  |   28|  5.47k|#define SECP256K1_N_H_1 ((uint64_t)0x5D576E7357A4501DULL)
  ------------------
  219|  5.47k|    r->d[1] = secp256k1_u128_to_u64(&t); secp256k1_u128_rshift(&t, 64);
  220|  5.47k|    secp256k1_u128_accum_u64(&t, (a->d[2] >> 1) | (a->d[3] << 63));
  221|  5.47k|    secp256k1_u128_accum_u64(&t, SECP256K1_N_H_2 & mask);
  ------------------
  |  |   29|  5.47k|#define SECP256K1_N_H_2 ((uint64_t)0xFFFFFFFFFFFFFFFFULL)
  ------------------
  222|  5.47k|    r->d[2] = secp256k1_u128_to_u64(&t); secp256k1_u128_rshift(&t, 64);
  223|  5.47k|    r->d[3] = secp256k1_u128_to_u64(&t) + (a->d[3] >> 1) + (SECP256K1_N_H_3 & mask);
  ------------------
  |  |   30|  5.47k|#define SECP256K1_N_H_3 ((uint64_t)0x7FFFFFFFFFFFFFFFULL)
  ------------------
  224|       |#ifdef VERIFY
  225|       |    /* The line above only computed the bottom 64 bits of r->d[3]; redo the computation
  226|       |     * in full 128 bits to make sure the top 64 bits are indeed zero. */
  227|       |    secp256k1_u128_accum_u64(&t, a->d[3] >> 1);
  228|       |    secp256k1_u128_accum_u64(&t, SECP256K1_N_H_3 & mask);
  229|       |    secp256k1_u128_rshift(&t, 64);
  230|       |    VERIFY_CHECK(secp256k1_u128_to_u64(&t) == 0);
  231|       |
  232|       |    SECP256K1_SCALAR_VERIFY(r);
  233|       |#endif
  234|  5.47k|}
