  721|  38.9k|static int secp256k1_jacobi64_maybe_var(const secp256k1_modinv64_signed62 *x, const secp256k1_modinv64_modinfo *modinfo) {
  722|       |    /* Start with f=modulus, g=x, eta=-1. */
  723|  38.9k|    secp256k1_modinv64_signed62 f = modinfo->modulus;
  724|  38.9k|    secp256k1_modinv64_signed62 g = *x;
  725|  38.9k|    int j, len = 5;
  726|  38.9k|    int64_t eta = -1; /* eta = -delta; delta is initially 1 */
  727|  38.9k|    int64_t cond, fn, gn;
  728|  38.9k|    int jac = 0;
  729|  38.9k|    int count;
  730|       |
  731|       |    /* The input limbs must all be non-negative. */
  732|  38.9k|    VERIFY_CHECK(g.v[0] >= 0 && g.v[1] >= 0 && g.v[2] >= 0 && g.v[3] >= 0 && g.v[4] >= 0);
  733|       |
  734|       |    /* If x > 0, then if the loop below converges, it converges to f=g=gcd(x,modulus). Since we
  735|       |     * require that gcd(x,modulus)=1 and modulus>=3, x cannot be 0. Thus, we must reach f=1 (or
  736|       |     * time out). */
