  308|       |     * will be divided out again). As each divstep's individual matrix has determinant 2, the
  309|       |     * aggregate of 62 of them will have determinant 2^62. */
  310|   103k|    VERIFY_CHECK(secp256k1_modinv64_det_check_pow2(t, 62, 0));
  311|       |
  312|   103k|    return eta;
  313|   103k|}
