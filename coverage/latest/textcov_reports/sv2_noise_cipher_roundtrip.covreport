   88|  54.5k|static void secp256k1_modinv64_normalize_62(secp256k1_modinv64_signed62 *r, int64_t sign, const secp256k1_modinv64_modinfo *modinfo) {
   89|  54.5k|    const int64_t M62 = (int64_t)(UINT64_MAX >> 2);
   90|  54.5k|    int64_t r0 = r->v[0], r1 = r->v[1], r2 = r->v[2], r3 = r->v[3], r4 = r->v[4];
   91|  54.5k|    int64_t cond_negate;
   92|  54.5k|    volatile int64_t vcond_add, vcond_negate;
   93|       |
   94|       |#ifdef VERIFY
   95|       |    /* Verify that all limbs are in range (-2^62,2^62). */
   96|       |    int i;
   97|       |    for (i = 0; i < 5; ++i) {
   98|       |        VERIFY_CHECK(r->v[i] >= -M62);
   99|       |        VERIFY_CHECK(r->v[i] <= M62);
  100|       |    }
  101|       |    VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(r, 5, &modinfo->modulus, -2) > 0); /* r > -2*modulus */
  102|       |    VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(r, 5, &modinfo->modulus, 1) < 0); /* r < modulus */
  103|       |#endif
  104|       |
  105|       |    /* In a first step, add the modulus if the input is negative, and then negate if requested.
  106|       |     * This brings r from range (-2*modulus,modulus) to range (-modulus,modulus). As all input
  107|       |     * limbs are in range (-2^62,2^62), this cannot overflow an int64_t. Note that the right
  108|       |     * shifts below are signed sign-extending shifts (see assumptions.h for tests that that is
  109|       |     * indeed the behavior of the right shift operator). */
  110|  54.5k|    vcond_add = r4 >> 63;
  111|  54.5k|    r0 += modinfo->modulus.v[0] & vcond_add;
  112|  54.5k|    r1 += modinfo->modulus.v[1] & vcond_add;
  113|  54.5k|    r2 += modinfo->modulus.v[2] & vcond_add;
  114|  54.5k|    r3 += modinfo->modulus.v[3] & vcond_add;
  115|  54.5k|    r4 += modinfo->modulus.v[4] & vcond_add;
  116|  54.5k|    vcond_negate = sign >> 63;
  117|       |    /* Unsequenced reads to volatile variables are UB, so copy to a non-volatile variable first.*/
  118|  54.5k|    cond_negate = vcond_negate;
  119|  54.5k|    r0 = (r0 ^ cond_negate) - cond_negate;
  120|  54.5k|    r1 = (r1 ^ cond_negate) - cond_negate;
  121|  54.5k|    r2 = (r2 ^ cond_negate) - cond_negate;
  122|  54.5k|    r3 = (r3 ^ cond_negate) - cond_negate;
  123|  54.5k|    r4 = (r4 ^ cond_negate) - cond_negate;
  124|       |    /* Propagate the top bits, to bring limbs back to range (-2^62,2^62). */
  125|  54.5k|    r1 += r0 >> 62; r0 &= M62;
  126|  54.5k|    r2 += r1 >> 62; r1 &= M62;
  127|  54.5k|    r3 += r2 >> 62; r2 &= M62;
  128|  54.5k|    r4 += r3 >> 62; r3 &= M62;
  129|       |
  130|       |    /* In a second step add the modulus again if the result is still negative, bringing
  131|       |     * r to range [0,modulus). */
  132|  54.5k|    vcond_add = r4 >> 63;
  133|  54.5k|    r0 += modinfo->modulus.v[0] & vcond_add;
  134|  54.5k|    r1 += modinfo->modulus.v[1] & vcond_add;
  135|  54.5k|    r2 += modinfo->modulus.v[2] & vcond_add;
  136|  54.5k|    r3 += modinfo->modulus.v[3] & vcond_add;
  137|  54.5k|    r4 += modinfo->modulus.v[4] & vcond_add;
  138|       |    /* And propagate again. */
  139|  54.5k|    r1 += r0 >> 62; r0 &= M62;
  140|  54.5k|    r2 += r1 >> 62; r1 &= M62;
  141|  54.5k|    r3 += r2 >> 62; r2 &= M62;
  142|  54.5k|    r4 += r3 >> 62; r3 &= M62;
  143|       |
  144|  54.5k|    r->v[0] = r0;
  145|  54.5k|    r->v[1] = r1;
  146|  54.5k|    r->v[2] = r2;
  147|  54.5k|    r->v[3] = r3;
  148|  54.5k|    r->v[4] = r4;
  149|       |
  150|  54.5k|    VERIFY_CHECK(r0 >> 62 == 0);
  151|  54.5k|    VERIFY_CHECK(r1 >> 62 == 0);
  152|  54.5k|    VERIFY_CHECK(r2 >> 62 == 0);
  153|  54.5k|    VERIFY_CHECK(r3 >> 62 == 0);
  154|  54.5k|    VERIFY_CHECK(r4 >> 62 == 0);
  155|  54.5k|    VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(r, 5, &modinfo->modulus, 0) >= 0); /* r >= 0 */
  156|  54.5k|    VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(r, 5, &modinfo->modulus, 1) < 0); /* r < modulus */
  157|  54.5k|}
secp256k1.c:secp256k1_modinv64:
  591|  43.0k|static void secp256k1_modinv64(secp256k1_modinv64_signed62 *x, const secp256k1_modinv64_modinfo *modinfo) {
  592|       |    /* Start with d=0, e=1, f=modulus, g=x, zeta=-1. */
  593|  43.0k|    secp256k1_modinv64_signed62 d = {{0, 0, 0, 0, 0}};
  594|  43.0k|    secp256k1_modinv64_signed62 e = {{1, 0, 0, 0, 0}};
  595|  43.0k|    secp256k1_modinv64_signed62 f = modinfo->modulus;
  596|  43.0k|    secp256k1_modinv64_signed62 g = *x;
  597|  43.0k|    int i;
  598|  43.0k|    int64_t zeta = -1; /* zeta = -(delta+1/2); delta starts at 1/2. */
  599|       |
  600|       |    /* Do 10 iterations of 59 divsteps each = 590 divsteps. This suffices for 256-bit inputs. */
  601|   473k|    for (i = 0; i < 10; ++i) {
  ------------------
  |  Branch (601:17): [True: 430k, False: 43.0k]
  ------------------
  602|       |        /* Compute transition matrix and new zeta after 59 divsteps. */
  603|   430k|        secp256k1_modinv64_trans2x2 t;
  604|   430k|        zeta = secp256k1_modinv64_divsteps_59(zeta, f.v[0], g.v[0], &t);
  605|       |        /* Update d,e using that transition matrix. */
  606|   430k|        secp256k1_modinv64_update_de_62(&d, &e, &t, modinfo);
  607|       |        /* Update f,g using that transition matrix. */
  608|   430k|        VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(&f, 5, &modinfo->modulus, -1) > 0); /* f > -modulus */
  609|   430k|        VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(&f, 5, &modinfo->modulus, 1) <= 0); /* f <= modulus */
  610|   430k|        VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(&g, 5, &modinfo->modulus, -1) > 0); /* g > -modulus */
  611|   430k|        VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(&g, 5, &modinfo->modulus, 1) < 0);  /* g <  modulus */
  612|       |
  613|   430k|        secp256k1_modinv64_update_fg_62(&f, &g, &t);
  614|       |
  615|   430k|        VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(&f, 5, &modinfo->modulus, -1) > 0); /* f > -modulus */
  616|   430k|        VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(&f, 5, &modinfo->modulus, 1) <= 0); /* f <= modulus */
  617|   430k|        VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(&g, 5, &modinfo->modulus, -1) > 0); /* g > -modulus */
  618|   430k|        VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(&g, 5, &modinfo->modulus, 1) < 0);  /* g <  modulus */
  619|   430k|    }
  620|       |
  621|       |    /* At this point sufficient iterations have been performed that g must have reached 0
  622|       |     * and (if g was not originally 0) f must now equal +/- GCD of the initial f, g
  623|       |     * values i.e. +/- 1, and d now contains +/- the modular inverse. */
  624|       |
  625|       |    /* g == 0 */
  626|  43.0k|    VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(&g, 5, &SECP256K1_SIGNED62_ONE, 0) == 0);
  627|       |    /* |f| == 1, or (x == 0 and d == 0 and f == modulus) */
  628|  43.0k|    VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(&f, 5, &SECP256K1_SIGNED62_ONE, -1) == 0 ||
  629|  43.0k|                 secp256k1_modinv64_mul_cmp_62(&f, 5, &SECP256K1_SIGNED62_ONE, 1) == 0 ||
  630|  43.0k|                 (secp256k1_modinv64_mul_cmp_62(x, 5, &SECP256K1_SIGNED62_ONE, 0) == 0 &&
  631|  43.0k|                  secp256k1_modinv64_mul_cmp_62(&d, 5, &SECP256K1_SIGNED62_ONE, 0) == 0 &&
  632|  43.0k|                  secp256k1_modinv64_mul_cmp_62(&f, 5, &modinfo->modulus, 1) == 0));
  633|       |
  634|       |    /* Optionally negate d, normalize to [0,modulus), and return it. */
  635|  43.0k|    secp256k1_modinv64_normalize_62(&d, f.v[4], modinfo);
  636|  43.0k|    *x = d;
  637|  43.0k|}
secp256k1.c:secp256k1_modinv64_divsteps_59:
  170|   430k|static int64_t secp256k1_modinv64_divsteps_59(int64_t zeta, uint64_t f0, uint64_t g0, secp256k1_modinv64_trans2x2 *t) {
  171|       |    /* u,v,q,r are the elements of the transformation matrix being built up,
  172|       |     * starting with the identity matrix times 8 (because the caller expects
  173|       |     * a result scaled by 2^62). Semantically they are signed integers
  174|       |     * in range [-2^62,2^62], but here represented as unsigned mod 2^64. This
  175|       |     * permits left shifting (which is UB for negative numbers). The range
  176|       |     * being inside [-2^63,2^63) means that casting to signed works correctly.
  177|       |     */
  178|   430k|    uint64_t u = 8, v = 0, q = 0, r = 8;
  179|   430k|    volatile uint64_t c1, c2;
  180|   430k|    uint64_t mask1, mask2, f = f0, g = g0, x, y, z;
  181|   430k|    int i;
  182|       |
  183|  25.8M|    for (i = 3; i < 62; ++i) {
  ------------------
  |  Branch (183:17): [True: 25.4M, False: 430k]
  ------------------
  184|  25.4M|        VERIFY_CHECK((f & 1) == 1); /* f must always be odd */
  185|  25.4M|        VERIFY_CHECK((u * f0 + v * g0) == f << i);
  186|  25.4M|        VERIFY_CHECK((q * f0 + r * g0) == g << i);
  187|       |        /* Compute conditional masks for (zeta < 0) and for (g & 1). */
  188|  25.4M|        c1 = zeta >> 63;
  189|  25.4M|        mask1 = c1;
  190|  25.4M|        c2 = g & 1;
  191|  25.4M|        mask2 = -c2;
  192|       |        /* Compute x,y,z, conditionally negated versions of f,u,v. */
  193|  25.4M|        x = (f ^ mask1) - mask1;
  194|  25.4M|        y = (u ^ mask1) - mask1;
  195|  25.4M|        z = (v ^ mask1) - mask1;
  196|       |        /* Conditionally add x,y,z to g,q,r. */
  197|  25.4M|        g += x & mask2;
  198|  25.4M|        q += y & mask2;
  199|  25.4M|        r += z & mask2;
  200|       |        /* In what follows, mask1 is a condition mask for (zeta < 0) and (g & 1). */
  201|  25.4M|        mask1 &= mask2;
  202|       |        /* Conditionally change zeta into -zeta-2 or zeta-1. */
  203|  25.4M|        zeta = (zeta ^ mask1) - 1;
  204|       |        /* Conditionally add g,q,r to f,u,v. */
  205|  25.4M|        f += g & mask1;
  206|  25.4M|        u += q & mask1;
  207|  25.4M|        v += r & mask1;
  208|       |        /* Shifts */
  209|  25.4M|        g >>= 1;
  210|  25.4M|        u <<= 1;
  211|  25.4M|        v <<= 1;
  212|       |        /* Bounds on zeta that follow from the bounds on iteration count (max 10*59 divsteps). */
  213|  25.4M|        VERIFY_CHECK(zeta >= -591 && zeta <= 591);
  214|  25.4M|    }
  215|       |    /* Return data in t and return value. */
  216|   430k|    t->u = (int64_t)u;
  217|   430k|    t->v = (int64_t)v;
  218|   430k|    t->q = (int64_t)q;
  219|   430k|    t->r = (int64_t)r;
  220|       |
  221|       |    /* The determinant of t must be a power of two. This guarantees that multiplication with t
  222|       |     * does not change the gcd of f and g, apart from adding a power-of-2 factor to it (which
  223|       |     * will be divided out again). As each divstep's individual matrix has determinant 2, the
  224|       |     * aggregate of 59 of them will have determinant 2^59. Multiplying with the initial
  225|       |     * 8*identity (which has determinant 2^6) means the overall outputs has determinant
  226|       |     * 2^65. */
  227|   430k|    VERIFY_CHECK(secp256k1_modinv64_det_check_pow2(t, 65, 0));
  228|       |
  229|   430k|    return zeta;
  230|   430k|}
secp256k1.c:secp256k1_modinv64_update_fg_62:
  503|   430k|static void secp256k1_modinv64_update_fg_62(secp256k1_modinv64_signed62 *f, secp256k1_modinv64_signed62 *g, const secp256k1_modinv64_trans2x2 *t) {
  504|   430k|    const uint64_t M62 = UINT64_MAX >> 2;
  505|   430k|    const int64_t f0 = f->v[0], f1 = f->v[1], f2 = f->v[2], f3 = f->v[3], f4 = f->v[4];
  506|   430k|    const int64_t g0 = g->v[0], g1 = g->v[1], g2 = g->v[2], g3 = g->v[3], g4 = g->v[4];
  507|   430k|    const int64_t u = t->u, v = t->v, q = t->q, r = t->r;
  508|   430k|    secp256k1_int128 cf, cg;
  509|       |    /* Start computing t*[f,g]. */
  510|   430k|    secp256k1_i128_mul(&cf, u, f0);
  511|   430k|    secp256k1_i128_accum_mul(&cf, v, g0);
  512|   430k|    secp256k1_i128_mul(&cg, q, f0);
  513|   430k|    secp256k1_i128_accum_mul(&cg, r, g0);
  514|       |    /* Verify that the bottom 62 bits of the result are zero, and then throw them away. */
  515|   430k|    VERIFY_CHECK((secp256k1_i128_to_u64(&cf) & M62) == 0); secp256k1_i128_rshift(&cf, 62);
  516|   430k|    VERIFY_CHECK((secp256k1_i128_to_u64(&cg) & M62) == 0); secp256k1_i128_rshift(&cg, 62);
  517|       |    /* Compute limb 1 of t*[f,g], and store it as output limb 0 (= down shift). */
  518|   430k|    secp256k1_i128_accum_mul(&cf, u, f1);
  519|   430k|    secp256k1_i128_accum_mul(&cf, v, g1);
  520|   430k|    secp256k1_i128_accum_mul(&cg, q, f1);
  521|   430k|    secp256k1_i128_accum_mul(&cg, r, g1);
  522|   430k|    f->v[0] = secp256k1_i128_to_u64(&cf) & M62; secp256k1_i128_rshift(&cf, 62);
  523|   430k|    g->v[0] = secp256k1_i128_to_u64(&cg) & M62; secp256k1_i128_rshift(&cg, 62);
  524|       |    /* Compute limb 2 of t*[f,g], and store it as output limb 1. */
  525|   430k|    secp256k1_i128_accum_mul(&cf, u, f2);
  526|   430k|    secp256k1_i128_accum_mul(&cf, v, g2);
  527|   430k|    secp256k1_i128_accum_mul(&cg, q, f2);
  528|   430k|    secp256k1_i128_accum_mul(&cg, r, g2);
  529|   430k|    f->v[1] = secp256k1_i128_to_u64(&cf) & M62; secp256k1_i128_rshift(&cf, 62);
  530|   430k|    g->v[1] = secp256k1_i128_to_u64(&cg) & M62; secp256k1_i128_rshift(&cg, 62);
  531|       |    /* Compute limb 3 of t*[f,g], and store it as output limb 2. */
  532|   430k|    secp256k1_i128_accum_mul(&cf, u, f3);
  533|   430k|    secp256k1_i128_accum_mul(&cf, v, g3);
  534|   430k|    secp256k1_i128_accum_mul(&cg, q, f3);
  535|   430k|    secp256k1_i128_accum_mul(&cg, r, g3);
  536|   430k|    f->v[2] = secp256k1_i128_to_u64(&cf) & M62; secp256k1_i128_rshift(&cf, 62);
  537|   430k|    g->v[2] = secp256k1_i128_to_u64(&cg) & M62; secp256k1_i128_rshift(&cg, 62);
  538|       |    /* Compute limb 4 of t*[f,g], and store it as output limb 3. */
  539|   430k|    secp256k1_i128_accum_mul(&cf, u, f4);
  540|   430k|    secp256k1_i128_accum_mul(&cf, v, g4);
  541|   430k|    secp256k1_i128_accum_mul(&cg, q, f4);
  542|   430k|    secp256k1_i128_accum_mul(&cg, r, g4);
  543|   430k|    f->v[3] = secp256k1_i128_to_u64(&cf) & M62; secp256k1_i128_rshift(&cf, 62);
  544|   430k|    g->v[3] = secp256k1_i128_to_u64(&cg) & M62; secp256k1_i128_rshift(&cg, 62);
  545|       |    /* What remains is limb 5 of t*[f,g]; store it as output limb 4. */
  546|   430k|    f->v[4] = secp256k1_i128_to_i64(&cf);
  547|   430k|    g->v[4] = secp256k1_i128_to_i64(&cg);
  548|   430k|}
