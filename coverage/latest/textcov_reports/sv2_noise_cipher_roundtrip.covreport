  746|       |        /* Update f,g using that transition matrix. */
  747|   571k|        VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(&f, len, &modinfo->modulus, 0) > 0); /* f > 0 */
  748|   571k|        VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(&f, len, &modinfo->modulus, 1) <= 0); /* f <= modulus */
  749|   571k|        VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(&g, len, &modinfo->modulus, 0) > 0); /* g > 0 */
  750|   571k|        VERIFY_CHECK(secp256k1_modinv64_mul_cmp_62(&g, len, &modinfo->modulus, 1) < 0);  /* g < modulus */
  751|       |
  752|   571k|        secp256k1_modinv64_update_fg_62_var(len, &f, &g, &t);
  753|       |        /* If the bottom limb of f is 1, there is a chance that f=1. */
  754|   571k|        if (f.v[0] == 1) {
  ------------------
  |  Branch (754:13): [True: 45.1k, False: 526k]
  ------------------
  755|  45.1k|            cond = 0;
  756|       |            /* Check if the other limbs are also 0. */
  757|  45.1k|            for (j = 1; j < len; ++j) {
  ------------------
  |  Branch (757:25): [True: 0, False: 45.1k]
  ------------------
  758|      0|                cond |= f.v[j];
  759|      0|            }
  760|       |            /* If so, we're done. When f=1, the Jacobi symbol (g | f)=1. */
  761|  45.1k|            if (cond == 0) return 1 - 2*(jac & 1);
  ------------------
  |  Branch (761:17): [True: 45.1k, False: 0]
  ------------------
  762|  45.1k|        }
  763|       |
  764|       |        /* Determine if len>1 and limb (len-1) of both f and g is 0. */
  765|   526k|        fn = f.v[len - 1];
  766|   526k|        gn = g.v[len - 1];
  767|   526k|        cond = ((int64_t)len - 2) >> 63;
  768|   526k|        cond |= fn;
  769|   526k|        cond |= gn;
