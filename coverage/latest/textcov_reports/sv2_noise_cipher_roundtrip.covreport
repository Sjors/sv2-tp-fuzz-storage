  |  Branch (904:63): [True: 17.8k, False: 0]
  |  Branch (904:78): [True: 0, False: 17.8k]
  ------------------
  905|  17.8k|    r->d[1] = shift < 448 ? (l[1 + shiftlimbs] >> shiftlow | (shift < 384 && shiftlow ? (l[2 + shiftlimbs] << shifthigh) : 0)) : 0;
  ------------------
  |  Branch (905:15): [True: 17.8k, False: 0]
  |  Branch (905:63): [True: 0, False: 17.8k]
  |  Branch (905:78): [True: 0, False: 0]
  ------------------
  906|  17.8k|    r->d[2] = shift < 384 ? (l[2 + shiftlimbs] >> shiftlow | (shift < 320 && shiftlow ? (l[3 + shiftlimbs] << shifthigh) : 0)) : 0;
  ------------------
  |  Branch (906:15): [True: 0, False: 17.8k]
  |  Branch (906:63): [True: 0, False: 0]
  |  Branch (906:78): [True: 0, False: 0]
  ------------------
  907|  17.8k|    r->d[3] = shift < 320 ? (l[3 + shiftlimbs] >> shiftlow) : 0;
  ------------------
