secp256k1.c:secp256k1_fe_impl_is_square_var:
  501|  12.6k|static int secp256k1_fe_impl_is_square_var(const secp256k1_fe *x) {
  502|  12.6k|    secp256k1_fe tmp;
  503|  12.6k|    secp256k1_modinv64_signed62 s;
  504|  12.6k|    int jac, ret;
  505|       |
  506|  12.6k|    tmp = *x;
  507|  12.6k|    secp256k1_fe_normalize_var(&tmp);
  ------------------
  |  |   80|  12.6k|#  define secp256k1_fe_normalize_var secp256k1_fe_impl_normalize_var
  ------------------
  508|       |    /* secp256k1_jacobi64_maybe_var cannot deal with input 0. */
  509|  12.6k|    if (secp256k1_fe_is_zero(&tmp)) return 1;
  ------------------
  |  |   84|  12.6k|#  define secp256k1_fe_is_zero secp256k1_fe_impl_is_zero
  ------------------
  |  Branch (509:9): [True: 0, False: 12.6k]
  ------------------
  510|  12.6k|    secp256k1_fe_to_signed62(&s, &tmp);
  511|  12.6k|    jac = secp256k1_jacobi64_maybe_var(&s, &secp256k1_const_modinfo_fe);
  512|  12.6k|    if (jac == 0) {
  ------------------
  |  Branch (512:9): [True: 0, False: 12.6k]
  ------------------
  513|       |        /* secp256k1_jacobi64_maybe_var failed to compute the Jacobi symbol. Fall back
  514|       |         * to computing a square root. This should be extremely rare with random
  515|       |         * input (except in VERIFY mode, where a lower iteration count is used). */
  516|      0|        secp256k1_fe dummy;
  517|      0|        ret = secp256k1_fe_sqrt(&dummy, &tmp);
  518|  12.6k|    } else {
  519|  12.6k|        ret = jac >= 0;
  520|  12.6k|    }
  521|  12.6k|    return ret;
  522|  12.6k|}
secp256k1.c:secp256k1_fe_impl_set_b32_mod:
  228|  12.1k|static void secp256k1_fe_impl_set_b32_mod(secp256k1_fe *r, const unsigned char *a) {
  229|  12.1k|    r->n[0] = (uint64_t)a[31]
  230|  12.1k|            | ((uint64_t)a[30] << 8)
  231|  12.1k|            | ((uint64_t)a[29] << 16)
  232|  12.1k|            | ((uint64_t)a[28] << 24)
  233|  12.1k|            | ((uint64_t)a[27] << 32)
  234|  12.1k|            | ((uint64_t)a[26] << 40)
  235|  12.1k|            | ((uint64_t)(a[25] & 0xF)  << 48);
  236|  12.1k|    r->n[1] = (uint64_t)((a[25] >> 4) & 0xF)
  237|  12.1k|            | ((uint64_t)a[24] << 4)
  238|  12.1k|            | ((uint64_t)a[23] << 12)
  239|  12.1k|            | ((uint64_t)a[22] << 20)
  240|  12.1k|            | ((uint64_t)a[21] << 28)
  241|  12.1k|            | ((uint64_t)a[20] << 36)
  242|  12.1k|            | ((uint64_t)a[19] << 44);
  243|  12.1k|    r->n[2] = (uint64_t)a[18]
  244|  12.1k|            | ((uint64_t)a[17] << 8)
  245|  12.1k|            | ((uint64_t)a[16] << 16)
  246|  12.1k|            | ((uint64_t)a[15] << 24)
  247|  12.1k|            | ((uint64_t)a[14] << 32)
  248|  12.1k|            | ((uint64_t)a[13] << 40)
  249|  12.1k|            | ((uint64_t)(a[12] & 0xF) << 48);
  250|  12.1k|    r->n[3] = (uint64_t)((a[12] >> 4) & 0xF)
  251|  12.1k|            | ((uint64_t)a[11] << 4)
  252|  12.1k|            | ((uint64_t)a[10] << 12)
  253|  12.1k|            | ((uint64_t)a[9]  << 20)
  254|  12.1k|            | ((uint64_t)a[8]  << 28)
  255|  12.1k|            | ((uint64_t)a[7]  << 36)
  256|  12.1k|            | ((uint64_t)a[6]  << 44);
  257|  12.1k|    r->n[4] = (uint64_t)a[5]
  258|  12.1k|            | ((uint64_t)a[4] << 8)
  259|  12.1k|            | ((uint64_t)a[3] << 16)
  260|  12.1k|            | ((uint64_t)a[2] << 24)
  261|  12.1k|            | ((uint64_t)a[1] << 32)
  262|  12.1k|            | ((uint64_t)a[0] << 40);
  263|  12.1k|}
secp256k1.c:secp256k1_fe_impl_normalize:
   43|  29.7k|static void secp256k1_fe_impl_normalize(secp256k1_fe *r) {
   44|  29.7k|    uint64_t t0 = r->n[0], t1 = r->n[1], t2 = r->n[2], t3 = r->n[3], t4 = r->n[4];
   45|       |
   46|       |    /* Reduce t4 at the start so there will be at most a single carry from the first pass */
   47|  29.7k|    uint64_t m;
   48|  29.7k|    uint64_t x = t4 >> 48; t4 &= 0x0FFFFFFFFFFFFULL;
   49|       |
   50|       |    /* The first pass ensures the magnitude is 1, ... */
   51|  29.7k|    t0 += x * 0x1000003D1ULL;
   52|  29.7k|    t1 += (t0 >> 52); t0 &= 0xFFFFFFFFFFFFFULL;
   53|  29.7k|    t2 += (t1 >> 52); t1 &= 0xFFFFFFFFFFFFFULL; m = t1;
   54|  29.7k|    t3 += (t2 >> 52); t2 &= 0xFFFFFFFFFFFFFULL; m &= t2;
   55|  29.7k|    t4 += (t3 >> 52); t3 &= 0xFFFFFFFFFFFFFULL; m &= t3;
   56|       |
   57|       |    /* ... except for a possible carry at bit 48 of t4 (i.e. bit 256 of the field element) */
   58|  29.7k|    VERIFY_CHECK(t4 >> 49 == 0);
   59|       |
   60|       |    /* At most a single final reduction is needed; check if the value is >= the field characteristic */
   61|  29.7k|    x = (t4 >> 48) | ((t4 == 0x0FFFFFFFFFFFFULL) & (m == 0xFFFFFFFFFFFFFULL)
   62|  29.7k|        & (t0 >= 0xFFFFEFFFFFC2FULL));
   63|       |
   64|       |    /* Apply the final reduction (for constant-time behaviour, we do it always) */
   65|  29.7k|    t0 += x * 0x1000003D1ULL;
