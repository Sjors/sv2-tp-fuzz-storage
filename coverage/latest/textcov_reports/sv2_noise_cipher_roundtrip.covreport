   53|  19.2M|    VERIFY_BITS_128(&d, 115);
   54|  19.2M|    VERIFY_BITS_128(&c, 48);
   55|       |    /* [(c<<12) 0 0 0 0 0 d 0 0 0] = [p8 0 0 0 0 p3 0 0 0] */
   56|  19.2M|    t3 = secp256k1_u128_to_u64(&d) & M; secp256k1_u128_rshift(&d, 52);
   57|  19.2M|    VERIFY_BITS(t3, 52);
   58|  19.2M|    VERIFY_BITS_128(&d, 63);
   59|       |    /* [(c<<12) 0 0 0 0 d t3 0 0 0] = [p8 0 0 0 0 p3 0 0 0] */
   60|       |
   61|  19.2M|    secp256k1_u128_accum_mul(&d, a0, b[4]);
   62|  19.2M|    secp256k1_u128_accum_mul(&d, a1, b[3]);
   63|  19.2M|    secp256k1_u128_accum_mul(&d, a2, b[2]);
   64|  19.2M|    secp256k1_u128_accum_mul(&d, a3, b[1]);
   65|  19.2M|    secp256k1_u128_accum_mul(&d, a4, b[0]);
   66|  19.2M|    VERIFY_BITS_128(&d, 115);
   67|       |    /* [(c<<12) 0 0 0 0 d t3 0 0 0] = [p8 0 0 0 p4 p3 0 0 0] */
   68|  19.2M|    secp256k1_u128_accum_mul(&d, R << 12, secp256k1_u128_to_u64(&c));
   69|  19.2M|    VERIFY_BITS_128(&d, 116);
   70|       |    /* [d t3 0 0 0] = [p8 0 0 0 p4 p3 0 0 0] */
   71|  19.2M|    t4 = secp256k1_u128_to_u64(&d) & M; secp256k1_u128_rshift(&d, 52);
   72|  19.2M|    VERIFY_BITS(t4, 52);
   73|  19.2M|    VERIFY_BITS_128(&d, 64);
